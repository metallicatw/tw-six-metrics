    if (nr != null) conds.push("營收創 " + nr + " 個月新高");
    if (no != null) conds.push("營業利益率創 " + no + " 季新高");
    if (ne != null) conds.push("EPS 創 " + ne + " 季新高");
    if (np != null) conds.push("股價創 " + np + " 個交易日新高");
    if (nv != null) conds.push("成交量創 " + nv + " 個交易日新高");
    // 「創 N 期新高」＝這一期比之前 N 期都高（所以要取 N＋1 期）。和參考畫面對過：
    // 預設的 3／3／3 得到 132 家，對方也是 132 家。
    var mk = nr != null ? monthsBack(D.base_m, nr + 1) : null;
    var qk = (no != null || ne != null) ? histKeys(null, D.base_q, Math.max(no || 0, ne || 0) + 1) : null;
    var list = [];
    D.rows.forEach(function(r){
      if (nr != null && !newHighOf(mk.map(function(k){ return r.r[k] ? r.r[k][0] : null; }))) return;
      if (no != null && !newHighOf(qk.slice(0, no + 1).map(function(k){ return r.h[k] ? r.h[k][0] : null; }))) return;
      if (ne != null && !newHighOf(qk.slice(0, ne + 1).map(function(k){ return r.h[k] ? r.h[k][1] : null; }))) return;
      if (np != null || nv != null){
        var s = series(r.c); if (!s) return;
        if (np != null && !isExtreme(s.c, np, true)) return;
        if (nv != null && !isExtreme(s.v, nv, true)) return;
      }
      list.push(view(r, D.base_q, D.base_m));
    });
    table(host, "篩選結果（季度 " + D.base_q + "　營收 " + D.base_m + "）",
      "使用條件：" + (conds.join("　且　") || "（不限）") + "　｜　基準季 " + D.base_q + "（" + D.qcount[D.base_q] + " 家）、基準月 " + D.base_m + "（" + D.mcount[D.base_m] + " 家）。" + LINKS, list);
  };
  if (np != null || nv != null){ host.textContent = "載入股價資料…"; needPrices(Math.max(np != null ? np + 1 : 0, nv != null ? nv + 1 : 0)).then(go).catch(function(e){ host.textContent = "讀不到股價資料：" + e.message; }); }
  else go();
}

var RUN = {fin: runFin, trend: runTrend, strong: runStrong, high: runHigh}, done = {};
function preset(tab, clear){ if (tab === "fin") presetFin(clear); else presetFields(tab, clear); }

// ── 分頁 ───────────────────────────────────────────────────────────────
var bar = $("sc-tabs"), tabs = [].slice.call(bar.querySelectorAll(".sc-tab"));
function open(name, push){
  tabs.forEach(function(t){ var on = t.getAttribute("data-t") === name; t.setAttribute("aria-selected", on ? "true" : "false"); $("sc-" + t.getAttribute("data-t")).hidden = !on; });
  if (push && history.replaceState) history.replaceState(null, "", "#" + name);
  var cur = bar.querySelector('[data-t="' + name + '"]');
  if (cur){ var bb = bar.getBoundingClientRect(), cb = cur.getBoundingClientRect();
    if (cb.left < bb.left) bar.scrollLeft -= bb.left - cb.left + 8; else if (cb.right > bb.right) bar.scrollLeft += cb.right - bb.right + 8; }
  if (D && !done[name]){ done[name] = 1; RUN[name](); }
}
tabs.forEach(function(t){ t.addEventListener("click", function(){ open(t.getAttribute("data-t"), true); }); });

grab("data.json").then(function(doc){
  D = unpackData(doc);
  $("sc-msg").textContent = "資料日 " + D.asof + "；基準季 " + D.base_q + "（" + D.qcount[D.base_q] + " 家）、基準月 " + D.base_m + "（" + D.mcount[D.base_m] + " 家）；共 " + D.rows.length + " 檔。篩選在你的瀏覽器裡進行。不構成任何投資建議。";
  buildFin();
  ["fin", "trend", "strong", "high"].forEach(function(t){ preset(t, false); });
  document.querySelectorAll("[data-run]").forEach(function(b){ b.onclick = function(){ RUN[b.getAttribute("data-run")](); }; });
  document.querySelectorAll("[data-preset]").forEach(function(b){ b.onclick = function(){ var t = b.getAttribute("data-preset"); preset(t, false); RUN[t](); }; });
  document.querySelectorAll("[data-clear]").forEach(function(b){ b.onclick = function(){ preset(b.getAttribute("data-clear"), true); }; });
  $("s-adv").onclick = function(){ presetFields("strong2", false); runStrong(); };
  document.querySelectorAll(".sc input").forEach(function(i){ i.addEventListener("keydown", function(e){
    if (e.key === "Enter"){ var p = i.closest(".sc-panel"); if (p) RUN[p.id.slice(3)](); } }); });
  var want = (location.hash || "").slice(1);
  open(RUN[want] ? want : "fin", false);
  // 先畫好眼前這一頁，再趁空檔把近期股價抓下來：切到趨勢／強勢分頁時就不用再等。
  setTimeout(function(){ needPrices(0).catch(function(){}); }, 1200);
}).catch(function(){
  $("sc-msg").textContent = "還沒有資料：選股功能的資料在建站時產生（screener/data.json），這一次建站沒有寫出來。下一次排程後會自動出現。";
  var want = (location.hash || "").slice(1); open(RUN[want] ? want : "fin", false);
});
})();
</script>
{% endblock %}
