  if (kind === "code") return el("td", {cls: "l"}, el("a", {href: "stock/" + encodeURIComponent(v.c) + ".html", title: "個股資訊頁", text: v.c}));
  if (kind === "name") return el("td", {cls: "l nm"}, el("a", {href: "stock/" + encodeURIComponent(v.c) + ".html", title: "個股資訊頁", text: v.n}));
  if (kind === "mk") return el("td", {cls: "l"}, v.m ? el("span", {cls: "sc-mk", text: v.m}) : "");
  if (kind === "text") return el("td", {cls: "l ind", text: x || ""});
  if (kind === "price") return el("td", null, el("span", {cls: cls(v.chg), text: short(x, 2).t}),
    isnum(x) ? el("a", {cls: "yf", href: YA(v), target: "_blank", rel: "noopener", title: "Yahoo股市技術分析", "aria-label": v.c + " Yahoo 技術分析"}) : null);
  if (kind === "pct") return numTd(x, 2, true);
  if (kind === "sig2") return numTd(x, 2);
  if (kind === "sig0") return numTd(x, 0);
  var s = short(x, kind), a = {text: s.t};
  if (s.full) a.title = s.full;
  return el("td", a);
}
function table(host, title, summary, list, opt){
  opt = opt || {};
  var cols = COLS.slice(0, 4).concat(opt.extra || [], COLS.slice(4));
  var state = {key: opt.sort || "opm", dir: -1};
  host.innerHTML = "";
  host.appendChild(el("div", {cls: "sc-head"}, el("h3", {text: title}), el("span", {cls: "sc-count", text: list.length + " 家"})));
  host.appendChild(el("p", {cls: "sc-note", text: summary}));
  if (opt.chart) host.appendChild(opt.chart(list));
  var wrap = el("div", {cls: "sc-scroll"});
  host.appendChild(wrap);
  function render(){
    var rows = list.slice().sort(function(a, b){
      var x = a[state.key], y = b[state.key];
      if (!isnum(x) && !isnum(y)) return String(x || "").localeCompare(String(y || "")) * state.dir;
      if (!isnum(x)) return 1; if (!isnum(y)) return -1;
      return (x - y) * state.dir;
    });
    var t = el("table", {cls: cols.length > 17 ? "sc-tbl many" : "sc-tbl"}), tr = el("tr");
    cols.forEach(function(c){
      var l = ["code", "name", "mk", "text"].indexOf(c[2]) >= 0;
      var th = el("th", {cls: l ? "l" : "", text: c[1] + (state.key === c[0] ? (state.dir < 0 ? "\u00a0▼" : "\u00a0▲") : "")});
      th.onclick = function(){ if (state.key === c[0]) state.dir = -state.dir; else { state.key = c[0]; state.dir = l ? 1 : -1; } render(); };
      tr.appendChild(th);
    });
    t.appendChild(el("thead", null, tr));
    var tb = el("tbody");
    rows.forEach(function(v){ var row = el("tr"); cols.forEach(function(c){ row.appendChild(cell(v, c)); }); tb.appendChild(row); });
    if (!rows.length) tb.appendChild(el("tr", null, el("td", {cls: "l", colspan: cols.length, text: "沒有符合條件的股票。"})));
    t.appendChild(tb);
    wrap.innerHTML = ""; wrap.appendChild(t);
  }
  render();
  var lg = el("div", {cls: "sc-legend"});
  lg.appendChild(el("div", {style: "grid-column:1/-1"}, el("b", {text: "簡稱與單位說明"})));
  (opt.legend || []).concat(LEGEND).forEach(function(x){ lg.appendChild(el("div", null, el("b", {text: x[0]}), " = " + x[1])); });
  host.appendChild(lg);
}
function barChart(list, key, label, top){
  var rows = list.filter(function(v){ return isnum(v[key]); }).sort(function(a, b){ return b[key] - a[key]; }).slice(0, top);
  var box = el("div", {cls: "sc-chart"});
  if (!rows.length) return box;
  var W = 760, L = 120, R = 50, H = 20, pad = 26, h = rows.length * H + pad + 10;
  var max = Math.max.apply(null, rows.map(function(v){ return v[key]; }).concat([1]));
  var min = Math.min(0, Math.min.apply(null, rows.map(function(v){ return v[key]; })));
  var sx = function(x){ return L + (x - min) / (max - min) * (W - L - R); };
  var ns = "http://www.w3.org/2000/svg";
  var svg = document.createElementNS(ns, "svg"); svg.setAttribute("viewBox", "0 0 " + W + " " + h); svg.setAttribute("role", "img"); svg.setAttribute("aria-label", label);
  function add(tag, a, text){ var n = document.createElementNS(ns, tag); for (var k in a) n.setAttribute(k, a[k]); if (text != null) n.textContent = text; svg.appendChild(n); return n; }
  add("text", {x: W / 2, y: 14, "text-anchor": "middle", "font-weight": "600"}, label + "（前 " + rows.length + " 檔）");
  rows.forEach(function(v, i){
    var y = pad + i * H, x0 = sx(Math.max(0, min)), x1 = sx(v[key]);
    add("text", {x: L - 6, y: y + 13, "text-anchor": "end"}, v.c + " " + v.n);
    add("rect", {x: Math.min(x0, x1), y: y + 3, width: Math.max(1, Math.abs(x1 - x0)), height: H - 7, rx: 2, fill: v[key] >= 0 ? "var(--up)" : "var(--down)", opacity: .75});
    add("text", {x: Math.max(x0, x1) + 4, y: y + 13}, fmt(v[key], 2) + "%");
  });
  box.appendChild(svg);
  return box;
}

