function presetFin(clear){
  $("f-q").value = D.base_q; $("f-m").value = D.base_m; $("f-mk").value = "";
  RANGES.forEach(function(r){ var p = !clear && PRESET.fin[r[0]] || [null, null]; setv("f-" + r[0] + "-lo", p[0]); setv("f-" + r[0] + "-hi", p[1]); });
  $("f-indpanel").querySelectorAll("input[type=checkbox]").forEach(function(c){ c.checked = true; }); INDS = null; indLabel();
