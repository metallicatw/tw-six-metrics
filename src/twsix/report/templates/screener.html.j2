    });
    table(host, "篩選結果（季度 " + D.base_q + "　營收 " + D.base_m + "）",
      "使用條件：" + (conds.join("　且　") || "（不限）") + "　｜　" + basePeriods() + "。股價資料到 " + P.dates[P.dates.length - 1] + "。" + LINKS, list);
  }).catch(function(e){ host.textContent = "讀不到股價資料：" + e.message; });
}

