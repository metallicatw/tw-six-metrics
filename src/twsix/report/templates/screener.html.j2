{% extends "base.html.j2" %}
{% block title %}選股功能｜{{ site_title }}{% endblock %}
{% block head_early %}
{# 先開始下載（2026-09-28，頁面載入太久）：data.json 一定要；直接開到趨勢選股或近期強勢股
   的，連 prices_recent.json 一起抓。網址帶 ?v=資料指紋（report/screener.py 的 version.txt），
   瀏覽器可以放心快取；沒有指紋就退回每次向伺服器確認。 #}
<script>
window.SC_V = "{{ data_v|default('') }}";
(function(){
  var v = window.SC_V;
  window.SC_URL = function(name){ return "screener/" + name + (v ? "?v=" + v : ""); };
  window.SC_OPT = v ? {} : {cache: "no-cache"};
  var E = window.SC_EARLY = {};
  try {
    E["data.json"] = fetch(window.SC_URL("data.json"), window.SC_OPT);
    if (/^#(trend|strong)/.test(location.hash)) E["prices_recent.json"] = fetch(window.SC_URL("prices_recent.json"), window.SC_OPT);
  } catch (e) {}
})();
</script>
{% endblock %}
{% block body %}
{# 〔選股功能〕：財務選股、趨勢選股、近期強勢股、創新高選股。
   這一頁不帶數字：瀏覽器讀 screener/data.json（財報、營收、最新股價）與
   screener/prices_recent.json（近 80 個交易日收盤與成交量）／prices.json（近 250 個交易日，
   使用者填的天數超過 80 才下載），都由建站時的 report/screener.py 寫出來。樣式與程式只在這一頁、以 .sc 為前綴。 #}
<style>
.sc-note{color:var(--muted);font-size:13px;line-height:1.6;max-width:none}
.sc-tabs{display:flex;flex-wrap:nowrap;overflow-x:auto;gap:4px;margin:12px 0 14px;border-bottom:1px solid var(--rule)}
.sc-tab{flex:0 0 auto;border:0;background:none;color:var(--ink-2);padding:8px 14px;font:inherit;font-size:15px;cursor:pointer;border-bottom:3px solid transparent;white-space:nowrap}
.sc-tab[aria-selected=true]{color:var(--accent-2);font-weight:700;border-bottom-color:var(--accent-2)}
.sc-panel[hidden]{display:none}
.sc-card{background:var(--surface);border:1px solid var(--rule);border-radius:12px;padding:14px 16px;margin:0 0 14px}
.sc-row{display:flex;flex-wrap:wrap;align-items:center;gap:6px 8px;margin:6px 0}
.sc-tag{display:inline-block;background:color-mix(in srgb,var(--accent-2) 14%,transparent);color:var(--accent-2);border-radius:999px;padding:3px 10px;font-size:13px;font-weight:600;white-space:nowrap}
.sc input[type=number],.sc select{font:inherit;font-size:14px;padding:5px 8px;border:1px solid var(--rule);border-radius:7px;background:var(--surface);color:var(--ink);width:6.5em}
.sc select{width:auto}
.sc-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(210px,1fr));gap:10px 18px;margin:6px 0 10px}
.sc-grid label{display:block;font-size:13px;color:var(--ink-2);margin-bottom:3px}
.sc-range{display:flex;align-items:center;gap:6px}
.sc-range input[type=number]{width:100%}
.sc-btns{display:flex;flex-wrap:wrap;align-items:center;gap:8px;margin-top:10px}
.sc-btn{font:inherit;font-size:14px;border:1px solid var(--rule);background:var(--surface-2);color:var(--ink);border-radius:8px;padding:7px 16px;cursor:pointer}
.sc-btn.pri{background:var(--accent-2);border-color:var(--accent-2);color:#fff;font-weight:600}
.sc-btn.on{outline:2px solid var(--accent-2);outline-offset:1px;font-weight:600}
.sc-inds{position:relative;display:inline-block}
.sc-indpanel{position:absolute;z-index:20;top:100%;left:0;margin-top:4px;background:var(--surface);border:1px solid var(--rule);border-radius:10px;padding:8px;width:min(420px,86vw);max-height:300px;overflow:auto;box-shadow:0 6px 18px rgba(0,0,0,.15)}
.sc-indpanel label{display:inline-flex;gap:4px;align-items:center;width:48%;font-size:13px;margin:2px 0;color:var(--ink)}
.sc-head{display:flex;align-items:center;justify-content:space-between;gap:10px;flex-wrap:wrap}
.sc-head h3{margin:0;font-size:17px}
.sc-count{background:var(--accent-2);color:#fff;border-radius:999px;padding:3px 12px;font-size:13px;font-weight:600}
/* 深色模式的 --accent-2 是亮青色：實心按鈕與家數徽章改用深色字（2026-09-29 對比度檢查） */
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) .sc-count,:root:not([data-theme=light]) .sc-btn.pri{color:var(--ground)}}
:root[data-theme=dark] .sc-count,:root[data-theme=dark] .sc-btn.pri{color:var(--ground)}
.sc-scroll{overflow:auto;max-height:70vh;border:1px solid var(--rule);border-radius:10px;margin-top:10px}
.sc-tbl{width:100%;border-collapse:collapse;font-size:13.5px;font-variant-numeric:tabular-nums;min-width:0}
.sc-tbl th,.sc-tbl td{padding:6px 8px;border-bottom:1px solid var(--rule);text-align:right;white-space:nowrap}
.sc-tbl th{position:sticky;top:0;z-index:2;background:var(--surface-2);cursor:pointer;user-select:none}
/* 電腦版：一次看到全部欄位，不必橫向捲（2026-09-28）。
   量過：內容欄 1,164px，而表格原本 1,280～1,440px（近期強勢股多三欄）。收的是留白，
   不是資訊——格子左右各 4px、表頭可以折成兩行（只在標籤裡預留的斷點折，
   keep-all 讓「自由現金」不會折成「自由現／金」）、產業名稱最多兩行。
   窄於 1,024px（平板、手機）維持原樣：一行一格、可以橫向捲。 */
@media (min-width:1024px){
  .sc-tbl{font-size:13px}
  .sc-tbl th,.sc-tbl td{padding:5px 4px}
  .sc-tbl th{white-space:normal;word-break:keep-all;line-height:1.25;vertical-align:bottom}
  .sc-tbl td.ind{white-space:normal;min-width:4em;max-width:6.2em;line-height:1.3}
  .sc-tbl.many td.ind{max-width:5.5em}
  .sc-tbl td.nm{white-space:normal;word-break:keep-all;max-width:6em;line-height:1.3}
  /* 近期強勢股多三欄（二十欄）：字小半號、格子再收 1px，才塞得進 1,164px。 */
  .sc-tbl.many{font-size:12.5px}
  .sc-tbl.many th,.sc-tbl.many td{padding:5px 3px}
  .sc-tbl th:first-child,.sc-tbl td:first-child{padding-left:8px}
  .sc-tbl th:last-child,.sc-tbl td:last-child{padding-right:8px}
}
.sc-tbl th.l,.sc-tbl td.l{text-align:left}
.sc-tbl a{color:var(--accent-2);text-decoration:none}
.sc-tbl a:hover{text-decoration:underline}
.sc-tbl a.yf{text-decoration:none}
.sc-mk{display:inline-block;font-size:12px;border-radius:6px;padding:1px 7px;background:color-mix(in srgb,var(--accent-2) 12%,transparent);color:var(--accent-2)}
.sc .up{color:var(--up)}.sc .dn{color:var(--down)}
.sc-legend{display:grid;grid-template-columns:repeat(auto-fill,minmax(230px,1fr));gap:4px 18px;font-size:13px;color:var(--muted);margin-top:12px;border:1px solid var(--rule);border-radius:10px;padding:10px 12px}
.sc-legend b{color:var(--ink-2)}
.sc-chart{margin-top:10px}
.sc-chart svg{width:100%;max-width:860px;height:auto;display:block}
.sc-chart text{font-size:11px;fill:var(--ink-2)}
@media (max-width:640px){.sc-card{padding:12px}.sc input[type=number]{width:5em}}
</style>

<div class="sc">
<h2>選股功能</h2>
<p class="sc-note" id="sc-msg">載入中…</p>

<div class="sc-tabs" role="tablist" id="sc-tabs">
  <button class="sc-tab" role="tab" data-t="fin">財務選股</button>
  <button class="sc-tab" role="tab" data-t="trend">趨勢選股</button>
  <button class="sc-tab" role="tab" data-t="strong">近期強勢股</button>
  <button class="sc-tab" role="tab" data-t="high">創新高選股</button>
</div>

{# ── 財務選股 ── #}
<section class="sc-panel" id="sc-fin" hidden>
<div class="sc-card">
  <div class="sc-grid">
    <div><label>財報季度</label><select id="f-q"></select></div>
    <div><label>營收月份</label><select id="f-m"></select></div>
    <div><label>市場別</label><select id="f-mk"><option value="">全部</option><option>上市</option><option>上櫃</option></select></div>
    <div><label>產業別（可複選）</label>
      <span class="sc-inds"><button type="button" class="sc-btn" id="f-indbtn">全部產業 ▾</button>
      <div class="sc-indpanel" id="f-indpanel" hidden></div></span></div>
  </div>
  <div class="sc-grid" id="f-ranges"></div>
  <div class="sc-btns">
    <button class="sc-btn pri" data-run="fin">重新掃描</button>
    <button class="sc-btn" data-preset="fin">預設條件</button>
    <button class="sc-btn" data-clear="fin">清除條件</button>
    <span class="sc-note">欄位留空表示不限制；範圍可只填一邊。</span>
  </div>
</div>
<div class="sc-card" id="r-fin"></div>
</section>

{# ── 趨勢選股 ── #}
<section class="sc-panel" id="sc-trend" hidden>
<div class="sc-card">
  <div class="sc-row"><span class="sc-tag">條件一</span>股價在 <input type="number" id="t-n1" min="1" max="249"> 日內
    <select id="t-dir"><option value="up">上漲</option><option value="down">下跌</option></select> 幅度超過 <input type="number" id="t-x1" step="any"> %</div>
  <div class="sc-row"><span class="sc-tag">條件二</span>股價 創 <input type="number" id="t-n2" min="2" max="250"> 個交易日
    <select id="t-hl"><option value="high">新高</option><option value="low">新低</option></select></div>
  <div class="sc-row"><span class="sc-tag">條件三</span>均線 <select id="t-ma"><option value="">不限制</option><option value="bull">多頭排列</option><option value="bear">空頭排列</option></select>
    <span class="sc-note">多頭 = 10 日 ≥ 月線(20) ≥ 季線(60)；空頭反之</span></div>
  <div class="sc-btns">
    <button class="sc-btn pri" data-run="trend">重新掃描</button>
    <button class="sc-btn" data-preset="trend">預設條件</button>
    <button class="sc-btn" data-clear="trend">清除條件</button>
    <span class="sc-note">結果一律採用基準季與基準月的財報與營收；多個條件都填時須同時符合，留空表示不套用。</span>
  </div>
</div>
<div class="sc-card" id="r-trend"></div>
</section>

{# ── 近期強勢股 ── #}
<section class="sc-panel" id="sc-strong" hidden>
<div class="sc-card">
  <div class="sc-row"><span class="sc-tag">門檻</span>股價 ≥ <input type="number" id="s-p" step="any"> 元，最近一季營業利益率 ≥ <input type="number" id="s-opm" step="any"> %，成交量 ≥ <input type="number" id="s-v" step="any"> 張</div>
  <div class="sc-row"><span class="sc-tag">條件一</span>過去 <input type="number" id="s-n1" min="1" max="249"> 個交易日，漲幅超過 <input type="number" id="s-x1" step="any"> %</div>
  <div class="sc-row"><span class="sc-tag">條件二</span>過去 <input type="number" id="s-n2" min="1" max="60"> 個交易日，成交量漲幅超過前 <input type="number" id="s-b2" min="1" max="120"> 個交易日均量 <input type="number" id="s-x2" step="any"> %</div>
  <div class="sc-row"><span class="sc-tag">條件三</span>過去 <input type="number" id="s-n3" min="1" max="249"> 個交易日，漲幅超過 <input type="number" id="s-x3" step="any"> %</div>
  <div class="sc-btns">
    <button class="sc-btn pri" data-run="strong">重新掃描</button>
    <button class="sc-btn" data-preset="strong">預設條件</button>
    <button class="sc-btn" id="s-adv" title="門檻＋條件一、二、三全部套用">進階預設</button>
    <button class="sc-btn" data-clear="strong">清除條件</button>
    <span class="sc-note">門檻與所有填了的條件都要同時符合，留空表示不套用。「預設條件」＝門檻＋條件一；「進階預設」＝門檻＋條件一、二、三。</span>
  </div>
</div>
<div class="sc-card" id="r-strong"></div>
</section>

{# ── 創新高選股 ── #}
<section class="sc-panel" id="sc-high" hidden>
<div class="sc-card">
  <div class="sc-row"><span class="sc-tag">條件一</span>營收創 <input type="number" id="h-r" min="1" max="17"> 個月新高</div>
  <div class="sc-row"><span class="sc-tag">條件二</span>營業利益率創 <input type="number" id="h-o" min="1" max="11"> 季新高</div>
  <div class="sc-row"><span class="sc-tag">條件三</span>EPS 創 <input type="number" id="h-e" min="1" max="11"> 季新高</div>
  <div class="sc-row"><span class="sc-tag">條件四</span>股價創 <input type="number" id="h-p" min="2" max="250"> 個交易日新高</div>
  <div class="sc-row"><span class="sc-tag">條件五</span>成交量創 <input type="number" id="h-v" min="2" max="250"> 個交易日新高</div>
  <div class="sc-btns">
    <button class="sc-btn pri" data-run="high">重新掃描</button>
    <button class="sc-btn" data-preset="high">預設條件</button>
    <button class="sc-btn" data-clear="high">清除條件</button>
    <span class="sc-note">多個條件都填時須同時符合，留空表示不套用。基準月／基準季自動取「已公布家數足夠」的最新期別。「創 N 期新高」＝這一期比之前 N 期都高；股價、成交量是不低於之前 N 個交易日的最高。</span>
  </div>
</div>
<div class="sc-card" id="r-high"></div>
</section>
</div>

<script>
(function(){
"use strict";
var D = null, P = null, RECENT = null, FULL = null;
// 和 report/screener.py 的 RECENT_DAYS 一樣：prices_recent.json 有幾個交易日
var RECENT_N = 80;
var $ = function(id){ return document.getElementById(id); };
function el(tag, attrs){
  var n = document.createElement(tag);
  if (attrs) for (var k in attrs){
    if (k === "text") n.textContent = attrs[k];
    else if (k === "cls") n.className = attrs[k];
    else n.setAttribute(k, attrs[k]);
  }
  for (var i = 2; i < arguments.length; i++){
    var c = arguments[i]; if (c == null) continue;
    n.appendChild(typeof c === "string" ? document.createTextNode(c) : c);
  }
  return n;
}
function isnum(v){ return typeof v === "number" && isFinite(v); }
// 每一種小數位數建一個格式器重複用：toLocaleString(語系, 選項) 每呼叫一次就重建一個，
// 兩百列 × 十幾欄在手機上要多花零點幾秒（2026-09-28 量的）。
var NF = {};
function fmt(v, d){
  if (!isnum(v)) return "—";
  var f = NF[d] || (NF[d] = new Intl.NumberFormat("en-US", {minimumFractionDigits: d, maximumFractionDigits: d}));
  return f.format(v);
}
function val(id){ var e = $(id); if (!e || e.value === "") return null; var v = parseFloat(e.value); return isFinite(v) ? v : null; }
function setv(id, v){ var e = $(id); if (e) e.value = v == null ? "" : v; }
function cls(v){ return !isnum(v) ? "" : v > 0 ? "up" : v < 0 ? "dn" : ""; }

// ── 一檔在某一季／某一月的數字 ──────────────────────────────────────────
function view(r, q, m){
  var qq = r.q[q] || null, hh = r.h[q] || null, rr = r.r[m] || null;
  var opm = qq && isnum(qq[0]) ? qq[0] : hh ? hh[0] : null;
  var eps = qq && isnum(qq[1]) ? qq[1] : hh ? hh[1] : null;
  var yoy = rr ? rr[1] : null;
  return {r: r, c: r.c, n: r.n, m: r.m, i: r.i, p: r.p, chg: r.chg, pe: r.pe, mc: r.mc, v: r.v,
    opm: opm, eps: eps, npm: qq ? qq[2] : null, inv: qq ? qq[3] : null, fcf: qq ? qq[4] : null,
    rev: rr ? rr[0] : null, yoy: yoy, cum: rr ? rr[2] : null,
    arrow: isnum(yoy) && isnum(opm) ? Math.round((yoy + opm) * 100) / 100 : null};
}
function inRange(v, lo, hi){
  if (lo == null && hi == null) return true;
  if (!isnum(v)) return false;
  return (lo == null || v >= lo) && (hi == null || v <= hi);
}

// ── 股價序列（prices.json） ───────────────────────────────────────────
// ── 還原壓縮格式（report/screener.py 的 pack_data／pack_prices）───────────────
// 還原出來的物件和以前的 data.json／prices.json 一模一樣，後面的程式不用分兩種。
function unpackData(doc){
  if (doc.fmt !== 2) return doc;
  var cols = doc.cols, n = cols.c.length, rows = new Array(n), keys = Object.keys(cols);
  for (var i = 0; i < n; i++){
    var r = {q: {}, h: {}, r: {}};
    for (var k = 0; k < keys.length; k++) r[keys[k]] = cols[keys[k]][i];
    rows[i] = r;
  }
  [["Q", "q"], ["H", "h"], ["R", "r"]].forEach(function(x){
    var per = doc[x[0]] || {};
    Object.keys(per).forEach(function(p){
      var arrs = per[p], w = arrs.length;
      for (var i = 0; i < n; i++){
        var v = new Array(w), any = false;
        for (var j = 0; j < w; j++){ v[j] = arrs[j][i]; if (v[j] != null) any = true; }
        if (any) rows[i][x[1]][p] = v;
      }
    });
    delete doc[x[0]];
  });
  delete doc.cols;
  doc.rows = rows;
  return doc;
}
function undelta(a, scale){
  var out = new Array(a.length), cur = null;
  for (var i = 0; i < a.length; i++){
    if (a[i] == null){ out[i] = null; continue; }
    cur = cur == null ? a[i] : cur + a[i];
    out[i] = scale === 1 ? cur : cur / scale;
  }
  return out;
}
function unpackPrices(doc){
  if (doc.fmt !== 2) return doc;
  var px = {};
  doc.codes.forEach(function(c, i){ px[c] = [undelta(doc.c[i], 100), undelta(doc.v[i], 1)]; });
  return {dates: doc.dates, px: px};
}
function grab(name){
  var early = (window.SC_EARLY || {})[name];
  if (early) delete window.SC_EARLY[name];
  return (early || fetch(window.SC_URL(name), window.SC_OPT)).then(function(r){
    if (!r.ok) throw new Error(name + " " + r.status); return r.json();
  });
}
// days＝這一次篩選最多要往回看幾個交易日（含最新一天）。80 天以內讀 prices_recent.json
// （約完整檔的三分之一），超過才讀完整的 prices.json。兩份的最後一天相同，下面的函式
// 都從最後一天往回數，所以換哪一份都一樣。
function grabFull(){
  if (!FULL) FULL = grab("prices.json").then(function(doc){ doc = unpackPrices(doc); doc.full = 1; return doc; });
  return FULL;
}
function setP(doc){ if (!P || doc.full || doc.dates.length > P.dates.length) P = doc; return P; }
function needPrices(days){
  days = days || 0;
  if (P && (P.full || P.dates.length >= days)) return Promise.resolve(P);
  if (days <= RECENT_N){
    if (!RECENT) RECENT = grab("prices_recent.json").then(unpackPrices).catch(function(){ return grabFull(); });
    return RECENT.then(setP);
  }
  return grabFull().then(setP);
}
function series(code){ var s = P && P.px[code]; return s ? {c: s[0], v: s[1]} : null; }
function lastIdx(a){ for (var i = a.length - 1; i >= 0; i--) if (isnum(a[i])) return i; return -1; }
function ret(code, n){
  var s = series(code); if (!s) return null;
  var t = lastIdx(s.c); if (t < 0 || t - n < 0 || !isnum(s.c[t - n]) || !s.c[t - n]) return null;
  return (s.c[t] / s.c[t - n] - 1) * 100;
}
function window_(a, t, n){ if (t - n + 1 < 0) return null; var w = a.slice(t - n + 1, t + 1); for (var i = 0; i < w.length; i++) if (!isnum(w[i])) return null; return w; }
// 「創 N 個交易日新高」＝最新這一天不低於之前 N 個交易日的最高（新低反之）。
// 和使用者給的參考畫面對過：這個定義（含持平）得到 79／50 家，參考畫面是 80／51 家
// （不含持平是 75／47）；差的一檔多半是兩邊資料日不同。
function isExtreme(a, n, high){
  var t = lastIdx(a); if (t < 0) return false;
  var w = window_(a, t, n + 1); if (!w) return false;
  var x = a[t], prev = w.slice(0, -1);
  return high ? prev.every(function(v){ return x >= v; }) : prev.every(function(v){ return x <= v; });
}
function ma(a, t, n){ var w = window_(a, t, n); if (!w) return null; var s = 0; w.forEach(function(v){ s += v; }); return s / n; }
function volRatio(code, n, b){
  var s = series(code); if (!s) return null;
  var t = lastIdx(s.c); if (t < 0) return null;
  var recent = window_(s.v, t, n), before = window_(s.v, t - n, b);
  if (!recent || !before) return null;
  var a = 0, z = 0; recent.forEach(function(v){ a += v; }); before.forEach(function(v){ z += v; });
  a /= n; z /= b; return z > 0 ? (a / z - 1) * 100 : null;
}
function newHighOf(values){ // values: 新的在前（這一期、上一期…）
  if (values.length < 2 || values.some(function(v){ return !isnum(v); })) return false;
  return values.slice(1).every(function(v){ return values[0] > v; });
}
function histKeys(r, from, n){
  var y = +from.slice(0, 4), q = +from.slice(5), out = [];
  for (var i = 0; i < n; i++){ out.push(y + "Q" + q); if (--q < 1){ q = 4; y--; } }
  return out;
}
function monthsBack(from, n){
  var y = +from.slice(0, 4), m = +from.slice(5), out = [];
  for (var i = 0; i < n; i++){ out.push(y + "/" + (m < 10 ? "0" : "") + m); if (--m < 1){ m = 12; y--; } }
  return out;
}

