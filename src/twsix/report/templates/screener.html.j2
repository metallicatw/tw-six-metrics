  if (INDS) conds.unshift("產業 " + INDS.size + " 類");
  table($("r-fin"), "篩選結果（季度 " + q + "　營收 " + m + "）",
    "使用條件：" + (conds.join("　且　") || "（不限）") + "　｜　財報季度：" + q + "、營收月份：" + m + "。" + LINKS, list);
}
var LINKS = "點代號或名稱開個股資訊頁、點股價旁的圖示開 Yahoo 技術分析。";

function presetFields(tab, clear){ Object.keys(PRESET[tab]).forEach(function(id){ var v = PRESET[tab][id]; setv(id, clear && typeof v === "number" ? null : v); }); }
function basePeriods(){ return "財報季度：" + D.base_q + "、營收月份：" + D.base_m; }

function runTrend(){
  var host = $("r-trend"); host.textContent = "載入股價資料…";
  var need = Math.max(val("t-n1") != null ? val("t-n1") + 1 : 0, val("t-n2") != null ? val("t-n2") + 1 : 0, $("t-ma").value ? 60 : 0);
  needPrices(need).then(function(){
    var n1 = val("t-n1"), x1 = val("t-x1"), dir = $("t-dir").value, n2 = val("t-n2"), hl = $("t-hl").value, mav = $("t-ma").value;
    var conds = [];
    if (n1 != null && x1 != null) conds.push("股價在 " + n1 + " 日內" + (dir === "up" ? "上漲" : "下跌") + "幅度超過 " + x1 + "%");
    if (n2 != null) conds.push("股價創 " + n2 + " 個交易日" + (hl === "high" ? "新高" : "新低"));
    if (mav) conds.push("均線" + (mav === "bull" ? "多頭排列" : "空頭排列"));
    var list = [];
    D.rows.forEach(function(r){
      var s = series(r.c); if (!s) return;
      if (n1 != null && x1 != null){ var x = ret(r.c, n1); if (!isnum(x) || (dir === "up" ? x <= x1 : x >= -x1)) return; }
      if (n2 != null && !isExtreme(s.c, n2, hl === "high")) return;
      if (mav){
        var t = lastIdx(s.c), a = ma(s.c, t, 10), b = ma(s.c, t, 20), c = ma(s.c, t, 60);
        if (!isnum(a) || !isnum(b) || !isnum(c)) return;
