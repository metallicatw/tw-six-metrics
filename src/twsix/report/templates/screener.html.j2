function runFin(){
  var q = $("f-q").value, m = $("f-m").value, mk = $("f-mk").value;
  var conds = [], list = [];
  RANGES.forEach(function(r){
    var lo = val("f-" + r[0] + "-lo"), hi = val("f-" + r[0] + "-hi");
    if (lo != null || hi != null) conds.push(r[1].replace(/\s*\(.*$/, "") + " " + (lo != null ? lo : "") + "～" + (hi != null ? hi : ""));
  });
  D.rows.forEach(function(r){
    if (mk && r.m !== mk) return;
    if (INDS && !INDS.has(r.i)) return;
    var v = view(r, q, m);
    for (var i = 0; i < RANGES.length; i++){ var k = RANGES[i][0]; if (!inRange(v[k], val("f-" + k + "-lo"), val("f-" + k + "-hi"))) return; }
    list.push(v);
  });
