// 表格裡的數字：極端值縮短，讓欄寬由「一般的數字」決定（2026-09-28，電腦版一次看到
// 全部欄位）。1,000 以上不留小數；百分比 100 以上留一位小數、一萬以上寫成「萬%」（營收
// 從 0 起跳的年增率會到幾百萬 %）。縮短過的格子，滑鼠停上去看完整數字。
function short(x, d, pct){
  if (!isnum(x)) return {t: "—"};
  var a = Math.abs(x), full = fmt(x, d) + (pct ? "%" : "");
  if (pct && a >= 1e4) return {t: fmt(x / 1e4, a >= 1e6 ? 0 : 1) + "萬%", full: full};
  if (a >= 1000 && d > 0) return {t: fmt(x, 0) + (pct ? "%" : ""), full: full};
  if (pct && a >= 100 && d > 1) return {t: fmt(x, 1) + "%", full: full};
  return {t: full};
}
function numTd(x, d, pct, extra){
  var s = short(x, d, pct), a = {cls: (extra || "") + " " + cls(x), text: s.t};
  if (s.full) a.title = s.full;
  return el("td", a);
}
function cell(v, col){
