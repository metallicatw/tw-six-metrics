  D.months.forEach(function(m){ $("f-m").appendChild(el("option", {value: m, text: m + "（" + D.mcount[m] + " 家）"})); });
  var box = $("f-ranges");
  RANGES.forEach(function(r){
    box.appendChild(el("div", null, el("label", {text: r[1]}), el("div", {cls: "sc-range"},
      el("input", {type: "number", step: "any", id: "f-" + r[0] + "-lo", placeholder: "最小"}), "～",
