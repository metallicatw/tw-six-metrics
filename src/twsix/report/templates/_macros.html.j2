{% macro grade(letter) -%}
{%- if letter in ('AA','A','BB','B','C') -%}
<span class="g g-{{ letter }}">{{ letter }}</span>
{%- else -%}
<span class="g g-na">{{ letter or '—' }}</span>
{%- endif -%}
{%- endmacro %}

{% macro delta(v) -%}
{%- if v is none or v == '' -%}<span class="muted">—</span>
{%- elif v > 0 -%}<span class="up">+{{ '%.2f'|format(v) }}</span>
{%- elif v < 0 -%}<span class="down">{{ '%.2f'|format(v) }}</span>
{%- else -%}0.00{%- endif -%}
{%- endmacro %}

{# 綜合評分 is a mean of six integers, so a third of the values are repeating
   decimals.  Printed raw they came out as 「3.8333333333」 and 「3.1666666667」
   in a column two digits wide — precision the score does not have, in a place
   nobody can use it.  Two decimals to read, the full value in the tooltip for
   anyone comparing two stocks that tie at 3.17.  Non-numeric scores
   （「數據不足」）pass through as they are. #}
{% macro score(v) -%}
{%- if v is none or v == '' -%}<span class="muted">—</span>
{%- else -%}
{%- set f = v|float(default=none) -%}
{%- if f is none -%}<span class="muted">{{ v }}</span>
{%- else -%}<span title="{{ v }}">{{ '%.2f'|format(f) }}</span>{%- endif -%}
{%- endif -%}
{%- endmacro %}

{# `rich_ids` is the set of stocks whose sheets were fetched, so their page is
   the ten-section one rather than the grade table.  Marked because otherwise
   the only way to find them is to click through 1,741 codes — and the mark is
   a word, not a colour, so it survives a greyscale print.

   這個記號原本是「完整」。改成更新日期，是因為「完整」只回答了「有沒有」，而
   讀者真正要判斷的是「這份資料還算不算數」——三個月前抓的完整報告和昨天抓的
   完整報告，看到的是同一個字，能做的判斷卻不一樣。日期同時回答了兩件事：有這個
   標記就代表有完整頁，標記的內容就是它多舊。

   月/日夠用（清單掃過去要窄），完整日期放在 title 裡給要確認年份的人。抓過但
   還沒有日期記號的退回「完整」——沒有日期就不要編一個出來。 #}
{# `data-s` 是排序鍵：排序看它，不看畫面上的字。
   「+0.50」「—」「AA」照字串排會排出胡說，而把「怎麼比大小」放進 JS 去猜每一欄
   的型別，等於在兩個地方各寫一次規則。這裡一次寫好：數字就是數字，等第換成
   0~4，沒有值一律是最小的 -999——排序時沉到底，而不是插在中間。 #}
{% macro row(r, rel, rich_ids=None, fetched_at=None) -%}
{% set when = (fetched_at or {}).get(r.stock_id) %}
{% set has_full = when or (rich_ids and r.stock_id in rich_ids) %}
<tr data-code="{{ r.stock_id }}">
  {# 流水號。內容留空，數字由 CSS 的計數器產生——這樣它數的是**畫面上的位置**：
     排序之後從 1 重新數，篩選之後跳過被隱藏的列。若改成建站時寫死的數字，排一次
     序就會變成一欄亂跳的號碼，比沒有還糟。 #}
  <td class="seq"></td>
  <td class="star-cell">
    {# 加入觀察清單。只存在這台瀏覽器裡（localStorage），不上傳也不進 repo——
       這是一份靜態網站，沒有可以放你私人清單的地方，也不該有。 #}
    <button type="button" class="star" data-star="{{ r.stock_id }}"
            aria-pressed="false" aria-label="把 {{ r.stock_id }} 加入觀察清單"
            title="加入觀察清單">☆</button>
    {# 自訂順序的兩顆鈕。**只在〔觀察清單〕那一頁出現**（site.js 看
       `table[data-watchlist]` 才裝上去），在〔評等清單〕上它們沒有意義——
       那一頁的順序是綜合評分。

       為什麼是上移／下移而不是拖曳：這張表在手機上是**橫向捲動**的，而拖曳
       一列要先按住不放——那個手勢和頁面捲動搶同一根手指，按住的瞬間畫面到底
       是要捲還是要拖，瀏覽器得猜，而它經常猜錯。兩顆鈕沒有這個問題，鍵盤也
       按得到，螢幕閱讀器也念得出來。代價是把一檔從第 20 移到第 1 要按 19 次
       ——而一份觀察清單通常只有十幾檔，那個代價不常發生。 #}
    <span class="mv" hidden>
      {# 〔置頂〕。一份觀察清單十幾檔，而「把這一檔提到最上面」是最常做的動作
         （今天要盯它）——用上移做那件事要按到第十幾次。
         字用「頂」而不是箭頭符號：⤒ 之類的字元在部分系統字型裡是空格或方框，
         而這一頁本來就是中文的，一個中文字沒有這個風險。 #}
      <button type="button" class="mv-top" data-move="{{ r.stock_id }}" data-delta="top"
              aria-label="把 {{ r.stock_id }} 移到最上面" title="移到最上面">頂</button>
      <button type="button" class="mv-up" data-move="{{ r.stock_id }}" data-delta="-1"
              aria-label="把 {{ r.stock_id }} 往上移" title="往上移">▲</button>
      <button type="button" class="mv-dn" data-move="{{ r.stock_id }}" data-delta="1"
              aria-label="把 {{ r.stock_id }} 往下移" title="往下移">▼</button>
    </span></td>
  <td data-s="{{ r.stock_id }}"><a href="{{ rel }}stock/{{ r.stock_id }}.html">{{ r.stock_id }}</a></td>
  {# 這一欄原本是〔最後更新日〕——「那一檔的報表最後一次抓回來是哪一天」。
     那回答的是**抓取**的新舊，而讀者在清單上想知道的是**資料**的新舊：這一列的
     六個等第是哪一季算出來的、營收年增率數到哪一個月。抓取日期和資料期別不是
     同一件事——同一天抓回來的兩檔，可能一檔已經是 2026Q2、另一檔還停在 2026Q1。

     排序鍵用「季別 + 月份」串起來（`2026.2|115/08`），所以照字串排就是照期別排。
     滑鼠停留時仍然看得到抓取日期，那件事沒有消失，只是不再佔一欄。 #}
  <td class="when-cell" data-s="{{ r.fiscal_quarter }}|{{ r.revenue_month }}"
      {%- if when %} title="報表更新於 {{ when }}　完整報告：河流圖、季節性、外資投信、個股新聞（大戶／董監持股另由每週排程更新）"
      {%- elif has_full %} title="已抓取完整資料，含河流圖、季節性、外資投信與個股新聞"{% endif %}>
    {{ basis(r) }}</td>
  {# 名稱也連過去。原本只有代號可點——而讀者掃清單時眼睛落在名稱上，
     卻要把游標移回四位數字才點得到，那是每一列都要付一次的小摩擦。 #}
  <td data-s="{{ r.name }}"><a href="{{ rel }}stock/{{ r.stock_id }}.html">{{ r.name }}</a></td>
  {# 上市／上櫃。「這一檔在哪個市場」是掃清單時會分開看的一件事——上櫃的流動性、
     法人參與度、本益比水準都和上市不一樣。資料本來就在評等表的 `market` 欄裡，
     只是一直沒有被畫出來。 #}
  <td class="muted" data-s="{{ r.market }}">{{ r.market }}</td>
  <td class="muted" data-s="{{ r.industry }}">{{ r.industry }}</td>
  {% for key in ('revenue_yoy','operating_margin','net_income_yoy','eps','inventory_turnover','free_cash_flow') %}
  <td data-s="{{ {'AA':4,'A':3,'BB':2,'B':1,'C':0}.get(r.grades[key], -999) }}">{{ grade(r.grades[key]) }}</td>
  {% endfor %}
  <td class="num" data-s="{{ r.composite|float(default=-999) }}">{{ score(r.composite) }}</td>
  <td class="num" data-s="{{ r.composite_delta if r.composite_delta is not none else -999 }}">{{ delta(r.composite_delta) }}</td>
  <td class="pick-cell" data-s="{{ 1 if r.value_pick else 0 }}">{% if r.value_pick %}<span class="pick">具投資價值</span>{% endif %}</td>
  <td class="num" data-s="{{ reward_key(r) }}">{{ reward(r) }}</td>
</tr>
{%- endmacro %}

{# ── 報酬風險比 ────────────────────────────────────────────────────────
   〔EPS預估與估價〕的 R 欄：|預期報酬 ÷ 預期風險|。

   四種值，而其中兩種在資料裡長得一模一樣（`reward_risk` 都是 None），意思卻
   正好相反：

     數字        照四段門檻上色。
     無風險      股價已經低於下檔價——**沒有下檔風險**，是四段裡最好的那一種。
                全市場有 492 檔在這一類。排序鍵給一個大數，讓它排在最前面。
     空頭        預期報酬是負的（目標價低於現在的股價），估價那一層把它夾成 0。
                印「0.00」會讀成「算出來剛好是零」，而真正的意思是往下。
     —          算不出來（多半是還沒回補到〔年度交易資訊〕，沒有本益比區間；
                也可能是預估 EPS 為負，本益比估價不適用）。排序鍵 -999，沉到底。

   把「無風險」和「—」混在一起是這個功能最容易犯的錯：拿 `> 2` 去篩會同時丟掉
   最好的那一批和沒資料的那一批，而丟掉的方式是「它們不在名單上」，沒有徵兆。

   （以前「無風險」印的是 ∞。那個符號要先知道它代表什麼才看得懂，而清單上最常
   被問的就是「∞ 是好還是壞」。） #}
{% macro reward_key(r) -%}
{%- if r.risk_free -%}999999
{%- elif r.reward_risk is none -%}-999
{%- else -%}{{ '%.6f'|format(r.reward_risk) }}{%- endif -%}
{%- endmacro %}

{# 類別名是 `rrv-*` 而不是 `rr-*`。

   `.rr` 這個名字在 site.css 裡**已經有別人在用**——個股頁〔建議〕那顆徽章
   （`.rr-可買進`／`.rr-減碼`…），而它那一條寫在比較後面：

       .rr{… color:var(--badge-ink) …}      ← 徽章用的，預期自己有底色

   權重一樣、位置在後，所以它把這裡的 `.rr-best{color:var(--g4)}` 整個蓋掉；
   而 `--badge-ink` 是給有底色的徽章用的墨色，落在沒有底色的表格上就是
   「數值和背景同一個顏色，看不到」——這正是使用者回報的症狀。

   改名，而不是加權重去贏它：兩個不相干的東西共用一個類別名，遲早再撞一次。 #}
{% macro reward(r) -%}
{%- if r.risk_free -%}
{# 以前印「∞」。那個符號要先知道「它代表沒有下檔風險」才看得懂，而清單上
   最多的問題就是「∞ 是好還是壞」。直接寫「無風險」。 #}
<span class="rrv rrv-best" title="股價已經低於下檔價，沒有下檔風險——四種裡最好的一種">無風險</span>
{%- elif r.reward_risk is none -%}<span class="muted">—</span>
{%- elif r.reward_risk <= 0 -%}
{# 預期報酬是負的（目標價低於現在的股價），估價那一層把它夾成 0。
   而 0 在這一欄是個說不通的數字——它看起來像「算出來剛好是零」，
   真正的意思是「往下」。 #}
<span class="rrv rrv-bad" title="預期報酬為負：目標價低於現在的股價">空頭</span>
{%- else -%}
{%- set v = r.reward_risk -%}
{%- set cls = 'rrv-best' if v >= 3 else ('rrv-ok' if v >= 2 else ('rrv-weak' if v >= 1 else 'rrv-bad')) -%}
<span class="rrv {{ cls }}" title="損益兩平所需的最低勝率約 {{ '%.0f'|format(100 / (1 + v)) }}%">{{ '%.2f'|format(v) }}</span>
{%- endif -%}
{%- endmacro %}

{# 每一欄都可以點著排序。只給那三欄會讓人試著點別欄然後以為壞了——「有些能點、
   有些不能，而且看不出是哪些」比「全部都能點」難用得多。 #}
{# ── 財報基準：「財報:2026Q2 ／ 營收:2026/08」 ──────────────────────────

   兩個來源的寫法不一樣，而且不一致的方式很容易被誤讀：
   `fiscal_quarter` 是西元帶點（`2026.2Q`），`revenue_month` 是**民國**（`115/08`）。
   同一格裡並排的話，`2026` 和 `115` 看起來像兩個年份系統各說各話——實際上它們
   相差九天。所以月份在這裡換算成西元，兩個數字才對得起來。

   換算只在**顯示**這一層做。存下來的還是官方給的民國，因為那是資料本身的樣子。 #}
{% macro basis(r) -%}
{%- set fq = r.fiscal_quarter or "" -%}
{%- set rm = r.revenue_month or "" -%}
{%- if not fq and not rm -%}<span class="muted">—</span>
{%- else -%}
<span class="basis">
  {%- if fq %}<span class="bq">財報 <b>{{ quarter_label(fq) }}</b></span>{% endif -%}
  {%- if rm %}<span class="br">營收 <b>{{ month_label(rm) }}</b></span>{% endif -%}
</span>
{%- endif -%}
{%- endmacro %}

{# `2026.2Q` -> `2026Q2`。認不出來就原樣印出去——一個看得懂的怪字串，比一個
   自信地印錯的標籤好。 #}
{% macro quarter_label(fq) -%}
{%- set bits = fq.split('.') -%}
{%- if bits|length == 2 and bits[1]|length >= 2 -%}{{ bits[0] }}Q{{ bits[1][0] }}
{%- else -%}{{ fq }}{%- endif -%}
{%- endmacro %}

{# `115/08` -> `2026/08`。四位數的年份當成已經是西元，原樣放行。 #}
{% macro month_label(rm) -%}
{%- set bits = rm.split('/') -%}
{%- if bits|length == 2 and bits[0]|length == 3 and bits[0].isdigit() -%}
{{ bits[0]|int + 1911 }}/{{ bits[1] }}
{%- else -%}{{ rm }}{%- endif -%}
{%- endmacro %}

{% macro table_head() -%}
<thead><tr>
  {# 流水號那一欄不排序：它就是「現在第幾列」，點它沒有意義。 #}
  <th class="seq" aria-label="序號"></th>
  <th class="star-cell" title="觀察清單"><button type="button" class="sortable" data-col="1" aria-label="依觀察清單排序">★</button></th>
  <th><button type="button" class="sortable" data-col="2">代號</button></th>
  <th><button type="button" class="sortable" data-col="3">財報<br>基準</button></th>
  <th><button type="button" class="sortable" data-col="4">名稱</button></th>
  <th><button type="button" class="sortable" data-col="5">市場</button></th>
  <th><button type="button" class="sortable" data-col="6">產業</button></th>
  <th><button type="button" class="sortable" data-col="7">營收<br>年增率</button></th>
  <th><button type="button" class="sortable" data-col="8">營業<br>利益率</button></th>
  <th><button type="button" class="sortable" data-col="9">稅後淨利<br>年增率</button></th>
  <th><button type="button" class="sortable" data-col="10">EPS</button></th>
  <th><button type="button" class="sortable" data-col="11">存貨<br>周轉率</button></th>
  <th><button type="button" class="sortable" data-col="12">自由<br>現金流</button></th>
  <th class="num"><button type="button" class="sortable" data-col="13">綜合<br>評分</button></th>
  <th class="num"><button type="button" class="sortable" data-col="14">評分<br>變化</button></th>
  <th><button type="button" class="sortable" data-col="15">具投資<br>價值</button></th>
  {# 燈泡包在 `.hdtip` 裡和標題**並排**。不包的話它接在
     `報酬<br>風險比` 後面，自己掉到第三行去——整列標題被撐高一截，而且那顆
     燈泡看起來像是下一欄的東西。 #}
  <th class="num"><span class="hdtip"><button type="button" class="sortable" data-col="16">報酬<br>風險比</button>{% call tip() %}
  <b>報酬風險比 ＝ ｜預期報酬 ÷ 預期風險｜</b>，來自〔EPS預估與估價〕。
  它回答的是一件很具體的事：<b>這一筆要對幾次才不會賠</b>。
  {# 這裡刻意**不用 <table>**。它住在一個 <th> 裡面，而表格裡再包一張表格有兩個
     代價：手機上三欄會擠成一團（燈泡本來就窄），以及任何按 `</thead>` 切字串的
     東西都會被裡面那張表的 `</thead>` 騙到——這條測試第一版就是這樣紅的。 #}
  <ul class="rrguide">
    <li><b>小於 1</b><em>要贏 50%～100%</em>
        <span>⚠️ 絕對不要進場。賺的比賠的少，要贏過一半甚至幾乎全對才打平。</span></li>
    <li><b>1.0</b><em>要贏 50%</em>
        <span>⚖️ 勝率必須過半，等於把成敗整個押在方向看對。</span></li>
    <li><b>2.0</b><em>要贏 33.3%</em>
        <span>✅ 及格的進場低標。三次對一次就打平，錯兩次還活著。</span></li>
    <li><b>3.0 或以上</b><em>要贏 25% 以下</em>
        <span>🌟 最理想的交易黃金區。四次對一次就打平，容錯最高。</span></li>
  </ul>
  <p class="stop">中間那一欄是<b>損益兩平所需的最低勝率</b>＝ 1 ÷（1 ＋ 報酬風險比）。</p>
  <p class="stop"><b>無風險</b>＝股價已經低於下檔價，沒有下檔風險，比 3.0 還好。
  <b>空頭</b>＝預期報酬是負的（目標價低於現在的股價）。
  <b>—</b>＝算不出來：多半是還沒回補到〔年度交易資訊〕（沒有本益比區間），
  也可能是預估 EPS 為負、本益比估價不適用。<b>三者不是同一件事</b>。</p>
  <p class="stop">{% for note in reward_risk_notes %}{{ note }}{% if not loop.last %}<br>{% endif %}{% endfor %}</p>
{% endcall %}</span></th>
</tr></thead>
{%- endmacro %}

{# ── 附註：一顆燈泡，按了才展開 ────────────────────────────────────────

   這些段落講的是「這個數字是怎麼算出來的」「什麼時候會變」——第一次讀的人需要
   它，讀第二次的人已經知道了，而它們每一段都比它要解釋的那張表還長。整段攤在
   頁面上，等於每次回來都要先捲過一次同樣的說明才看得到資料。

   收進燈泡裡，兩種讀者都照顧得到：要看的按一下，不看的它只佔一個字的寬度。

   為什麼是 `<button>` 而不是 `<span onclick>`：鍵盤 Tab 走得到、Enter 和空白鍵
   按得下、螢幕閱讀器會念出「說明，按鈕，摺疊」。`aria-expanded` 由 site.js 跟著
   狀態改；沒有 JavaScript 的時候整塊直接展開（見 site.css 的 :not(.js) 規則），
   因為看不到的說明比擠在頁面上的說明糟。

   用法：

       {% call tip() %}<b>什麼時候會換。</b>……{% endcall %}
#}
{% macro tip() -%}
<span class="tip"><button type="button" class="bulb" aria-expanded="false"
  title="說明"><span aria-hidden="true">💡</span><span class="sr">說明</span></button
  ><span class="tipbox" role="note">{{ caller() }}</span></span>
