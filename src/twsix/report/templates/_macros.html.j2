{% macro grade(letter) -%}
{%- if letter in ('AA','A','BB','B','C') -%}
<span class="g g-{{ letter }}">{{ letter }}</span>
{%- else -%}
<span class="g g-na">{{ letter or '—' }}</span>
{%- endif -%}
{%- endmacro %}

{% macro delta(v) -%}
{%- if v is none or v == '' -%}<span class="muted">—</span>
{%- elif v > 0 -%}<span class="up">+{{ '%.2f'|format(v) }}</span>
{%- elif v < 0 -%}<span class="down">{{ '%.2f'|format(v) }}</span>
{%- else -%}0.00{%- endif -%}
{%- endmacro %}

{# 綜合評分 is a mean of six integers, so a third of the values are repeating
   decimals.  Printed raw they came out as 「3.8333333333」 and 「3.1666666667」
   in a column two digits wide — precision the score does not have, in a place
   nobody can use it.  Two decimals to read, the full value in the tooltip for
   anyone comparing two stocks that tie at 3.17.  Non-numeric scores
   （「數據不足」）pass through as they are. #}
{% macro score(v) -%}
{%- if v is none or v == '' -%}<span class="muted">—</span>
{%- else -%}
{%- set f = v|float(default=none) -%}
{%- if f is none -%}<span class="muted">{{ v }}</span>
{%- else -%}<span title="{{ v }}">{{ '%.2f'|format(f) }}</span>{%- endif -%}
{%- endif -%}
{%- endmacro %}

{# `rich_ids` is the set of stocks whose sheets were fetched, so their page is
   the ten-section one rather than the grade table.  Marked because otherwise
   the only way to find them is to click through 1,741 codes — and the mark is
   a word, not a colour, so it survives a greyscale print. #}
{% macro row(r, rel, rich_ids=None) -%}
<tr>
  <td><a href="{{ rel }}stock/{{ r.stock_id }}.html">{{ r.stock_id }}</a>
    {%- if rich_ids and r.stock_id in rich_ids %} <span class="tag full" title="已抓取完整資料，含河流圖、季節性、外資投信與個股新聞">完整</span>{% endif %}</td>
  <td>{{ r.name }}</td>
  <td class="muted">{{ r.industry }}</td>
  <td>{{ grade(r.grades.revenue_yoy) }}</td>
  <td>{{ grade(r.grades.operating_margin) }}</td>
  <td>{{ grade(r.grades.net_income_yoy) }}</td>
  <td>{{ grade(r.grades.eps) }}</td>
  <td>{{ grade(r.grades.inventory_turnover) }}</td>
  <td>{{ grade(r.grades.free_cash_flow) }}</td>
  <td class="num">{{ score(r.composite) }}</td>
  <td class="num">{{ delta(r.composite_delta) }}</td>
  <td>{% if r.value_pick %}<span class="pick">具投資價值</span>{% endif %}</td>
</tr>
{%- endmacro %}

{% macro table_head() -%}
<thead><tr>
  <th>代號</th><th>名稱</th><th>產業</th>
  <th>營收<br>年增率</th><th>營業<br>利益率</th><th>稅後淨利<br>年增率</th>
  <th>EPS</th><th>存貨<br>周轉率</th><th>自由<br>現金流</th>
  <th>綜合<br>評分</th><th>評分<br>變化</th><th></th>
</tr></thead>
{%- endmacro %}
