<div class="ai-tabs" role="tablist" aria-label="AI 選股">
  <button type="button" role="tab" id="aitab-a" class="ai-tab ai-j-sa" aria-controls="ai-a" aria-selected="true">A 營收驚喜</button>
  <button type="button" role="tab" id="aitab-b" class="ai-tab ai-j-sb" aria-controls="ai-b" aria-selected="false" tabindex="-1">B 供應鏈連動</button>
  <button type="button" role="tab" id="aitab-talks" class="ai-tab ai-j-t" aria-controls="ai-talks" aria-selected="false" tabindex="-1">C 法說轉折</button>
  <button type="button" role="tab" id="aitab-d" class="ai-tab ai-j-sd" aria-controls="ai-d" aria-selected="false" tabindex="-1">D 籌碼共振</button>
  <button type="button" role="tab" id="aitab-veto" class="ai-tab ai-j-e" aria-controls="ai-veto" aria-selected="false" tabindex="-1">E 財報品質</button>
  <button type="button" role="tab" id="aitab-regime" class="ai-tab ai-j-f" aria-controls="ai-regime" aria-selected="false" tabindex="-1">F 市場狀態</button>
  <button type="button" role="tab" id="aitab-paper" class="ai-tab ai-j-p" aria-controls="ai-paper" aria-selected="false" tabindex="-1">影子帳戶</button>
  {% if ai.bt %}
  <button type="button" role="tab" id="aitab-backtest" class="ai-tab ai-j-b" aria-controls="ai-backtest" aria-selected="false" tabindex="-1">回測</button>
  {% endif %}
  <button type="button" role="tab" id="aitab-journal" class="ai-tab ai-j-j" aria-controls="ai-journal" aria-selected="false" tabindex="-1">日誌</button>
  <button type="button" role="tab" id="aitab-gloss" class="ai-tab ai-j-g" aria-controls="ai-gloss" aria-selected="false" tabindex="-1">名詞解釋</button>
</div>

{# ── A 營收驚喜／B 供應鏈連動／D 籌碼共振（原〔今日候選〕，2026-10-06 拆成三頁） ── #}
{# 一鍵匯入觀察清單（2026-10-05）：代號在建站時就寫進按鈕，見 site.js 的 TWSIXImport。 #}
{% macro wg_imp(src, name, cands) -%}
{%- if cands -%}<button type="button" class="wg-imp" data-wg-src="{{ src }}" data-wg-name="{{ name }}"
  data-wg-codes="{{ cands|map(attribute='code')|join(',') }}" title="把這 {{ cands|length }} 檔匯入觀察清單〔{{ name }}〕">⇩ 匯入觀察清單</button>{%- endif -%}
{%- endmacro %}
<section class="ai-block ai-panel" id="ai-a" role="tabpanel" aria-labelledby="aitab-a">
  <h3 class="ai-h"><span class="ai-tag ai-tag-A">A</span>營收驚喜
    <span class="ai-cnt ai-cnt-A">共 {{ ai.a_total }} 檔符合</span>
    <span class="muted">（{{ ai.a.month or '—' }} 營收，{{ ai.a.day or '—' }} 評分，{{ ai.a.universe or 0 }} 檔參與；列前 {{ ai.a_cands|length }}）</span>{% call tip() %}{{ aig('A') }}{% endcall %}
    {{ wg_imp('ai-a', 'AI營收驚喜', ai.a_cands) }}</h3>
  <p class="ai-lead">A 每月一次（月營收公布後）。最近一次的名單已經過了財報品質否決（E）；「法說」一欄是那一檔最近一次法說的轉折（C），負轉折的不會進影子帳戶。</p>
  <p class="muted">營收比「去年同月 × 最近的成長速度」好很多（標準化後全市場前 10%）、連兩個月比預期好、年增為正、還沒被搶先反應。</p>
  {% if ai.a_cands %}
  <div class="scroll"><table class="ai-t">
    <thead><tr><th>代號</th><th>名稱</th><th>產業</th><th class="num">SUE</th><th class="num">年增</th><th class="num">收盤</th><th class="num">六大</th><th>法說</th><th class="ai-hide-m">理由</th></tr></thead>
    <tbody>{% for c in ai.a_cands %}
      <tr><td>{{ sl(c.code, c.code) }}</td><td>{{ sl(c.code, c.name) }}</td><td class="muted">{{ c.industry }}</td>
        <td class="num"><b>{{ '%+.1f'|format(c.extra.sue) }}</b></td>
        <td class="num {{ 'up' if c.extra.yoy > 0 else 'down' }}">{{ '%+.0f'|format(c.extra.yoy * 100) }}%</td>
        <td class="num">{{ c.close }}<a class="yf" href="{{ yahoo_ta(c.code, c.market or '') }}" target="_blank" rel="noopener" title="Yahoo股市技術分析" aria-label="{{ c.code }} Yahoo 技術分析"></a></td><td class="num">{{ c.six_txt }}</td>
        <td class="{{ c.turn_tone }}">{{ c.turn_txt or '—' }}</td>
        <td class="ai-reasons ai-hide-m">{{ c.reasons|join('；') }}</td></tr>
    {% endfor %}</tbody></table></div>
  {% else %}<p class="stale">最近一次沒有符合全部條件的股票。</p>{% endif %}

</section>

<section class="ai-block ai-panel" id="ai-b" role="tabpanel" aria-labelledby="aitab-b" hidden>
  <h3 class="ai-h"><span class="ai-tag ai-tag-B">B</span>供應鏈連動
    <span class="ai-cnt ai-cnt-B">共 {{ ai.b_total }} 檔符合</span>
    <span class="muted">（{{ ai.b.day or '—' }}，連動圖建於 {{ ai.b.graph_day or '—' }}；列前 {{ ai.b_cands|length }}）</span>{% call tip() %}{{ aig('B') }}{% endcall %}
    {{ wg_imp('ai-b', 'AI供應鏈連動', ai.b_cands) }}</h3>
  <p class="ai-lead">B 每週一次。最近一次的名單已經過了財報品質否決（E）；「法說」一欄是那一檔最近一次法說的轉折（C），負轉折的不會進影子帳戶。</p>
  <p class="muted">「鄰居」是扣掉大盤之後股價長期一起動的那幾家（多半是上下游或同一題材）。鄰居 20 日平均漲幅在全市場前 10%、自己落後、趨勢沒壞。
    鄰居關係的文字說明是 LLM 註解，只供參考，不影響選股。</p>
  {% if ai.b_cands %}
  <div class="scroll"><table class="ai-t">
    <thead><tr><th>代號</th><th>名稱</th><th>產業</th><th class="num">鄰居 20 日</th><th class="num">自己 20 日</th><th class="num">落後</th><th>主要鄰居</th><th>法說</th></tr></thead>
    <tbody>{% for c in ai.b_cands %}
      <tr><td>{{ sl(c.code, c.code) }}</td><td>{{ sl(c.code, c.name) }}</td><td class="muted">{{ c.industry }}</td>
        <td class="num {{ 'up' if c.extra.nm > 0 else 'down' }}">{{ '%+.1f'|format(c.extra.nm * 100) }}%</td>
        <td class="num {{ 'up' if c.extra.own > 0 else 'down' }}">{{ '%+.1f'|format(c.extra.own * 100) }}%</td>
        <td class="num"><b>{{ '%.1f'|format(c.extra.gap * 100) }}%</b></td>
        <td class="ai-reasons">{% for n in (c.neighbors or [])[:4] %}{{ sl(n.code, n.name) }}<span class="muted">（{{ '%.2f'|format(n.corr) if n.corr is not none else '—' }}{% if n.relation %}｜{{ n.relation }}{% endif %}）</span>{% if not loop.last %}、{% endif %}{% endfor %}</td>
        <td class="{{ c.turn_tone }}">{{ c.turn_txt or '—' }}</td></tr>
    {% endfor %}</tbody></table></div>
  {% else %}<p class="stale">最近一次沒有符合全部條件的股票。</p>{% endif %}

</section>

{# ── C 法說轉折 ─────────────────────────────────────────────── #}
<section class="ai-block ai-panel" id="ai-talks" role="tabpanel" aria-labelledby="aitab-talks" hidden>
  <h3 class="ai-h"><span class="ai-tag ai-tag-t">C</span>法說轉折{% call tip() %}{{ aig('C') }}{% endcall %}
    <span class="muted">（近 90 天，{{ ai.turns|length }} 家；累計讀過 {{ t.talks_count or 0 }} 份簡報）</span></h3>
  <p class="ai-lead">同一家公司這一次法說和上一次的<b>差異</b>：營收方向、毛利率方向、整體口氣。
    轉折 ≤ −2 是負轉折——影子帳戶不買、持有中的隔一個交易日出場。這份資料從上線那天才開始累積，回測期間沒有。</p>
  <p class="muted ai-llm">讀法：{% if ai.llm.enabled %}<b>LLM（Google Gemini{% if ai.llm.model %}，{{ ai.llm.model }}{% endif %}）</b>，
    上一趟呼叫 {{ ai.llm.calls }} / {{ ai.llm.max_calls }} 次{% if ai.llm.stopped %}（{{ ai.llm.stopped }}）{% endif %}；沒輪到的用規則讀。
    {% else %}<b>規則</b>（數簡報裡的正面詞與負面詞）。設定 repo secret <code>GEMINI_API_KEY</code> 之後改由 LLM 讀持股與候選的簡報。{% endif %}
    {% if ai.fetch.ran_at %}上一趟抓取：{{ ai.fetch.ran_at }}。{% endif %}</p>
  {% if ai.turns %}
  <div class="scroll"><table class="ai-t">
    <thead><tr><th>代號</th><th>名稱</th><th>法說日</th><th>轉折</th><th class="num">分數</th><th>讀法</th><th>摘要</th></tr></thead>
    <tbody>{% for x in ai.turns[:30] %}
      <tr><td>{{ sl(x.code, x.code) }}</td><td>{{ sl(x.code, x.name) }}</td><td>{{ x.date }}</td>
        <td class="{{ 'down' if x.kind == '負轉折' else ('up' if x.kind == '正轉折' else 'muted') }}">{{ x.kind }}{% if not x.prev_date %}<span class="muted">（第一次，沒有可比）</span>{% endif %}</td>
        <td class="num">{{ '%+.1f'|format(x.score) }}</td><td class="muted">{{ 'LLM' if x.method == 'llm' else '規則' }}</td>
        <td class="ai-reasons">{{ x.summary or ('；'.join(x.highlights) if x.highlights else '—') }}</td></tr>
    {% endfor %}</tbody></table></div>
  {% else %}
  <p class="muted">還沒有資料：法說會簡報從 <code>twsix aipick-fetch</code> 第一次跑的那天開始累積。</p>
  {% endif %}
</section>

<section class="ai-block ai-panel" id="ai-d" role="tabpanel" aria-labelledby="aitab-d" hidden>
  <h3 class="ai-h"><span class="ai-tag ai-tag-D">D</span>籌碼共振
    <span class="ai-cnt ai-cnt-D">共 {{ ai.d_cands|length }} 檔符合</span>
    <span class="muted">（集保 {{ t.week or '—' }}，{{ t.universe }} 檔參與排名）</span>{% call tip() %}{{ aig('D') }}<br><br>{{ aig('score') }}{% endcall %}
    {{ wg_imp('ai-d', 'AI籌碼共振', ai.d_cands) }}</h3>
  <p class="ai-lead">D 每週一次（集保週資料更新後）。最近一次的名單已經過了財報品質否決（E）；「法說」一欄是那一檔最近一次法說的轉折（C），負轉折的不會進影子帳戶。</p>
  <p class="muted">大戶（＞1,000 張）持股增加、股東人數減少、法人買超、董監增持——四個獨立來源同時偏多，
    <b>但股價還沒動</b>（20 日報酬低於同產業）、趨勢沒壞（站上 60 日線）。</p>
  {% if ai.d_cands %}
  <div class="scroll"><table class="ai-t">
    <thead><tr><th>代號</th><th>名稱</th><th>產業</th><th class="num">共振分數</th>
      <th class="num">收盤</th><th class="num">20 日</th><th class="num">同業</th><th class="num">六大</th><th>法說</th><th>理由</th></tr></thead>
    <tbody>{% for c in ai.d_cands %}
      <tr><td>{{ sl(c.code, c.code) }}</td><td>{{ sl(c.code, c.name) }}</td>
        <td class="muted">{{ c.industry }}</td><td class="num"><b>{{ c.score_txt }}</b></td>
        <td class="num">{{ c.close }}<a class="yf" href="{{ yahoo_ta(c.code, c.market or '') }}" target="_blank" rel="noopener" title="Yahoo股市技術分析" aria-label="{{ c.code }} Yahoo 技術分析"></a></td><td class="num {{ c.ret20_tone }}">{{ c.ret20_txt }}</td>
        <td class="num muted">{{ c.ind_txt }}</td><td class="num">{{ c.six_txt }}</td>
        <td class="{{ c.turn_tone }}">{{ c.turn_txt or '—' }}</td>
        <td class="ai-reasons">{{ c.reasons|join('；') }}</td></tr>
    {% endfor %}</tbody></table></div>
  {% else %}<p class="stale">這一週沒有同時符合全部條件的股票。</p>{% endif %}
  {% if ai.weights %}
  <details class="ai-more"><summary>D 這一週的權重（由過去各週學出來的）</summary>
    <p class="muted">每個特徵和「之後 20 個交易日報酬」的等級相關（rank IC），取過去各週平均，負的歸零。歷史不到 8 週時一律等權。</p>
    <ul class="ai-bars">{% for name, w in ai.weights %}
      <li><span>{{ name }}</span><i style="--w:{{ (w * 100)|round(1) }}%"></i><b>{{ '%.0f'|format(w * 100) }}%</b></li>
    {% endfor %}</ul>
  </details>
  {% endif %}
</section>

{# ── E 財報品質（否決名單） ─────────────────────────────────────────────── #}
<section class="ai-block ai-panel" id="ai-veto" role="tabpanel" aria-labelledby="aitab-veto" hidden>
  <h3 class="ai-h"><span class="ai-tag ai-tag-e">E</span>財報品質否決名單{% call tip() %}{{ aig('E') }}{% endcall %}
    <span class="muted">（{{ t.veto_count }} / {{ t.rated }} 檔，紅旗三面以上）</span></h3>
  <p class="ai-lead">財報八面：本業虧損、連兩季虧損、獲利靠業外、獲利沒有變成現金、應計比率偏高、負債快速上升、營收大幅衰退、董監高質押。
    重大訊息四面：非例行更換簽證會計師、財務／會計主管異動、退票／重整／繼續經營疑慮（算兩面）、停工／災害。
    這一層不選股，只把地雷擋在外面。</p>
  {% if ai.news_flags %}
  <details class="ai-more"><summary>近 60 天的重訊警訊（{{ ai.news_flags|length }} 則）</summary>
    <div class="scroll"><table class="ai-t">
      <thead><tr><th>日期</th><th>代號</th><th>名稱</th><th>警訊</th><th>主旨</th></tr></thead>
      <tbody>{% for n in ai.news_flags %}
        <tr><td>{{ n.date }}</td><td>{{ sl(n.code, n.code) }}</td><td>{{ sl(n.code, n.name) }}</td>
          <td class="down">{{ n.label }}</td><td class="ai-reasons">{{ n.subject }}</td></tr>
      {% endfor %}</tbody></table></div>
  </details>
  {% else %}
  <p class="muted">重大訊息從 <code>twsix aipick-fetch</code> 第一次跑的那天開始存（已存 {{ t.news_days or 0 }} 天），目前沒有警訊。</p>
  {% endif %}
  <details class="ai-more"><summary>展開否決名單</summary>
    <div class="scroll"><table class="ai-t">
      <thead><tr><th>代號</th><th>名稱</th><th>產業</th><th>財報</th><th class="num">紅旗</th><th>明細</th></tr></thead>
      <tbody>{% for v in t.vetoes %}
        <tr><td>{{ sl(v.code, v.code) }}</td><td>{{ sl(v.code, v.name) }}</td><td class="muted">{{ v.industry }}</td>
          <td>{{ v.quarter }}</td><td class="num"><b>{{ v.score if v.score is defined else v.flags|length }}</b></td>
          <td class="ai-reasons">{{ v.details|join('；') }}</td></tr>
      {% endfor %}</tbody></table></div>
  </details>
</section>

{# ── F 市場狀態 ─────────────────────────────────────────────── #}
<section class="ai-block ai-panel" id="ai-regime" role="tabpanel" aria-labelledby="aitab-regime" hidden>
  <h3 class="ai-h"><span class="ai-tag ai-tag-f">F</span>市場狀態{% call tip() %}{{ aig('F') }}{% endcall %}</h3>
  {% if rn %}
  <div class="ai-regime ai-tone-{{ rn.tone }}">
    <div class="ai-regime-main">
      <span class="ai-state">{{ rn.state }}</span>
      <span class="ai-cap">持股上限 <b>{{ rn.cap }}</b> 檔（{{ (rn.exposure * 100)|round|int }}%）</span>
    </div>
    <ul class="ai-why">{% for r in rn.reasons %}<li>{{ r }}</li>{% endfor %}</ul>
    {% if rf and rf.state != rn.state %}
    <p class="ai-note">本週生效中的是「{{ rf.state }}」（上週最後一個交易日判定）；上面這個讀數在本週最後一個交易日收盤後才會生效。</p>
    {% endif %}
  </div>
  <div class="ai-gauges">
    <div><span>市場寬度{% call tip() %}{{ aig('breadth') }}{% endcall %}</span><b>{{ '%.0f'|format(rn.breadth) }}%</b><em>站上 60 日線的比例（20 日均 {{ '%.0f'|format(rn.breadth_ma20) }}%）</em></div>
    <div><span>加權指數</span><b>{{ '{:,.0f}'.format(rn.taiex) if rn.taiex else '—' }}</b><em>200 日線 {{ '{:,.0f}'.format(rn.taiex_ma200) if rn.taiex_ma200 else '—' }}</em></div>
    <div><span>VIX</span><b>{{ '%.1f'|format(rn.vix) if rn.vix else '—' }}</b><em>&gt; 30 視為恐慌</em></div>
    <div><span>台灣 PMI</span><b>{{ '%.1f'|format(rn.pmi) if rn.pmi else '—' }}</b><em>50 為榮枯線</em></div>
    <div><span>市值貨幣比</span><b>{{ '%.0f'|format(rn.mcm1b_pct) if rn.mcm1b_pct is not none else '—' }}</b><em>近五年百分位</em></div>
  </div>
  <div class="ai-chart" id="ai-breadth-chart"></div>
  {% else %}
  <p class="stale">總經資料不足，這一次沒有判定（持股上限暫用 7 檔）。</p>
  {% endif %}
</section>

{# ── 合併影子帳戶 ─────────────────────────────────────────────── #}
<section class="ai-block ai-panel" id="ai-paper" role="tabpanel" aria-labelledby="aitab-paper" hidden>
  <h3 class="ai-h"><span class="ai-tag ai-tag-p">影</span>影子帳戶{% call tip() %}{{ aig('paper') }}<br><br>{{ aig('combo') }}{% endcall %}
    <span class="muted">（{{ ai.port.live_start }} 上線，虛擬 100 萬）</span></h3>
  <p class="ai-lead">{{ ai.port.rules }}。最多 12 檔、每檔 1/12；同一天有兩套以上出訊號時輪流挑，
    三套同時看好的排最前面；每一筆持股照買進它的那一套規則出場。</p>
  <div class="ai-kpis">
    <div><span>帳戶淨值</span><b>{{ '{:,.0f}'.format(ai.port_value or 0) }}</b></div>
    <div><span>累計報酬</span><b class="{{ ai.port_ret_tone }}">{{ ai.port_ret }}</b></div>
    <div><span>同期 0050</span><b class="{{ ai.bench_ret_tone }}">{{ ai.bench_ret }}</b></div>
    <div><span>持股</span><b>{{ ai.port.positions|length }} 檔</b></div>
    <div><span>已實現交易</span><b>{{ ai.port.trades|length }} 筆</b></div>
  </div>
  {% if (ai.port.dates or [])|length > 1 %}<div class="ai-chart" id="ai-paper-chart"></div>{% endif %}
  {% if ai.port.positions %}
  <div class="scroll"><table class="ai-t">
    <thead><tr><th>代號</th><th>名稱</th><th>方案</th><th>進場日</th><th class="num">進場價</th><th class="num">現價</th>
      <th class="num">報酬（扣成本）</th><th class="num">停損</th><th>法說</th><th>進場理由</th></tr></thead>
    <tbody>{% for p in ai.port.positions %}
      <tr><td>{{ sl(p.code, p.code) }}</td><td>{{ sl(p.code, p.name) }}</td>
        <td><span class="ai-s ai-s-{{ p.strategy or 'D' }}">{{ p.label }}</span></td><td>{{ p.entry_date }}</td>
        <td class="num">{{ p.entry_price }}</td><td class="num">{{ p.price }}<a class="yf" href="{{ yahoo_ta(p.code, p.market or '') }}" target="_blank" rel="noopener" title="Yahoo股市技術分析" aria-label="{{ p.code }} Yahoo 技術分析"></a></td>
        <td class="num {{ p.ret_tone }}">{{ p.ret_txt }}</td><td class="num">{{ '%.2f'|format(p.stop) }}</td>
        <td>{% if p.turn %}{{ p.turn.kind }}（{{ '%+.1f'|format(p.turn.score) }}）{% else %}<span class="muted">—</span>{% endif %}</td>
        <td class="ai-reasons">{{ p.reason }}</td></tr>
    {% endfor %}</tbody></table></div>
  {% else %}
  <p class="muted">目前沒有持股。下一個訊號日（A 每月 10 日後、B 每週最後一個交易日、D 每週集保資料日）出來後，符合條件的候選會在下一個交易日收盤進場。</p>
  {% endif %}
  {% if ai.port_by %}
  <p class="muted">已實現交易依方案：{% for n, k, avg, tone, win in ai.port_by %}{{ n }} {{ k }} 筆、平均 <span class="{{ tone }}">{{ avg }}</span>、勝率 {{ win }}{% if not loop.last %}；{% endif %}{% endfor %}</p>
  {% endif %}
  {% if ai.port.trades %}
  <details class="ai-more"><summary>已實現交易（{{ ai.port.trades|length }} 筆）</summary>
    <div class="scroll"><table class="ai-t">
      <thead><tr><th>代號</th><th>名稱</th><th>方案</th><th>進場</th><th>出場</th><th class="num">天數</th><th class="num">報酬</th><th>出場理由</th></tr></thead>
      <tbody>{% for x in ai.port.trades|reverse %}
        <tr><td>{{ sl(x.code, x.code) }}</td><td>{{ sl(x.code, x.name) }}</td><td class="muted">{{ x.label }}</td><td>{{ x.entry_date }}</td><td>{{ x.exit_date }}</td>
          <td class="num">{{ x.days }}</td><td class="num {{ x.ret_tone }}">{{ x.ret_txt }}</td><td>{{ x.reason_out }}</td></tr>
      {% endfor %}</tbody></table></div>
  </details>
  {% endif %}
</section>






{# ── 回測 ─────────────────────────────────────────────── #}
{% if ai.bt %}
<section class="ai-block ai-panel" id="ai-backtest" role="tabpanel" aria-labelledby="aitab-backtest" hidden>
  <h3 class="ai-h"><span class="ai-tag ai-tag-b">驗</span>回測{% call tip() %}{{ aig('stats') }}<br><br>{{ aig('since_full') }}<br><br>{{ aig('a_ver') }}<br><br>{{ aig('d_ver') }}<br><br>{{ aig('bench_f') }}<br><br>{{ aig('bench_ew') }}{% endcall %}</h3>
  <p class="ai-lead">成本：買 0.1425%、賣 0.1425% ＋ 0.3% 證交稅（一買一賣 0.585%，未算折扣與滑價）。
    除權息日當天報酬記 0；已下市的公司放回母體（不做倖存者偏差）。財報在法定公告期限之後、營收在次月 10 日之後才算看得到。
    各方案的資料起點不同：營收約 2022 年中起、股價 2023-08 起、法人（外資、投信）2023-09 起、集保 2025-09 起——方案 D 要集保，所以它的回測從 2025-09 開始。</p>
  <div class="ai-verdict">{% for p in ai.verdict %}<p>{{ p|safe }}</p>{% endfor %}</div>
  {% if 'ai-all-chart' in ai.chart_ids %}<div class="ai-chart" id="ai-all-chart"></div>{% endif %}
  <div class="scroll"><table class="ai-t ai-stats">
    <thead><tr><th></th><th>期間</th><th class="num">總報酬</th><th class="num">年化</th><th class="num">最大回撤</th><th class="num">夏普</th>
      <th class="num">交易數</th><th class="num">勝率</th><th class="num">平均每筆</th><th class="num">獲利因子</th><th class="num">平均天數</th></tr></thead>
    <tbody>{% for name, s, cls in ai.s_rows %}
      <tr class="{{ cls }}"><th>{{ name }}</th><td class="muted">{{ s.start }} ～ {{ s.end }}</td>
        <td class="num {{ s.total_tone }}">{{ s.total }}</td><td class="num {{ s.cagr_tone }}">{{ s.cagr }}</td>
        <td class="num">{{ s.mdd }}</td><td class="num">{{ s.sharpe }}</td><td class="num">{{ s.trades if s.trades is not none else '—' }}</td>
        <td class="num">{{ s.win_rate if s.trades else '—' }}</td><td class="num {{ s.avg_ret_tone }}">{{ s.avg_ret if s.trades else '—' }}</td>
        <td class="num">{{ s.profit_factor if s.trades else '—' }}</td><td class="num">{{ s.avg_days if s.trades else '—' }}</td></tr>
    {% endfor %}
    {% for name, s, cls in ai.bench_rows %}
      <tr class="{{ cls }}"><th>{{ name }}</th><td class="muted">{{ s.start }} ～ {{ s.end }}</td>
        <td class="num {{ s.total_tone }}">{{ s.total }}</td><td class="num {{ s.cagr_tone }}">{{ s.cagr }}</td>
        <td class="num">{{ s.mdd }}</td><td class="num">{{ s.sharpe }}</td><td class="num">—</td><td class="num">—</td><td class="num">—</td><td class="num">—</td><td class="num">—</td></tr>
    {% endfor %}</tbody></table></div>
  {% if ai.by_strategy %}
  <p class="muted">合併帳戶（三套都在的那一段）依方案：{% for n, k, avg, tone, win in ai.by_strategy %}{{ n }} {{ k }} 筆、平均 <span class="{{ tone }}">{{ avg }}</span>、勝率 {{ win }}{% if not loop.last %}；{% endif %}{% endfor %}。</p>
  {% endif %}

  <h4>訊號本身：候選股之後 20 個交易日 vs 全市場{% call tip() %}{{ aig('sig') }}{% endcall %}</h4>
  <div class="scroll"><table class="ai-t">
    <thead><tr><th>方案</th><th class="num">平均超額報酬</th><th class="num">贏的次數</th></tr></thead>
    <tbody>{% for n, v, tone, hit, cnt in ai.sig_rows %}
      <tr><th>{{ n }}</th><td class="num {{ tone }}">{{ v }}</td><td class="num">{{ hit if hit is not none else '—' }} / {{ cnt or '—' }}</td></tr>
    {% endfor %}</tbody></table></div>
  <p class="muted">「全市場」是同一天股價 &gt; 10 元、20 日均額 &gt; 5,000 萬的所有股票的平均——候選股就是從這一群裡挑的。這一欄沒有成本、沒有停損、沒有部位限制，是訊號的上限。</p>

  <details class="ai-more"><summary>各方案的淨值圖</summary>
    {% for cid in ('ai-allfull-chart', 'ai-a-chart', 'ai-b-chart', 'ai-d-chart') %}
    {% if cid in ai.chart_ids %}<div class="ai-chart" id="{{ cid }}"></div>{% endif %}
    {% endfor %}
  </details>
  {% if ai.ic %}
  <details class="ai-more"><summary>D 各特徵的平均 IC</summary>
    <ul class="ai-ic">{% for name, v, n in ai.ic %}
      <li><span>{{ name }}</span><b class="{{ 'up' if v and v > 0 else 'down' }}">{{ '%+.3f'|format(v) if v is not none else '—' }}</b><em>{{ n }} 週</em></li>
    {% endfor %}</ul>
    <p class="muted">IC 是特徵排名和之後 20 日報酬排名的相關係數。±0.02 左右是很弱的訊號；負的特徵權重是 0。</p>
  </details>
  {% endif %}

  <h4>F 市場狀態：0050 擇時 vs 買進持有{% call tip() %}{{ aig('bench_f') }}{% endcall %} <span class="muted">（{{ ai.f_rows[0][1].start }} ～ {{ ai.f_rows[0][1].end }}）</span></h4>
  {% if 'ai-f-chart' in ai.chart_ids %}<div class="ai-chart" id="ai-f-chart"></div>{% endif %}
  <div class="scroll"><table class="ai-t ai-stats">
    <thead><tr><th></th><th class="num">總報酬</th><th class="num">年化</th><th class="num">最大回撤</th><th class="num">夏普</th></tr></thead>
    <tbody>{% for name, s, cls in ai.f_rows %}
      <tr class="{{ cls }}"><th>{{ name }}</th><td class="num {{ s.total_tone }}">{{ s.total }}</td><td class="num {{ s.cagr_tone }}">{{ s.cagr }}</td>
        <td class="num">{{ s.mdd }}</td><td class="num">{{ s.sharpe }}</td></tr>
    {% endfor %}</tbody></table></div>
  <p class="muted">這段期間各狀態的天數比例：{% for k, v in ai.f_states %}{{ k }} {{ '%.0f'|format(v * 100) }}%{% if not loop.last %}、{% endif %}{% endfor %}。
    市場狀態在多頭年份的代價是少賺——它換到的是比較小的回撤，不是比較高的報酬。</p>

  <h4>E 財報品質否決：被否決的那一組之後真的比較差嗎</h4>
  <p>每次財報公布期限之後 {{ ai.e.horizon }} 個交易日，被否決的公司報酬<b>中位數</b>比其他公司
    <b class="{{ ai.e.median_gap_tone }}">{{ ai.e.median_gap }}</b>（平均），{{ ai.e.periods }} 次裡有 {{ ai.e.veto_worse }} 次比較差。
    <span class="muted">（平均數差 {{ ai.e.mean_gap }}——被否決的多是小型股，少數幾檔暴漲會把平均拉高，但典型的那一檔是跌的。）</span></p>
  <details class="ai-more"><summary>各期明細</summary>
  <div class="scroll"><table class="ai-t">
    <thead><tr><th>公布期限後</th><th class="num">被否決</th><th class="num">其他</th><th class="num">中位數：被否決</th><th class="num">中位數：其他</th><th class="num">差</th></tr></thead>
    <tbody>{% for r in ai.e.rows %}
      <tr><td>{{ r.date }}</td><td class="num">{{ r.n_veto }}</td><td class="num">{{ r.n_ok }}</td>
        <td class="num">{{ r.veto_txt }}</td><td class="num">{{ r.ok_txt }}</td><td class="num {{ r.gap_tone }}">{{ r.gap_txt }}</td></tr>
    {% endfor %}</tbody></table></div>
  </details>
</section>
{% endif %}


{# ── 訊號日誌 ─────────────────────────────────────────────── #}
<section class="ai-block ai-panel" id="ai-journal" role="tabpanel" aria-labelledby="aitab-journal" hidden>
  <h3 class="ai-h"><span class="ai-tag ai-tag-j">誌</span>訊號日誌 <span class="muted">（最近 {{ ai.journal|length }} 筆，只往後加、不改寫）</span></h3>
  {% if ai.journal %}
  <div class="scroll"><table class="ai-t">
    <thead><tr><th>日期</th><th>方案</th><th>動作</th><th>代號</th><th>名稱</th><th class="num">價格</th><th>說明</th></tr></thead>
    <tbody>{% for j in ai.journal %}
      <tr><td>{{ j.date }}</td><td class="muted">{{ j.strategy }}</td><td>{{ j.action }}</td><td>{{ sl(j.code, j.code) }}</td>
        <td>{{ sl(j.code, j.name) }}</td><td class="num">{{ j.price }}</td><td class="ai-reasons">{{ j.note }}</td></tr>
    {% endfor %}</tbody></table></div>
  {% else %}
  <p class="muted">還沒有紀錄。影子帳戶從 {{ ai.port.live_start }} 開始，第一筆會在下一個訊號日之後出現。</p>
  {% endif %}
</section>

{# ── 名詞解釋 ─────────────────────────────────────────────── #}
<section class="ai-block ai-panel" id="ai-gloss" role="tabpanel" aria-labelledby="aitab-gloss" hidden>
  <h3 class="ai-h"><span class="ai-tag ai-tag-g">詞</span>名詞解釋</h3>
  <p class="ai-lead">各段標題旁的 💡 是這裡的節錄。定義照程式碼寫；數字門檻改了，這裡跟著改。</p>
  <dl class="ai-gl">
    <dt>市場寬度</dt><dd>{{ aig('breadth') }}</dd>
    <dt>F 市場狀態／部位上限</dt><dd>{{ aig('F') }}</dd>
    <dt>影子帳戶</dt><dd>{{ aig('paper') }}</dd>
    <dt>合併帳戶</dt><dd>{{ aig('combo') }}</dd>
    <dt>A 營收驚喜</dt><dd>{{ aig('A') }}</dd>
    <dt>營收 SUE</dt><dd>{{ aig('sue') }}</dd>
    <dt>B 供應鏈連動</dt><dd>{{ aig('B') }}</dd>
    <dt>D 籌碼共振</dt><dd>{{ aig('D') }}</dd>
    <dt>共振分數</dt><dd>{{ aig('score') }}</dd>
    <dt>E 財報品質（否決）</dt><dd>{{ aig('E') }}</dd>
    <dt>C 法說負轉折</dt><dd>{{ aig('C') }}</dd>
    <dt>合併帳戶（三套都在）／合併帳戶（全期）</dt><dd>{{ aig('since_full') }}</dd>
    <dt>A 營收驚喜・一致版／規劃版</dt><dd>{{ aig('a_ver') }}</dd>
    <dt>B 供應鏈連動（回測）</dt><dd>只有一個版本：停損 3 × ATR14、持有滿 20 個交易日出場，和影子帳戶一樣。</dd>
    <dt>D 籌碼共振・週期對齊版／規劃版</dt><dd>{{ aig('d_ver') }}</dd>
    <dt>0050 ＋ 市場狀態（F）</dt><dd>{{ aig('bench_f') }}</dd>
    <dt>全市場等權（流動性門檻以上）</dt><dd>{{ aig('bench_ew') }}</dd>
    <dt>平均超額報酬、贏的次數</dt><dd>{{ aig('sig') }}</dd>
    <dt>總報酬、年化、最大回撤、夏普（與交易統計）</dt><dd>{{ aig('stats') }}</dd>
  </dl>
</section>

<p class="note">⚠️ 這一頁是一組規則的輸出與它的歷史表現，不是投資建議。回測期間短（籌碼資料只有一年、營收兩年多），
  而且大部分是多頭；任何一套在拿真錢之前，都應該先看影子帳戶至少三個月。</p>

<script type="application/json" id="ai-charts">{{ ai.charts|safe }}</script>
{% endif %}
{% endautoescape %}
{% endblock %}
