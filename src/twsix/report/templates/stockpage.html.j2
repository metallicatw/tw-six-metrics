  與公開資訊觀測站，都是開放資料、一次給整個市場——
  <code>twsix fetch-ownership</code> 三個請求就涵蓋 4,047 檔。官方只給最新一期，
  所以歷史是每週跑一次累積出來的；排程已經在跑，這一頁會自己長出來。
  想要更長的歷史，可以從 Goodinfo 另存那一頁再
  <code>twsix fetch-page {{ p.stock_id }} --import 檔案</code>，兩邊會合併。
</p>
<div class="scroll">
  <table>
    <thead><tr><th>頁面</th><th>還缺什麼</th></tr></thead>
    <tbody>
      {% for u in p.unbuilt %}
      <tr><th scope="row">{{ u.name }}</th><td class="reason">{{ u.why }}</td></tr>
      {% endfor %}
    </tbody>
  </table>
</div>
</section>
{% endif %}

<p class="muted">
  本頁為資料整理，非投資建議。估價模型的輸入與門檻見〈評分規則〉。
</p>

<script>
/* 分頁切換。
 *
 * 十個區塊一頁到底要捲很久，而它們彼此不需要對照著看——挑一個看完再挑下一個
 * 才是實際的讀法。用真的 button + role=tab，所以鍵盤與螢幕閱讀器照標準運作：
 * 方向鍵移動、Home/End 跳頭尾、Tab 只會進出整組而不是逐一穿過十個。
 *
 * 分頁狀態寫進網址的 hash，所以重新整理、加書籤、把連結傳給別人都會停在同一
 * 個分頁；也讓舊的 #river 錨點連結仍然有效。
 */
(function(){
  /* 只抓頁首那一排。〔財務健診〕裡面有自己的子分頁（也是 role=tab）——全頁抓的
     話它們會被當成主分頁：點〔成長力分析〕會把整頁每一個分頁都藏起來。 */
  var tabs=[].slice.call(document.querySelectorAll('.tabs [role=tab]'));
  if(!tabs.length) return;
  /* 切過去之後要停在那一頁的頁首。
     不捲的話，從第八個分頁切到第二個，畫面留在原來的捲動位置——那個位置在新的
     分頁裡是中段、是某張圖的一半、或是根本超過整頁的長度而彈回底部。切分頁的
     人要的是「從頭看這一頁」，每一次都是。

     捲到釘住的那三列底下，不是捲到 0：股名、季別、分頁列是 sticky 的，捲到頁面
     最頂端會讓標題正好被它們蓋住。 */
  var ident = document.querySelector('.ident.sticky');
  function toTop(){
    var y = 0;
    var wrap = document.querySelector('.wrap');
    if(wrap) y = wrap.offsetTop;
    if(ident) y = Math.max(0, ident.offsetTop);
    window.scrollTo({ top: y, behavior: 'auto' });
  }
  function show(id, push, scroll){
    tabs.forEach(function(t){
      var on = t.id === 'tab-'+id;
      t.setAttribute('aria-selected', on ? 'true':'false');
      t.tabIndex = on ? 0 : -1;
      var panel = document.getElementById(t.getAttribute('aria-controls'));
      if(panel) panel.hidden = !on;
    });
    if(push && history.replaceState) history.replaceState(null,'','#'+id);
    if(scroll) toTop();
  }
  tabs.forEach(function(t){
    t.addEventListener('click', function(){
      show(t.id.slice(4), true, true);
      t.focus();
    });
    t.addEventListener('keydown', function(e){
      var i=tabs.indexOf(t), n=tabs.length, j=null;
      if(e.key==='ArrowRight') j=(i+1)%n;
      else if(e.key==='ArrowLeft') j=(i+n-1)%n;
      else if(e.key==='Home') j=0;
      else if(e.key==='End') j=n-1;
      if(j===null) return;
      e.preventDefault();
      tabs[j].focus(); show(tabs[j].id.slice(4), true, true);
    });
  });
  var want=(location.hash||'').slice(1);
  if(want && document.getElementById('tab-'+want)) show(want, false, false);
})();
</script>
{% endblock %}
