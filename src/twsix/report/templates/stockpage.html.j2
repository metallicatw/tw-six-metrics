{% extends "base.html.j2" %}
{% from "_macros.html.j2" import tip %}
{% import "_macros.html.j2" as m %}
{% block title %}{{ p.stock_id }} {{ p.name }}｜{{ site_title }}{% endblock %}
{% block body %}

{# 三列一起釘住：股名、財報／營收／股價、分頁列。它們是讀每一個分頁時都要看的
   座標——一個數字是好是壞，要對照它是哪一季、股價多少才知道。捲到第八個分頁還
   要往回捲才能確認季別，等於每次都重讀一次。 #}
<div class="ident sticky">
{# ☆ 就在股名旁邊。清單上加得了、個股頁上加不了，是一個奇怪的不對稱——真正
     決定「要不要追蹤這一檔」的時刻，是讀完它那一頁的時候，不是掃清單的時候。
     亮暗與清單那一欄是同一份狀態（見 site.js 的 TWSIXWatch）。 #}
  <h2 id="top">{{ p.stock_id }}　{{ p.name }}
    {#- 市場與產業。小字、不搶眼，但就在股名旁邊——「2404 漢唐」說不出這是一家
        做什麼的公司，而判斷一個營益率是高是低，第一件要知道的事就是它跟誰比。
        原本要捲到〔評價簡表〕才看得到，那已經是最需要它的那一眼之後了。 -#}
    {%- if p.market %}<span class="chip mk">{{ p.market }}</span>{% endif -%}
    {%- if p.industry %}<span class="chip ind">{{ p.industry }}</span>{% endif -%}
    <button type="button" class="star" data-star="{{ p.stock_id }}"
          aria-pressed="false" aria-label="把 {{ p.stock_id }} 加入觀察清單"
          title="加入觀察清單">☆</button></h2>
  <p class="facts">
    <span>財報 <b>{{ p.fiscal_quarter or "—" }}</b></span>
    <span>營收 <b>{{ p.revenue_month or "—" }}</b></span>
    {%- if p.market_price %}<span>股價 <b>{{ "%.2f"|format(p.market_price) }}</b>
      {%- if p.price_date %}<i class="asof">{{ p.price_date }} 收盤</i>{% endif %}</span>{% endif %}
    {%- if p.latest_composite is not none %}
    <span>綜合 <b>{{ "%.2f"|format(p.latest_composite) }}</b></span>
    {%- endif %}
  </p>

<div class="tabs" role="tablist" aria-label="頁面區塊">
  <button type="button" role="tab" id="tab-summary" class="tab" aria-controls="panel-summary" aria-selected="true">評價簡表</button>
  <button type="button" role="tab" id="tab-six" class="tab" aria-controls="panel-six" aria-selected="false" tabindex="-1">六大財務指標評等</button>
  <button type="button" role="tab" id="tab-eps" class="tab" aria-controls="panel-eps" aria-selected="false" tabindex="-1">EPS預估與估價</button>
  {# 〔財務健診〕〔股價健診〕緊接在〔EPS預估與估價〕右邊（2026-09-23）：看完「值
     多少」，下一個問題是「體質有沒有正在出事」與「股價現在是強是弱」。 #}
  <button type="button" role="tab" id="tab-health" class="tab" aria-controls="panel-health" aria-selected="false" tabindex="-1">財務健診</button>
  <button type="button" role="tab" id="tab-pxhealth" class="tab" aria-controls="panel-pxhealth" aria-selected="false" tabindex="-1">股價健診</button>
  <button type="button" role="tab" id="tab-yield" class="tab" aria-controls="panel-yield" aria-selected="false" tabindex="-1">殖利率估價</button>
  <button type="button" role="tab" id="tab-river" class="tab" aria-controls="panel-river" aria-selected="false" tabindex="-1">河流圖</button>
  <button type="button" role="tab" id="tab-season" class="tab" aria-controls="panel-season" aria-selected="false" tabindex="-1">季節性</button>
  <button type="button" role="tab" id="tab-inst" class="tab" aria-controls="panel-inst" aria-selected="false" tabindex="-1">外資投信</button>
  {# 這兩張只有匯入過才有分頁——沒有資料的分頁點開是一句道歉，不是一頁。 #}
  {% if p.holders %}
  <button type="button" role="tab" id="tab-holders" class="tab" aria-controls="panel-holders" aria-selected="false" tabindex="-1">大戶持股</button>
  {% endif %}
  {% if p.directors %}
  <button type="button" role="tab" id="tab-directors" class="tab" aria-controls="panel-directors" aria-selected="false" tabindex="-1">董監持股</button>
  {% endif %}
  {# 〔個股新聞〕排在內容分頁的最後。它是唯一一個**每天都在變**的分頁，
     而前面那些是季報、週資料、月資料——讀者從左往右讀，是從「這家公司
     長什麼樣」讀到「最近發生什麼」。新聞插在〔外資投信〕和〔大戶持股〕
     中間的時候，等於把兩張講籌碼的表拆開了。 #}
  <button type="button" role="tab" id="tab-news" class="tab" aria-controls="panel-news" aria-selected="false" tabindex="-1">個股新聞</button>
  {# 〔AI 選股〕（2026-09-24）：這一檔在六套方案裡的樣子。內容**不在這一頁裡**——點開
     時才去抓 ai/stock/<代號>.json（見 report/ai_page.py 的 write_stock_json）。AI
     的資料每天都在變，放進頁面的話，1,900 張個股頁每天都要重畫。 #}
  <button type="button" role="tab" id="tab-ai" class="tab" aria-controls="panel-ai" aria-selected="false" tabindex="-1">AI 選股</button>
  {% if p.unbuilt %}
  <button type="button" role="tab" id="tab-unbuilt" class="tab" aria-controls="panel-unbuilt" aria-selected="false" tabindex="-1">尚未建置</button>
  {% endif %}
</div>
</div>

{# 已下市：這一頁還在，因為評等沒有錯——錯的只是把它排進「今天的市場」。所以
   〔評等清單〕上看不到它，搜尋仍然找得到，而這一句負責在讀者往下讀之前先說。 #}
{% if delisted %}
<p class="stale">已下市——這一檔已不在證交所／櫃買的公司名單上，以下數字停在下市前那一期，不會再更新。</p>
{% endif %}

{% if p.excluded %}
<p class="stale">{{ p.excluded }}——這一檔不適用六大指標。</p>
{% endif %}

{% if p.history and p.history.c %}
{# 每日收盤：〔股價健診〕與〔推估三年目標價〕的圖共用。壓縮格式見 report/health.py
   的 encode_history，還原見 site.js 的 pxDecode。 #}
<script type="application/json" id="px-hist">{{ p.history|tojson }}</script>
{% endif %}
<section class="panel" id="panel-summary" role="tabpanel" aria-labelledby="tab-summary">
<h3 id="summary">評價簡表</h3>

<div class="cards">
  <div class="card">
    <b>{{ "%.2f"|format(p.latest_composite) if p.latest_composite is not none else "—" }}</b>
    <span>最新綜合評分</span>
  </div>
  {# 市價要帶日期。整頁的估值——目標價、下檔價、報酬風險比——都是拿這個數字算的，
     而一個沒有日期的股價，在一張存起來三個月後再打開的網頁上，看起來永遠像今天的。 #}
  {%- set chg = p.price_change %}
  {%- set dir = ('up' if chg > 0 else ('down' if chg < 0 else '')) if chg is not none else '' %}
  <div class="card">
    <b class="{{ dir }}">{{ "%.2f"|format(p.market_price) if p.market_price else "—" }}</b>
    {%- if chg is not none %}
    {# 數字不帶正負號——方向由三角形表示。台股慣例：漲紅、跌綠。 #}
    <span class="chg {{ dir }}">{{ '▲' if chg > 0 else ('▼' if chg < 0 else '') }}
      {{- ' ' if chg != 0 }}{{ "%.2f"|format(chg|abs) }}
      {%- if p.price_change_pct is not none %} ({{ "%.2f"|format(p.price_change_pct|abs) }}%){% endif %}</span>
    {%- endif %}
    <span>市價{% if p.price_date %}　<i class="asof">{{ p.price_date }} 收盤</i>{% endif %}</span>
  </div>
  <div class="card">
    <b>{{ p.pe.reward_risk if p.pe else "—" }}</b>
    <span>報酬風險比{% if p.pe %}　{{ p.pe.verdict }}{% endif %}</span>
  </div>
  <div class="card">
    <b>{{ p.dividend.verdict if p.dividend else "—" }}</b>
    <span>殖利率估價判斷</span>
  </div>
</div>

<p class="{{ 'verdict-yes' if p.worth_researching else 'verdict-no' }}">
  {% if p.worth_researching %}
    綜合評分 {{ "%.2f"|format(p.latest_composite) }} ≥ 3，依〔操作說明〕的建議<b>值得進一步研究</b>。
  {% else %}
    〔操作說明〕建議綜合評價 3 分以上才有研究必要；本檔最新綜合評分
    {{ "%.2f"|format(p.latest_composite) if p.latest_composite is not none else "不足以計算" }}。
  {% endif %}
</p>

<div class="scroll">
  <table>
    <thead>
      <tr>
        <th>期別</th><th>財報季度</th><th>營收月份</th>
        {% for label in indicator_labels %}<th>{{ label }}</th>{% endfor %}
        <th class="num">綜合</th><th>價值</th>
      </tr>
    </thead>
    <tbody>
      {% for row in p.periods %}
      <tr>
        <td>{{ row.index }}</td>
        <td>{{ row.quarter }}</td>
        <td>{{ row.month }}</td>
        {% for key in indicator_keys %}
        <td>
          {%- if row.grades[key].badge -%}
            <span class="g g-{{ row.grades[key].text }}">{{ row.grades[key].text }}</span>
          {%- else -%}
            <span class="muted">{{ row.grades[key].text }}</span>
          {%- endif -%}
        </td>
        {% endfor %}
        <td class="num" title="{{ row.composite }}">{{ row.composite_short }}</td>
        <td>{% if row.value_pick %}<span class="pick">★</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<details class="sources">
  <summary>資料來源（{{ p.sources|selectattr("ok")|list|length }}/{{ p.sources|length }}）</summary>
  <ul class="srclist">
    {% for s in p.sources %}
    <li class="{{ 'ok' if s.ok else 'missing' }}">{{ s.sheet }}{% if not s.ok %}　未取得{% endif %}</li>
    {% endfor %}
  </ul>
</details>

{# ================= 2. 六大財務指標評等 ================= #}
</section>

<section class="panel" id="panel-six" role="tabpanel" aria-labelledby="tab-six" hidden>
<h3 id="six">六大財務指標評等</h3>
<p class="muted">最新一期（{{ p.fiscal_quarter }} / {{ p.revenue_month }}）各指標的數列與評分理由。</p>

<div class="scroll">
  <table>
    <thead>
      {# 八期各佔一欄，所以表頭那一格要橫跨八欄。colspan 寫死 8 是對的：
         `_eight_periods` 的 TABLE_PERIODS 就是 8，而下面補空欄那一段也是照 8 補。 #}
      <tr><th>指標</th><th>評等</th><th class="num">評分</th>
        <th class="num" colspan="8">近八期數列（最新在左）</th><th>理由</th></tr>
    </thead>
    <tbody>
      {% for ind in p.indicators %}
      <tr{% if not ind.scored %} class="unscored"{% endif %}>
        {# 〔業外佔比〕的判讀尺度掛在它自己那一列的名字旁邊，不是另開一段說明。
           一個沒有尺度的百分比，讀者只能猜 15% 算多還是算少；而那把尺是查一次
           就記得的東西，攤在頁面上每天佔一塊版面不划算。燈泡兩邊都顧到。 #}
        <th scope="row">{{ ind.label }}{% if ind.key == "non_operating_ratio" %}{% call tip() %}<b>業外收益佔稅前利潤比例（%）＝ 業外損益 ÷ 稅前淨利 × 100%</b><br>
          比例 &lt; 10%：本業主導，盈餘品質較高<br>
          比例在 10~30%：有一定業外貢獻，需追蹤原因<br>
          比例 &gt; 30%：警戒，業外收益主導，需深入調查是否一次性<br>
          比例 &gt; 100%（即本業虧損但業外盈餘）：高度警戒，本業健康度存疑<br><br>
          這個數字<b>有號</b>。上面那把尺假設稅前淨利是正的；稅前淨利為負（本業加業外仍然虧）的時候比例會翻成負數，那把尺就不適用——那一季要直接看營業利益與業外損益兩個絕對值，不是看比例。{% endcall %}{% endif %}</th>
        <td>
          {%- if ind.badge -%}
            <span class="g g-{{ ind.letter }}">{{ ind.letter }}</span>
          {%- else -%}
            <span class="muted">{{ ind.letter or "—" }}</span>
          {%- endif -%}
        </td>
        <td class="num">{{ ind.display }}</td>
        {# 八期＝八個**真的**表格欄，不是一個 td 裡面的 grid。

           以前是 grid：`repeat(var(--n),max-content)`，每一列各自照自己的內容
           算欄寬。同一列裡期別與數值對得齊，但**列與列之間對不齊**——而那正是
           讀者在做的事：拿〔自由現金流量〕的 115Q2 去對上面〔EPS〕的 115Q2。
           自由現金流量是六位數的百萬，上面幾列是兩位數的百分比，於是它那一列
           的八欄整排往左歪，愈往左歪得愈多。

           改成真的欄位之後對齊是**表格自己保證的**，不靠任何寬度數字：同一個
           表格欄裡的每一格本來就一樣寬。期別仍然放在數值上面，因為八個裸數字
           沒有期別讀不出來——營收年增率數的是月，其他六項數的是季。 #}
        {% for v in ind["values"] %}
        <td class="pv">
          <span class="p">{{ ind["periods"][loop.index0] if loop.index0 < ind["periods"]|length else "" }}</span>
          <span class="v">{{ "%.2f"|format(v) if v is not none else "—" }}</span>
        </td>
        {% endfor %}
        {# 補足欄數：某一列只有六期的時候，不補的話它後面兩欄會由 rowspan 之外
           的東西遞補，整張表錯位。 #}
        {% for _ in range(8 - ind["values"]|length) %}<td class="pv"></td>{% endfor %}
        <td class="reason">{{ ind.reason }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p class="foot">註：淨利率（歸母）與業外佔比都不列入評分。淨利率（歸母）＝ 歸屬母公司稅後淨利 ÷ 營收。</p>


{# 三條線一張圖，放在逐項拆開之前：讀者要先看得到「賺的錢有沒有變好賺」，
   再往下看是哪一項把它拉上去或壓下來。 #}
{% if p.figures.eight_quarters %}{{ p.figures.eight_quarters|safe }}{% endif %}

{# 月營收本身不是六大指標之一（評分看的是年增率），但它是那條年增率的分母。
   原本擺在整段的最後，而那個位置等於說「看完六張圖再回頭看分母」——分母要先
   看到，後面那六張才知道自己在跟什麼比。 #}
{% if p.figures.revenue %}{{ p.figures.revenue|safe }}{% endif %}

{# 月營收明細：收起來，就在〔三年營收趨勢〕正下方。

   收起來是因為它有三十六列六欄——攤開等於在圖與下一段之間插進一個螢幕高的
   數字牆，而多數時候讀者要的是圖。它仍然在這裡、而且是**唯一**那張表：這張圖
   原本自帶的「數值」收合表只有月營收與年增率兩欄，是這六欄的子集，已經關掉
   （`charts.combo(..., table=False)`）。

   用 `chart-data` 這個 class 而不是自訂一個：站上每一張圖底下的數值表都長這樣，
   而這張就是那張圖的數值表。 #}
{% if p.revenue_rows %}
<details class="chart-data"><summary>數值</summary>
<div class="scroll">
  <table class="rev">
    <thead>
      <tr>
        <th>月份</th><th class="num">當月營收<span class="u">百萬</span></th>
        <th class="num">月增率</th><th class="num">年增率</th>
        <th class="num">累計營收<span class="u">百萬</span></th><th class="num">累計年增率</th>
      </tr>
    </thead>
    <tbody>
      {% for r in p.revenue_rows %}
      <tr>
        <th scope="row">{{ r.month }}</th>
        <td class="num">{{ '{:,.0f}'.format(r.revenue) if r.revenue is not none else '—' }}</td>
        <td class="num">{{ m.delta(r.mom) }}{% if r.mom is not none %}%{% endif %}</td>
        <td class="num">{{ m.delta(r.yoy) }}{% if r.yoy is not none %}%{% endif %}</td>
        <td class="num">{{ '{:,.0f}'.format(r.cumulative) if r.cumulative is not none else '—' }}</td>
        <td class="num">{{ m.delta(r.cumulative_yoy) }}{% if r.cumulative_yoy is not none %}%{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
</details>
{% endif %}

{# 每個指標的圖就接在它自己的評等後面。
   把六張圖另開一個分頁，等於要讀者記住「B 是哪一項」再切過去對——而那正是圖表
   要省掉的動作。表格用來掃，圖用來看走勢，兩者講的是同一條數列。 #}
{% for ind in p.indicators %}
{% if p.statements[ind.key] %}
<section class="metric">
  <h4>
    {%- if ind.badge -%}<span class="g g-{{ ind.letter }}">{{ ind.letter }}</span>
    {%- else -%}<span class="g g-na">{{ ind.letter or "—" }}</span>{%- endif -%}
    <span class="nm">{{ ind.label }}</span>
    <span class="why">{{ ind.reason }}</span>
  </h4>
  {{ p.statements[ind.key]|safe }}
</section>
{% endif %}
{% endfor %}

{# ================= 3. EPS預估與估價 ================= #}
</section>

<section class="panel" id="panel-eps" role="tabpanel" aria-labelledby="tab-eps" hidden>
<h3 id="eps">EPS預估與估價</h3>

{% if p.gaps.forecast or p.gaps.pe %}
<p class="stale">{{ p.gaps.forecast or p.gaps.pe }}——此區塊無法計算。</p>
{% endif %}

{# 這一頁上下其實是兩件事，而它們原本只用一條空白隔開：上半是「引擎依活頁簿的
   規則算出的一個答案」，下半是「你自己的假設會得到什麼答案」。兩者的數字長得
   一模一樣，可信度卻完全不同——所以要用標題和色塊明白地分開，而不是靠讀者
   自己從上下文推。 #}
<section class="way way1">
<h4 class="way-h"><span class="n">估值方式一</span>依規則自動估算
  <span class="sub">參數在 config/settings.toml，本檔實際代入的數字見下方說明</span></h4>

{% if p.methodology %}
{% set mo = p.methodology %}
<details class="methodology">
  <summary>計算方式說明——公式與本檔實際代入的數字</summary>
  <ol class="steps">
    <li>
      <b>預估成長率</b>　{{ mo.growth_method_label }}
      <div class="formula">{{ mo.growth_method_formula }}</div>
      <div class="plug">本檔代入結果：<b>{{ mo.growth_rate }}</b></div>
    </li>
    <li>
      <b>預估營收</b>　去年全年營收 ÷ 1000 ×（1 ＋ 預估成長率）
      <div class="plug">
        {{ mo.last_year_revenue }} × (1 + {{ mo.growth_rate }}) ＝
        <b>{{ mo.projected_revenue }}</b>　百萬元
      </div>
    </li>
    <li>
      <b>稅後淨利率</b>　{{ mo.margin_method_label }}
      <div class="formula">{{ mo.margin_method_formula }}</div>
      <div class="plug">本檔代入結果：<b>{{ mo.net_margin }}</b></div>
    </li>
    <li>
      <b>預估淨利</b>　預估營收 × 稅後淨利率
      <div class="plug">{{ mo.projected_revenue }} × {{ mo.net_margin }} ＝ <b>{{ mo.projected_income }}</b>　百萬元</div>
    </li>
    <li>
      <b>預估 EPS</b>　預估淨利 ÷ 加權平均股數
      <div class="plug">{{ mo.projected_income }} ÷ {{ mo.weighted_shares }} ＝ <b>{{ mo.forecast_eps }}</b>　元</div>
    </li>
    <li>
      <b>本益比區間</b>　{{ mo.pe_basis_label }}
      <div class="formula">{{ mo.pe_basis_formula }}</div>
      <div class="plug">本檔代入結果：<b>{{ mo.band_low }} – {{ mo.band_high }}</b></div>
    </li>
    <li>
      <b>目標價 / 下檔價</b>　本益比高點 × 預估EPS　／　本益比低點 × 預估EPS
      <div class="plug">
        {{ mo.band_high }} × {{ mo.forecast_eps }} ＝ <b>{{ mo.target_price }}</b>　／
        {{ mo.band_low }} × {{ mo.forecast_eps }} ＝ <b>{{ mo.downside_price }}</b>
      </div>
    </li>
  </ol>
  <p class="note">
    以上為本次建置採用的參數（{{ mo.growth_method_label }} ／ {{ mo.margin_method_label }} ／
    {{ mo.pe_basis_label }}），可在 config/settings.toml 調整；下方「目標價試算盤」可暫時
    覆寫這些假設重新試算，不影響此處記錄的引擎結果。
  </p>
</details>
{% endif %}

{% if p.forecast %}
<div class="val">
  <section>
    <h4>預估 EPS</h4>
    <dl>
      <dt>營收月份</dt><dd>{{ p.forecast.revenue_month }}</dd>
      <dt>預估成長率</dt><dd>{{ p.forecast.growth_rate }}</dd>
      <dt>預估營收</dt><dd>{{ p.forecast.projected_revenue }}</dd>
      <dt>稅後淨利率</dt><dd>{{ p.forecast.net_margin }}</dd>
      <dt>預估淨利</dt><dd>{{ p.forecast.projected_income }}</dd>
      <dt>加權平均股數</dt><dd>{{ p.forecast.weighted_shares }}</dd>
      <dt>預估 EPS</dt><dd class="big">{{ p.forecast.eps }}</dd>
      <dt>近四季 EPS</dt><dd>{{ p.forecast.trailing_eps }}</dd>
    </dl>
  </section>
  {% if p.pe %}
  <section>
    <h4>本益比估價</h4>
    <dl>
      <dt>本益比區間</dt><dd>{{ p.pe.band_low }} – {{ p.pe.band_high }}</dd>
      <dt>目標價</dt><dd class="big">{{ p.pe.target }}</dd>
      <dt>下檔價</dt><dd>{{ p.pe.downside }}</dd>
      <dt>預期報酬</dt><dd>{{ p.pe.expected_return }}</dd>
      <dt>預期風險</dt><dd>{{ p.pe.expected_risk }}</dd>
      <dt>報酬風險比</dt><dd class="big">{{ p.pe.reward_risk }}</dd>
    </dl>
  </section>
  {% endif %}
  {% if p.growth %}
  <section>
    <h4>成長模型</h4>
    <dl>
      <dt>預估本益比</dt><dd>{{ p.growth.forward_pe }}</dd>
      <dt>EPS 成長率</dt><dd>{{ p.growth.eps_growth }}</dd>
      <dt>PEG</dt><dd>{{ p.growth.peg }}</dd>
      <dt>總報酬本益比</dt><dd>{{ p.growth.total_return }}</dd>
    </dl>
  </section>
  {% endif %}
</div>
{% endif %}

{# 成長模型原本只有四個裸數字，沒有一個字說它在做什麼——而它問的問題和上面那
   兩塊不一樣：本益比估價問「歷史上市場願意給幾倍」，成長模型問「這個成長速度
   值幾倍」。兩個答案不一致，正是它存在的用處。 #}
{% if p.growth %}
<details class="growth-note">
  <summary>成長模型在算什麼</summary>
  <p>
    上面兩塊都從「市場過去給這一檔幾倍本益比」出發。成長模型換一個問法：
    <b>以這個成長速度，這一檔值幾倍本益比</b>——完全不看歷史股價。
    兩邊的答案不一致時，那個差距本身就是資訊。
  </p>
  <dl class="terms">
    <dt>預估本益比</dt>
    <dd>市價 ÷ 預估 EPS。用的是預估 EPS 而不是近四季 EPS，所以它是「以今天的價格
        買進、用明年的獲利計算」的倍數。</dd>
    <dt>EPS 成長率</dt>
    <dd>(預估 EPS − 近四季 EPS) ÷ ｜近四季 EPS｜。負的代表預估比現在差，
        此時 PEG 與總報酬本益比都不給值——把負成長代進去會得到負的目標價，
        那不是便宜，是模型跑到定義域外面。</dd>
    <dt>PEG</dt>
    <dd>預估本益比 ÷（EPS 成長率 × 100）。<b>1 是分水嶺</b>：小於 1 表示付出的
        倍數低於成長速度，大於 1 表示付得比成長快。</dd>
    <dt>總報酬本益比</dt>
    <dd>(EPS 成長率 ＋ 平均殖利率) ÷ 預估本益比 × 100。PEG 只看成長，
        對配息穩定但成長慢的公司不公平；把殖利率加進分子就補上這一塊。
        <b>越大越好</b>，方向和 PEG 相反。</dd>
  </dl>
  {% if p.growth.peg_prices or p.growth.total_return_prices %}
  <p class="muted">活頁簿把這兩個模型各換算成四檔目標價（成長率的 66% / 75% /
    100% / 120%），保守到樂觀：</p>
  <div class="scroll"><table class="mini">
    <thead><tr><th>模型</th><th class="num">66%</th><th class="num">75%</th>
      <th class="num">100%</th><th class="num">120%</th></tr></thead>
    <tbody>
      {% if p.growth.peg_prices %}
      <tr><td>PEG 估價</td>
        {% for lvl in (66, 75, 100, 120) %}
        <td class="num">{{ p.growth.peg_prices.get(lvl) or '—' }}</td>
        {% endfor %}
      </tr>
      {% endif %}
      {% if p.growth.total_return_prices %}
      <tr><td>總報酬估價</td>
        {% for lvl in (66, 75, 100, 120) %}
        <td class="num">{{ p.growth.total_return_prices.get(lvl) or '—' }}</td>
        {% endfor %}
      </tr>
      {% endif %}
    </tbody>
  </table></div>
  {% endif %}
  <p class="muted">
    出處：〔EPS預估與估價〕AA:AD 欄與 X1:AC2。<b>活頁簿只給了公式和欄名，沒有
    寫下文字說明</b>——上面這幾段是依那些公式寫的解讀，不是活頁簿的原話。
    公式本身則是逐格對照過的。
  </p>
</details>
{% endif %}

{# 說明欄。預設收合——每天看的人不需要每天讀一次公式，但第一次看到「目標價
   392.82」的人一定會想問這個數字憑什麼。收合的 <details> 讓兩種人各取所需，
   而且它在頁面裡、不在 README 裡：出處要跟數字待在同一個畫面才有用。 #}
{% if forecast_basis %}
<details class="basis">
  <summary>各欄的計算依據<span class="muted">　公式與活頁簿出處，逐欄對照</span></summary>
  <div class="scroll"><table class="basis-t">
    <thead><tr><th>欄位</th><th>公式</th><th>活頁簿出處</th></tr></thead>
    <tbody>
      {% for field, formula, source in forecast_basis %}
      <tr><td class="f">{{ field }}</td><td class="q">{{ formula }}</td>
          <td class="muted">{{ source }}</td></tr>
      {% endfor %}
    </tbody>
  </table></div>
  <ul class="warnings">
    {% for note in forecast_basis_notes %}<li>{{ note }}</li>{% endfor %}
  </ul>
</details>
{% endif %}

{% if p.figures.pe_band %}{{ p.figures.pe_band|safe }}{% endif %}
</section>

{% if p.calc and p.calc.revenue and p.calc.shares %}
{# ================= 估值方式二：目標價試算盤 =================
   上面那一區是「引擎依規則算出來的一個答案」。這一區是「你自己的假設會得到什麼
   答案」——同一條公式，參數交給讀者。

   預設值不是憑空填的，每一個都說得出出處（見下方說明），而且和坊間工具對得起來。
   打開的時候看到的是這一檔的事實，改動之後看到的是你的假設。 #}
<section class="way way2">
<h4 class="way-h"><span class="n">估值方式二</span>自訂假設試算
  <span class="sub">同一條公式，參數由你決定；改動不影響上面記錄的引擎結果</span></h4>
<section class="calc" id="calc" data-code="{{ p.stock_id }}"
         data-seed='{{ p.calc|tojson }}' data-price="{{ p.market_price or '' }}"
         data-price-date="{{ p.price_date }}">
  <h4>目標價試算盤<span class="muted">　改任何一格，下面的矩陣立刻重算</span></h4>

  <p class="note" id="calc-basis"></p>

  {% if p.calc.years %}
  <div class="scroll"><table class="mini">
    <thead><tr><th>項目</th>{% for y in p.calc.years %}<th class="num">{{ y.year }}</th>{% endfor %}</tr></thead>
    <tbody>
      {% for label, key, digits in (('股價高點','high',1),('股價低點','low',2),('EPS','eps',2),('本益比高','pe_high',1),('本益比低','pe_low',1)) %}
      <tr><td>{{ label }}</td>
        {% for y in p.calc.years %}
        <td class="num">{{ ('%.' ~ digits ~ 'f')|format(y[key]) if y[key] is not none else '—' }}</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table></div>
  {% endif %}

  {# 提示字串和欄名同一列。放在下一列的話，有提示的三欄比沒提示的兩欄高一行，
     五個輸入框的上緣就對不齊——而那條參差是整個區塊裡最先被看到的東西。 #}
  <div class="calc-inputs">
    <label><span class="lab"><span class="t">年營收（百萬元）</span></span>
      <input type="number" id="c-rev" step="any"></label>
    <label><span class="lab"><span class="t">股數（億股）</span></span>
      <input type="number" id="c-sh" step="any"></label>
    <label><span class="lab"><span class="t">預估營收成長率（%）</span>
      <span class="hint">悲觀,中性,樂觀</span></span>
      <input type="text" id="c-g" inputmode="decimal"></label>
    <label><span class="lab"><span class="t">預估淨利率（%）</span>
      <span class="hint">悲觀,中性,樂觀</span></span>
      <input type="text" id="c-m" inputmode="decimal"></label>
    <label><span class="lab"><span class="t">預估本益比 PE</span>
      <span class="hint">一個 PE 一張矩陣</span></span>
      <input type="text" id="c-pe" inputmode="decimal"></label>
  </div>
  <p class="calc-formula">
    預估 EPS ＝ 年營收 × (1 ＋ 營收成長率) × 淨利率 ÷ 股數　│　
    預估目標價 ＝ 預估 EPS × 預估本益比
  </p>
  {# 〔進場成本價位〕：矩陣每一格第二行的「預期報酬／預期風險」拿誰當基準。
     預設是現價（最近一個交易日的收盤）；已經買了的人要看的是**相對自己的
     成本**還有多少空間、會賠多少，那是另一個基準。留空＝用現價。
     填過的數字記在這台瀏覽器裡（每一檔各記一個），〔回到現價〕清掉它。 #}
  <div class="calc-cost">
    <label for="c-cost">進場成本價位（元）</label>
    <input type="number" id="c-cost" step="any" min="0" inputmode="decimal"
           placeholder="{{ '%.2f'|format(p.market_price) if p.market_price else '' }}">
    <button type="button" class="linkish" id="c-cost-reset" hidden>回到現價</button>
    <span class="muted" id="c-cost-note"></span>
  </div>
  <button type="button" class="btn-grab" id="c-run">重新計算</button>
  <button type="button" class="linkish" id="c-reset">還原預設值</button>

  <div id="calc-out"></div>
</section>
</section>
{% endif %}

{% if p.three_year %}
{# ================= 推估三年目標價 =================
   〔估值方式二〕只推一年；這一區逐年累乘三年：今年營收 ＝ 去年全年 ×（1＋今年
   成長率），明年 ＝ 今年 ×（1＋明年成長率）……每一年的 EPS ＝ 該年營收 × 該年
   淨利率 ÷ 股數，目標價 ＝ EPS × 本益比。三張圖把三年的目標價畫在股價走勢上。
   全部在瀏覽器裡算（site.js 的 threeYear）。 #}
<section class="way way3" id="y3" data-code="{{ p.stock_id }}" data-seed='{{ p.three_year|tojson }}'>
<h4 class="way-h"><span class="n">推估三年目標價</span>逐年累乘三年
  <span class="sub">年營收基準採 {{ p.three_year.base_year }} 全年；成長率、淨利率預設為最近一季（{{ p.three_year.basis.quarter }}）的數字，三年相同——請務必自行調整</span></h4>
  <div class="calc-inputs y3-in">
    <label><span class="lab"><span class="t">年營收（百萬，可改）</span></span>
      <input type="number" id="y3-rev" step="any"></label>
    <label><span class="lab"><span class="t">股數（億股，可改）</span></span>
      <input type="number" id="y3-sh" step="any"></label>
  </div>
  <div class="y3-rows">
    <label>【預估未來三年營收成長率（%）】今年, 明年, 後年
      <input type="text" id="y3-g" inputmode="decimal"></label>
    <label>【預估未來三年淨利率（歸母）（%）】今年, 明年, 後年
      <input type="text" id="y3-m" inputmode="decimal"></label>
    <label>【預估本益比 PE】每個 PE 一列目標價
      <input type="text" id="y3-pe" inputmode="decimal"></label>
  </div>
  <button type="button" class="btn-grab" id="y3-run">📊 計算三年〔預估EPS〕與〔預估目標價〕</button>
  <button type="button" class="linkish" id="y3-reset">還原預設值</button>
  <p class="calc-formula">逐年累乘：今年營收 ＝ 年營收 ×（1＋今年成長率），明年 ＝ 今年 ×（1＋明年成長率），後年同理；
    該年 EPS ＝ 該年營收 × 該年淨利率 ÷ 股數　│　目標價 ＝ 該年 EPS × 預估本益比</p>
  <div id="y3-out"></div>
</section>
{% endif %}

{# 兩種估價法都以「報酬風險比」收尾，所以這一段留在底部，兩邊共用。 #}
<div class="criteria">
  <h4>報酬風險比判斷準則<span class="muted">　總大EPS、PER 動態調整推估法</span></h4>
  <ol>
    {% for range_text, label, why in reward_risk_rules %}
    <li class="{{ 'hit' if p.pe and p.pe.verdict == label else '' }}">
      <b>{{ range_text }}</b>　{{ why }}
      {%- if p.pe and p.pe.verdict == label %}　<span class="tag">本檔 {{ p.pe.reward_risk }}</span>{% endif %}
    </li>
    {% endfor %}
  </ol>
  <ul class="warnings">
    {% for note in reward_risk_notes %}<li>{{ note }}</li>{% endfor %}
  </ul>
</div>

{# ================= 4. 殖利率估價 ================= #}
</section>

{# ================= 財務健診 =================
   兩個子分頁：財務地雷（七個機械式檢查）、成長力分析（QoQ／YoY）。
   數字全部在建站時算好（report/health.py），這裡只負責排版。 #}
<section class="panel" id="panel-health" role="tabpanel" aria-labelledby="tab-health" hidden>
<div class="hl">
  <div class="hl-head">
    <b>{{ p.stock_id }} {{ p.name }}</b>
    {% if p.health.quarter %}<span>財報:<b>{{ p.health.quarter }}</b></span>{% endif %}
    {% if p.revenue_month %}<span>營收:<b>{{ p.revenue_month }}</b></span>{% endif %}
    {% if p.health.rows %}
    <span class="hl-badge hl-{{ p.health.level_class }}">{{ p.health.level }}　{{ p.health.hits }}/{{ p.health.total }} 項地雷</span>
    {% endif %}
  </div>
  <div class="subtabs" role="tablist" aria-label="財務健診">
    <button type="button" role="tab" class="subtab" data-sub="hl-mines" aria-selected="true">財務地雷</button>
    <button type="button" role="tab" class="subtab" data-sub="hl-growth" aria-selected="false">成長力分析</button>
  </div>
  <div class="subpanel" id="hl-mines" role="tabpanel">
  {% if p.health.rows %}
    <div class="scroll"><table class="hl-t">
      <thead><tr><th>財務地雷指標</th><th class="st">狀態</th><th>說明</th></tr></thead>
      <tbody>
      {% for r in p.health.rows %}
        <tr><td>{{ r.label }}</td>
          <td class="st">{% if r.hit is none %}<span class="hl-na">— 不適用</span>{% elif r.hit %}<span class="hl-hit">⚠️ 命中</span>{% else %}<span class="hl-ok">✅ 正常</span>{% endif %}</td>
          <td>{{ r.text }}</td></tr>
      {% endfor %}
      </tbody>
    </table></div>
    <p class="note-s">註：命中越多代表財務體質越需留意（0 項＝健康、1～2 項＝留意、3 項以上＝高風險）；
      本健診僅為機械式指標篩檢，非投資建議。</p>
  {% else %}
    <p class="stale">這一檔還沒有季報資料，無法健診。</p>
  {% endif %}
  </div>
  <div class="subpanel" id="hl-growth" role="tabpanel" hidden>
  {% if p.growth_q.rows %}
    <p class="hl-sub">最近一季 <b>{{ p.growth_q.quarter }}</b>　｜　QoQ＝對上一季 {{ p.growth_q.prev }}　｜　YoY＝對去年同季 {{ p.growth_q.ly }}</p>
    <div class="scroll"><table class="hl-t hl-g">
      <thead><tr><th>項目</th><th class="num">最近一季</th><th class="num">QoQ</th><th class="num">YoY</th></tr></thead>
      <tbody>
      {% for r in p.growth_q.rows %}
        <tr><td>{{ r.label }}</td>
          <td class="num">{% if r.value is none %}—{% elif r.fmt == 'money' %}{{ '{:,.0f}'.format(r.value) }}{% elif r.fmt == 'pct' %}{{ '%.2f'|format(r.value) }}%{% else %}{{ '%.2f'|format(r.value) }}{% endif %}</td>
          {% for v in (r.qoq, r.yoy) %}
          <td class="num">{% if v is none %}<span class="muted">—</span>{% else %}<span class="{{ 'up' if v > 0 else ('down' if v < 0 else 'flat') }}">{{ '▲' if v > 0 else ('▼' if v < 0 else '') }} {{ '%+.2f'|format(v) if r.unit == 'pp' else '%+.1f'|format(v) }}{{ ' pp' if r.unit == 'pp' else '%' }}</span>{% endif %}</td>
          {% endfor %}
        </tr>
      {% endfor %}
      </tbody>
    </table></div>
    <p class="note-s">利益率／淨利率以百分點（pp）變化表示，營收／EPS 以百分比變化表示；<span class="up">紅 ▲ 成長</span>、<span class="down">綠 ▼ 衰退</span>（台股慣例）。
      EPS 為負時變化率的分母取絕對值（−0.45 → −0.08 是改善）。<br>
      註：淨利率（歸母）＝ 歸屬母公司稅後淨利 ÷ 營收；營收成長率優先用三個月的月營收加總計算。</p>
  {% else %}
    <p class="stale">這一檔還沒有季報資料。</p>
  {% endif %}
  </div>
</div>
</section>

{# ================= 股價健診 =================
   全部在瀏覽器裡算（site.js 的 pxHealth）：條件是讀者可以改的，改一次就要重算
   六條均線與幾百天的評分，建站時算好只能給一組預設值。
   資料是嵌在下面那段 JSON 裡的每日收盤（最多 760 個交易日）。 #}
<section class="panel" id="panel-pxhealth" role="tabpanel" aria-labelledby="tab-pxhealth" hidden>
{% if p.history and p.history.c %}
<div class="pxh" id="pxh">
  <div class="pxh-form">
    <label>條件一：股價在 <input type="number" id="pxh-m1" min="1" max="12" step="1" value="3"> 月內從高檔下跌幅度超過 <input type="number" id="pxh-p1" min="1" max="90" step="1" value="20"> %</label>
    <label>條件二：股價在 <input type="number" id="pxh-m2" min="1" max="12" step="1" value="3"> 月內從低檔上漲幅度超過 <input type="number" id="pxh-p2" min="1" max="300" step="1" value="20"> %</label>
    <label>條件三：股價跌破前 <input type="number" id="pxh-d3" min="5" max="240" step="1" value="60"> 個交易日低點</label>
    <div class="pxh-btns">
      <button type="button" class="btn-grab" id="pxh-run">重新健診</button>
      <button type="button" class="btn-grab alt" id="pxh-short">短期預設值</button>
      <button type="button" class="btn-grab alt" id="pxh-mid">中期預設值</button>
    </div>
    <p class="note-s">短期 ＝ 1 月內 10%／1 月內 10%／前 20 日低點；中期 ＝ 3 月內 20%／3 月內 20%／前 60 日低點。按下即帶入條件並重新健診。
      一個月以 21 個交易日計。本頁股價皆使用「收盤價」計算（含高低點、回檔幅度與月線／季線／年線），<b>未還原除權息</b>。</p>
  </div>
  <div id="pxh-out"></div>
  <h4 class="pxh-h">股價與月／季／年線</h4>
  <div class="pxc" id="pxh-c1"></div>
  <h4 class="pxh-h">股價健診總評分（每日各項檢查「正常」的數目，越高越健康）</h4>
  <div class="pxc" id="pxh-c2"></div>
  <div class="pxh-zoom">
    <span>縮放區間：</span>
    <button type="button" data-zoom="21">近1月</button><button type="button" data-zoom="63">近3月</button><button type="button" data-zoom="126">近半年</button><button type="button" data-zoom="252">近1年</button><button type="button" data-zoom="0" class="on">全部</button>
  </div>
  <div class="pxh-range"><input type="range" id="pxh-r0" min="0" value="0" aria-label="區間起點"><input type="range" id="pxh-r1" min="0" value="0" aria-label="區間終點"></div>
  <p class="note-s" id="pxh-span"></p>
</div>
{% else %}
<p class="stale">這一檔還沒有每日收盤資料，無法做股價健診。</p>
{% endif %}
</section>

