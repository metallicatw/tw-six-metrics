        <td class="num">{{ "{:,.0f}".format(row.total) if row.total else "" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p class="muted">單位仟元。標 * 的年度尚未完整，不列入比重平均。</p>
{% else %}
<p class="stale">沒有月營收資料。</p>
{% endif %}

{% if p.profit_season %}
{% if p.profit_season.figure %}{{ p.profit_season.figure|safe }}{% endif %}
<div class="scroll">
  <table>
    <thead><tr><th>年度</th>
      {% for c in p.profit_season.columns %}<th class="num">Q{{ c }}</th>{% endfor %}
      <th class="num">全年</th></tr></thead>
    <tbody>
      {% for row in p.profit_season.rows %}
      <tr>
        <th scope="row">{{ row.year }}{% if not row.complete %}<span class="muted">*</span>{% endif %}</th>
        {% for v in row["values"] %}<td class="num">{{ "%.2f"|format(v) if v is not none else "" }}</td>{% endfor %}
        <td class="num">{{ "%.2f"|format(row.total) if row.total else "" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p class="muted">單季 EPS（元）。虧損年度不列入比重平均——占比在有負數時沒有意義。</p>
{% endif %}

{# ================= 10. 外資投信 ================= #}
</section>

<section class="panel" id="panel-inst" role="tabpanel" aria-labelledby="tab-inst" hidden>
<h3 id="inst">外資投信</h3>
{% if p.institutional %}
{% set i = p.institutional %}
<div class="cards">
  <div class="card"><b>{{ "{:,.0f}".format(i.totals["外資"]) if i.totals["外資"] is not none else "—" }}</b>
    <span>近 20 日外資買賣超（張）</span></div>
  <div class="card"><b>{{ "{:,.0f}".format(i.totals["投信"]) if i.totals["投信"] is not none else "—" }}</b>
    <span>近 20 日投信買賣超（張）</span></div>
{# 持股比重看的是 `latest_share`，不是 `latest`：買賣超可能比它新一天（最上面
     那幾列是每日開放資料補的，只有買賣超），而一張寫著「—」的卡片會讓人以為
     資料掉了，其實只是那一天還沒有比重。 #}
{% set ls = i.latest_share %}
  <div class="card"><b>{{ "%.2f"|format(ls.share["外資"] * 100) if ls and ls.share["外資"] is not none else "—" }}%</b>
    <span>外資持股比重（{{ ls.date if ls else "—" }}）</span></div>
  <div class="card"><b>{{ "%.2f"|format(ls.share["三大法人"] * 100) if ls and ls.share["三大法人"] is not none else "—" }}%</b>
    <span>三大法人持股比重</span></div>
</div>
{{ i.figures.foreign_net|safe }}
{{ i.figures.foreign_share|safe }}
<div class="scroll">
  <table>
    <thead>
      <tr><th>日期</th><th class="num">外資</th><th class="num">投信</th>
          <th class="num">自營商</th><th class="num">單日合計</th>
          <th class="num">外資持股</th><th class="num">外資比重</th>
          <th class="num">三大法人比重</th></tr>
    </thead>
    <tbody>
      {% for d in i.days %}
      <tr>
        <th scope="row">{{ d.date }}</th>
        {% for k in ["外資", "投信", "自營商", "合計"] %}
        <td class="num">{{ "{:,.0f}".format(d.net[k]) if d.net[k] is not none else "" }}</td>
        {% endfor %}
        <td class="num">{{ "{:,.0f}".format(d.holding["外資"]) if d.holding["外資"] is not none else "" }}</td>
        <td class="num">{{ "%.2f"|format(d.share["外資"] * 100) ~ "%" if d.share["外資"] is not none else "" }}</td>
        <td class="num">{{ "%.2f"|format(d.share["三大法人"] * 100) ~ "%" if d.share["三大法人"] is not none else "" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p class="muted">
  買賣超單位為張。投信與自營商的庫存交易所並未公告，MoneyDJ 的數值為估計值。
  {% if i.from_daily %}
  最新的 {{ i.from_daily }} 個交易日由每日排程從證交所／櫃買直接取得，所以不必按
  「立即更新」也是新的；那幾列只有買賣超，估計持股與持股比重要等下一次重抓報表。
  {% endif %}
</p>
{% else %}
<p class="stale">尚未取得〔三大法人〕，請執行 <code>twsix fetch-stock {{ p.stock_id }}</code>。</p>
{% endif %}

{# ================= 個股新聞 ================= #}
</section>

<section class="panel" id="panel-news" role="tabpanel" aria-labelledby="tab-news" hidden>
<h3 id="news">個股新聞</h3>
{% if p.news %}
{% set n = p.news %}
{% if n.items %}
<p class="note">
  鉅亨網，近 {{ n.days }} 天共 <b>{{ n.items|length }}</b> 則，最新 {{ n.latest }}。
  {%- if n.dropped %}　更早的 {{ n.dropped }} 則未列出。{% endif %}
</p>
<ol class="news">
  {% for it in n.items %}
  <li>
    <div class="meta">
      <time>{{ it.date }}{% if it.time %} {{ it.time }}{% endif %}</time>
      <span class="src">{{ it.source }}</span>
    </div>
    {# 另開分頁。讀者點一則新聞是「順便看一下」，不是「離開這一頁」——原本會把
       整份報告換掉，回來還得重新選分頁、重新捲到原來的位置。
       noopener noreferrer 是開新分頁的必要配套：少了它，被開的那一頁可以透過
       window.opener 改寫這一頁的網址。 #}
    {% if it.url %}<a class="head" href="{{ it.url }}" target="_blank" rel="noopener noreferrer">{{ it.title }}<span class="ext" aria-hidden="true">↗</span><span class="sr">（另開分頁）</span></a>
    {% else %}<b class="head">{{ it.title }}</b>{% endif %}
    {% if it.summary %}<p class="sum">{{ it.summary }}</p>{% endif %}
  </li>
  {% endfor %}
</ol>
{% else %}
<p class="note">鉅亨網，近 {{ n.days }} 天沒有談到這一檔公司的新聞。</p>
{% endif %}
{% else %}
<p class="stale">尚未取得〔個股新聞〕，請執行 <code>twsix report {{ p.stock_id }}</code>。</p>
{% endif %}

