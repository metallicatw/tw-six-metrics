{% extends "base.html.j2" %}
{% block title %}{{ p.stock_id }} {{ p.name }}｜{{ site_title }}{% endblock %}
{% block body %}

{# 三列一起釘住：股名、財報／營收／股價、分頁列。它們是讀每一個分頁時都要看的
   座標——一個數字是好是壞，要對照它是哪一季、股價多少才知道。捲到第八個分頁還
   要往回捲才能確認季別，等於每次都重讀一次。 #}
<div class="ident sticky">
  <h2 id="top">{{ p.stock_id }}　{{ p.name }}</h2>
  <p class="facts">
    <span>財報 <b>{{ p.fiscal_quarter or "—" }}</b></span>
    <span>營收 <b>{{ p.revenue_month or "—" }}</b></span>
    {%- if p.market_price %}<span>股價 <b>{{ "%.2f"|format(p.market_price) }}</b></span>{% endif %}
    {%- if p.latest_composite is not none %}
    <span>綜合 <b>{{ "%.2f"|format(p.latest_composite) }}</b></span>
    {%- endif %}
  </p>

<div class="tabs" role="tablist" aria-label="頁面區塊">
  <button type="button" role="tab" id="tab-summary" class="tab" aria-controls="panel-summary" aria-selected="true">評價簡表</button>
  <button type="button" role="tab" id="tab-six" class="tab" aria-controls="panel-six" aria-selected="false" tabindex="-1">六大財務指標評等</button>
  <button type="button" role="tab" id="tab-eps" class="tab" aria-controls="panel-eps" aria-selected="false" tabindex="-1">EPS預估與估價</button>
  <button type="button" role="tab" id="tab-yield" class="tab" aria-controls="panel-yield" aria-selected="false" tabindex="-1">殖利率估價</button>
  <button type="button" role="tab" id="tab-river" class="tab" aria-controls="panel-river" aria-selected="false" tabindex="-1">河流圖</button>
  <button type="button" role="tab" id="tab-season" class="tab" aria-controls="panel-season" aria-selected="false" tabindex="-1">季節性</button>
  <button type="button" role="tab" id="tab-inst" class="tab" aria-controls="panel-inst" aria-selected="false" tabindex="-1">外資投信</button>
  <button type="button" role="tab" id="tab-news" class="tab" aria-controls="panel-news" aria-selected="false" tabindex="-1">個股新聞</button>
  {# 這兩張只有匯入過才有分頁——沒有資料的分頁點開是一句道歉，不是一頁。 #}
  {% if p.holders %}
  <button type="button" role="tab" id="tab-holders" class="tab" aria-controls="panel-holders" aria-selected="false" tabindex="-1">大戶持股</button>
  {% endif %}
  {% if p.directors %}
  <button type="button" role="tab" id="tab-directors" class="tab" aria-controls="panel-directors" aria-selected="false" tabindex="-1">董監持股</button>
  {% endif %}
  {% if p.unbuilt %}
  <button type="button" role="tab" id="tab-unbuilt" class="tab" aria-controls="panel-unbuilt" aria-selected="false" tabindex="-1">尚未建置</button>
  {% endif %}
</div>
</div>

{% if p.excluded %}
<p class="stale">{{ p.excluded }}——這一檔不適用六大指標。</p>
{% endif %}

<section class="panel" id="panel-summary" role="tabpanel" aria-labelledby="tab-summary">
<h3 id="summary">評價簡表</h3>

<div class="cards">
  <div class="card">
    <b>{{ "%.2f"|format(p.latest_composite) if p.latest_composite is not none else "—" }}</b>
    <span>最新綜合評分</span>
  </div>
  <div class="card">
    <b>{{ "%.2f"|format(p.market_price) if p.market_price else "—" }}</b>
    <span>市價</span>
  </div>
  <div class="card">
    <b>{{ p.pe.reward_risk if p.pe else "—" }}</b>
    <span>報酬風險比{% if p.pe %}　{{ p.pe.verdict }}{% endif %}</span>
  </div>
  <div class="card">
    <b>{{ p.dividend.verdict if p.dividend else "—" }}</b>
    <span>殖利率估價判斷</span>
  </div>
</div>

<p class="{{ 'verdict-yes' if p.worth_researching else 'verdict-no' }}">
  {% if p.worth_researching %}
    綜合評分 {{ "%.2f"|format(p.latest_composite) }} ≥ 3，依〔操作說明〕的建議<b>值得進一步研究</b>。
  {% else %}
    〔操作說明〕建議綜合評價 3 分以上才有研究必要；本檔最新綜合評分
    {{ "%.2f"|format(p.latest_composite) if p.latest_composite is not none else "不足以計算" }}。
  {% endif %}
</p>

<div class="scroll">
  <table>
    <thead>
      <tr>
        <th>期別</th><th>財報季度</th><th>營收月份</th>
        {% for label in indicator_labels %}<th>{{ label }}</th>{% endfor %}
        <th class="num">綜合</th><th>價值</th>
      </tr>
    </thead>
    <tbody>
      {% for row in p.periods %}
      <tr>
        <td>{{ row.index }}</td>
        <td>{{ row.quarter }}</td>
        <td>{{ row.month }}</td>
        {% for key in indicator_keys %}
        <td>
          {%- if row.grades[key].badge -%}
            <span class="g g-{{ row.grades[key].text }}">{{ row.grades[key].text }}</span>
          {%- else -%}
            <span class="muted">{{ row.grades[key].text }}</span>
          {%- endif -%}
        </td>
        {% endfor %}
        <td class="num" title="{{ row.composite }}">{{ row.composite_short }}</td>
        <td>{% if row.value_pick %}<span class="pick">★</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

<details class="sources">
  <summary>資料來源（{{ p.sources|selectattr("ok")|list|length }}/{{ p.sources|length }}）</summary>
  <ul class="srclist">
    {% for s in p.sources %}
    <li class="{{ 'ok' if s.ok else 'missing' }}">{{ s.sheet }}{% if not s.ok %}　未取得{% endif %}</li>
    {% endfor %}
  </ul>
</details>

{# ================= 2. 六大財務指標評等 ================= #}
</section>

<section class="panel" id="panel-six" role="tabpanel" aria-labelledby="tab-six" hidden>
<h3 id="six">六大財務指標評等</h3>
<p class="muted">最新一期（{{ p.fiscal_quarter }} / {{ p.revenue_month }}）各指標的數列與評分理由。</p>

<div class="scroll">
  <table>
    <thead>
      <tr><th>指標</th><th>評等</th><th class="num">評分</th><th class="num">近六期數列</th><th>理由</th></tr>
    </thead>
    <tbody>
      {% for ind in p.indicators %}
      <tr>
        <th scope="row">{{ ind.label }}</th>
        <td>
          {%- if ind.badge -%}
            <span class="g g-{{ ind.letter }}">{{ ind.letter }}</span>
          {%- else -%}
            <span class="muted">{{ ind.letter or "—" }}</span>
          {%- endif -%}
        </td>
        <td class="num">{{ ind.display }}</td>
        <td class="series">
          {# 期別在上、數值在下，同一個 grid 欄，所以一定對齊。六個裸數字沒有
             期別是讀不出來的：營收年增率數的是月，其他五項數的是季。 #}
          <div class="cells" style="--n:{{ ind['values']|length }}">
            {% for label in ind["periods"] %}<span class="p">{{ label }}</span>{% endfor %}
            {% for v in ind["values"] %}
            <span class="v">{{ "%.2f"|format(v) if v is not none else "—" }}</span>
            {% endfor %}
          </div>
        </td>
        <td class="reason">{{ ind.reason }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>

{# 每個指標的圖就接在它自己的評等後面。
   把六張圖另開一個分頁，等於要讀者記住「B 是哪一項」再切過去對——而那正是圖表
   要省掉的動作。表格用來掃，圖用來看走勢，兩者講的是同一條數列。 #}
{% for ind in p.indicators %}
{% if p.statements[ind.key] %}
<section class="metric">
  <h4>
    {%- if ind.badge -%}<span class="g g-{{ ind.letter }}">{{ ind.letter }}</span>
    {%- else -%}<span class="g g-na">{{ ind.letter or "—" }}</span>{%- endif -%}
    <span class="nm">{{ ind.label }}</span>
    <span class="why">{{ ind.reason }}</span>
  </h4>
  {{ p.statements[ind.key]|safe }}
</section>
{% endif %}
{% endfor %}

{# 月營收本身不是六大指標之一（評分看的是年增率），但它是那條年增率的分母，
   放在最後當背景。 #}
{% if p.figures.revenue %}{{ p.figures.revenue|safe }}{% endif %}

{# ================= 3. EPS預估與估價 ================= #}
</section>

<section class="panel" id="panel-eps" role="tabpanel" aria-labelledby="tab-eps" hidden>
<h3 id="eps">EPS預估與估價</h3>

{% if p.gaps.forecast or p.gaps.pe %}
<p class="stale">{{ p.gaps.forecast or p.gaps.pe }}——此區塊無法計算。</p>
{% endif %}

{% if p.forecast %}
<div class="val">
  <section>
    <h4>預估 EPS</h4>
    <dl>
      <dt>營收月份</dt><dd>{{ p.forecast.revenue_month }}</dd>
      <dt>預估成長率</dt><dd>{{ p.forecast.growth_rate }}</dd>
      <dt>預估營收</dt><dd>{{ p.forecast.projected_revenue }}</dd>
      <dt>稅後淨利率</dt><dd>{{ p.forecast.net_margin }}</dd>
      <dt>預估淨利</dt><dd>{{ p.forecast.projected_income }}</dd>
      <dt>加權平均股數</dt><dd>{{ p.forecast.weighted_shares }}</dd>
      <dt>預估 EPS</dt><dd class="big">{{ p.forecast.eps }}</dd>
      <dt>近四季 EPS</dt><dd>{{ p.forecast.trailing_eps }}</dd>
    </dl>
  </section>
  {% if p.pe %}
  <section>
    <h4>本益比估價</h4>
    <dl>
      <dt>本益比區間</dt><dd>{{ p.pe.band_low }} – {{ p.pe.band_high }}</dd>
      <dt>目標價</dt><dd class="big">{{ p.pe.target }}</dd>
      <dt>下檔價</dt><dd>{{ p.pe.downside }}</dd>
      <dt>預期報酬</dt><dd>{{ p.pe.expected_return }}</dd>
      <dt>預期風險</dt><dd>{{ p.pe.expected_risk }}</dd>
      <dt>報酬風險比</dt><dd class="big">{{ p.pe.reward_risk }}</dd>
    </dl>
  </section>
  {% endif %}
  {% if p.growth %}
  <section>
    <h4>成長模型</h4>
    <dl>
      <dt>預估本益比</dt><dd>{{ p.growth.forward_pe }}</dd>
      <dt>EPS 成長率</dt><dd>{{ p.growth.eps_growth }}</dd>
      <dt>PEG</dt><dd>{{ p.growth.peg }}</dd>
      <dt>總報酬本益比</dt><dd>{{ p.growth.total_return }}</dd>
    </dl>
  </section>
  {% endif %}
</div>
{% endif %}

{% if p.figures.pe_band %}{{ p.figures.pe_band|safe }}{% endif %}

{% if p.calc and p.calc.revenue and p.calc.shares %}
{# ================= 目標價試算盤 =================
   上面那幾格是「引擎依規則算出來的一個答案」。這一區是「你自己的假設會得到什麼
   答案」——同一條公式，參數交給讀者。

   預設值不是憑空填的，每一個都說得出出處（見下方說明），而且和坊間工具對得起來。
   打開的時候看到的是這一檔的事實，改動之後看到的是你的假設。 #}
<section class="calc" id="calc"
         data-seed='{{ p.calc|tojson }}' data-price="{{ p.market_price or '' }}">
  <h4>目標價試算盤<span class="muted">　改任何一格，下面的矩陣立刻重算</span></h4>

  <p class="note" id="calc-basis"></p>

  {% if p.calc.years %}
  <div class="scroll"><table class="mini">
    <thead><tr><th>項目</th>{% for y in p.calc.years %}<th class="num">{{ y.year }}</th>{% endfor %}</tr></thead>
    <tbody>
      {% for label, key, digits in (('股價高點','high',1),('股價低點','low',2),('EPS','eps',2),('本益比高','pe_high',1),('本益比低','pe_low',1)) %}
      <tr><td>{{ label }}</td>
        {% for y in p.calc.years %}
        <td class="num">{{ ('%.' ~ digits ~ 'f')|format(y[key]) if y[key] is not none else '—' }}</td>
        {% endfor %}
      </tr>
      {% endfor %}
    </tbody>
  </table></div>
  {% endif %}

  <div class="calc-inputs">
    <label>年營收（百萬元）<input type="number" id="c-rev" step="any"></label>
    <label>股數（億股）<input type="number" id="c-sh" step="any"></label>
    <label>預估營收成長率（%）<span class="hint">悲觀, 中性, 樂觀</span>
      <input type="text" id="c-g" inputmode="decimal"></label>
    <label>預估淨利率（%）<span class="hint">悲觀, 中性, 樂觀</span>
      <input type="text" id="c-m" inputmode="decimal"></label>
    <label>預估本益比 PE<span class="hint">每個 PE 一張目標價矩陣</span>
      <input type="text" id="c-pe" inputmode="decimal"></label>
  </div>
  <p class="calc-formula">
    預估 EPS ＝ 年營收 × (1 ＋ 營收成長率) × 淨利率 ÷ 股數　│　
    預估目標價 ＝ 預估 EPS × 預估本益比
  </p>
  <button type="button" class="btn-grab" id="c-run">重新計算</button>
  <button type="button" class="linkish" id="c-reset">還原預設值</button>

  <div id="calc-out"></div>
</section>
{% endif %}

<div class="criteria">
  <h4>報酬風險比判斷準則<span class="muted">　總大EPS、PER 動態調整推估法</span></h4>
  <ol>
    {% for range_text, label, why in reward_risk_rules %}
    <li class="{{ 'hit' if p.pe and p.pe.verdict == label else '' }}">
      <b>{{ range_text }}</b>　{{ why }}
      {%- if p.pe and p.pe.verdict == label %}　<span class="tag">本檔 {{ p.pe.reward_risk }}</span>{% endif %}
    </li>
    {% endfor %}
  </ol>
  <ul class="warnings">
    {% for note in reward_risk_notes %}<li>{{ note }}</li>{% endfor %}
  </ul>
</div>

{# ================= 4. 殖利率估價 ================= #}
</section>

<section class="panel" id="panel-yield" role="tabpanel" aria-labelledby="tab-yield" hidden>
<h3 id="yield">殖利率估價</h3>

{% if p.gaps.yield %}
<p class="stale">{{ p.gaps.yield }}——此區塊無法計算。</p>
{% endif %}

{% if p.dividend %}
<div class="val">
  <section>
    <h4>預估股利</h4>
    <dl>
      <dt>預估股利</dt><dd class="big">{{ p.dividend.dividend }}</dd>
      <dt>配發率</dt><dd>{{ p.dividend.payout_ratio }}</dd>
      <dt>現價殖利率</dt><dd>{{ p.dividend.current_yield }}</dd>
    </dl>
  </section>
  <section>
    <h4>估價區間</h4>
    <dl>
      <dt>便宜價</dt><dd>{{ p.dividend.cheap }}</dd>
      <dt>合理價</dt><dd>{{ p.dividend.fair }}</dd>
      <dt>昂貴價</dt><dd>{{ p.dividend.expensive }}</dd>
      <dt>判斷</dt><dd class="big">{{ p.dividend.verdict }}</dd>
    </dl>
  </section>
</div>
{% endif %}

{% if p.figures.yield_band %}{{ p.figures.yield_band|safe }}{% endif %}

{% if p.dividend_lag_rows %}
<h4>歷年股價與股利</h4>
<p class="muted">
  「盈餘年」是股利所屬的獲利年度，「發放年」是實際配發的年度——同一筆金額
  在兩欄之間差一年，這就是估價時股利遞延一年的依據。
</p>
<div class="scroll">
  <table>
    <thead>
      <tr><th>年度</th><th class="num">最高價</th><th class="num">最低價</th>
          <th class="num">收盤平均價</th>
          <th class="num">現金股利（盈餘年）</th><th class="num">現金股利（發放年）</th></tr>
    </thead>
    <tbody>
      {% for row in p.dividend_lag_rows %}
      <tr>
        <th scope="row">{{ row.year }}</th>
        <td class="num">{{ row.high }}</td>
        <td class="num">{{ row.low }}</td>
        <td class="num">{{ row.avg }}</td>
        <td class="num">{{ row.cash_earned }}</td>
        <td class="num">{{ row.cash_paid }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% endif %}


{# 〔財報圖表〕已併入〔六大財務指標評等〕：六張圖就是六個等第的數列，
   分成兩個分頁只是逼讀者自己在腦裡對照。 #}
</section>

<section class="panel" id="panel-river" role="tabpanel" aria-labelledby="tab-river" hidden>
<h3 id="river">河流圖（本益比）</h3>
{% if p.river %}
{% if p.river.figure %}
<p class="note">
  本益比倍數取自<b>年度</b>資料——每年的收盤均價除以當年 EPS，2.5%～97.5%
  信任區間切成六區。分區<b>會彎</b>，因為它們是那組固定倍數乘上<b>當時</b>的
  近四季 EPS，而 EPS 每季會變；季報要等公布才算數（Q1 五月中、Q2 八月中、
  Q3 十一月中、年報隔年三月底），所以邊界是階梯而不是平滑曲線。
</p>
{{ p.river.figure }}
{% else %}
<p class="stale">
  活頁簿的河流圖用<b>週線</b>收盤價；這次沒抓到週線序列，
  這裡只列出分區與目前位置。判斷「現在落在哪一區」不受影響，
  平滑的曲線則畫不出來。
</p>
{% endif %}
<div class="cards">
  <div class="card"><b>{{ "%.2f"|format(p.river.current) if p.river.current else "—" }}</b>
    <span>目前本益比</span></div>
  <div class="card"><b>{{ p.river.zone_name }}</b><span>所在分區</span></div>
  <div class="card"><b>{{ p.river.years }}</b><span>採計年數</span></div>
  {% if p.river.weeks %}
  <div class="card"><b>{{ p.river.weeks }}</b><span>週線點數</span></div>
  {% endif %}
</div>
<div class="scroll">
  <table>
    <thead><tr><th>分區</th><th class="num">本益比區間</th><th></th></tr></thead>
    <tbody>
      {% for name, rng in p.river.ranges %}
      <tr class="{{ 'here' if name == p.river.zone_name else '' }}">
        <th scope="row">{{ name }}</th>
        <td class="num">{{ rng }}</td>
        <td>{% if name == p.river.zone_name %}<span class="pick">← 目前</span>{% endif %}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
{% else %}
<p class="stale">歷年本益比不足五年，無法畫出信任區間。</p>
{% endif %}

{# ================= 7-8. 季節性 ================= #}
</section>

<section class="panel" id="panel-season" role="tabpanel" aria-labelledby="tab-season" hidden>
<h3 id="season">營收季節性 / 獲利季節性</h3>

{% if p.revenue_season %}
{% if p.revenue_season.figure %}{{ p.revenue_season.figure|safe }}{% endif %}
<div class="scroll">
  <table>
    <thead><tr><th>年度</th>
      {% for c in p.revenue_season.columns %}<th class="num">{{ c }}</th>{% endfor %}
      <th class="num">全年</th></tr></thead>
    <tbody>
      {% for row in p.revenue_season.rows %}
      <tr>
        <th scope="row">{{ row.year }}{% if not row.complete %}<span class="muted">*</span>{% endif %}</th>
        {% for v in row["values"] %}<td class="num">{{ "{:,.0f}".format(v) if v is not none else "" }}</td>{% endfor %}
        <td class="num">{{ "{:,.0f}".format(row.total) if row.total else "" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p class="muted">單位仟元。標 * 的年度尚未完整，不列入比重平均。</p>
{% else %}
<p class="stale">沒有月營收資料。</p>
{% endif %}

{% if p.profit_season %}
{% if p.profit_season.figure %}{{ p.profit_season.figure|safe }}{% endif %}
<div class="scroll">
  <table>
    <thead><tr><th>年度</th>
      {% for c in p.profit_season.columns %}<th class="num">Q{{ c }}</th>{% endfor %}
      <th class="num">全年</th></tr></thead>
    <tbody>
      {% for row in p.profit_season.rows %}
      <tr>
        <th scope="row">{{ row.year }}{% if not row.complete %}<span class="muted">*</span>{% endif %}</th>
        {% for v in row["values"] %}<td class="num">{{ "%.2f"|format(v) if v is not none else "" }}</td>{% endfor %}
        <td class="num">{{ "%.2f"|format(row.total) if row.total else "" }}</td>
      </tr>
      {% endfor %}
    </tbody>
  </table>
</div>
<p class="muted">單季 EPS（元）。虧損年度不列入比重平均——占比在有負數時沒有意義。</p>
