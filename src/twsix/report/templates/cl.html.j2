      b.onclick = function(){ var s = +b.getAttribute("data-s"); setStage(STAGE === s ? 0 : s); };
    });
    $("cx-unstage").onclick = function(){ setStage(0); };
    // 用「上一頁」回到這一頁時，瀏覽器會把頁面原樣還原：漏斗篩選一律取消，回到依層級顯示
    window.addEventListener("pageshow", function(ev){ if (ev.persisted && STAGE) setStage(0); });
    tiersUI(); paramsUI(); backtest();
    $("cx-msg").textContent = "最新季報 " + (D.asof || "—") + "；" + D.rows.filter(function(r){ return r.m.sec !== "fin"; }).length + " 檔有合約負債（金融保險排除）。漏斗上的數字是各段通過的檔數，點一下只看那一段。";
    $("cx-pnote").textContent = "門檻改了會自動重算；「清除條件」＝不設門檻（只剩危險訊號與資料完整度）。";
    run();
  }
  (window.CX_EARLY || fetch("cl/all.json", {cache: "no-cache"})).then(function(r){ if (!r.ok) throw new Error(r.status); return r.json(); })
    .then(init).catch(function(){ $("cx-msg").textContent = "還沒有合約負債選股的資料（下一次建站後就會出現）。"; });
})();
</script>
{% endblock %}
