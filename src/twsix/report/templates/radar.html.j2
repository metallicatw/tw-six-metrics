function table(host, rows, cols, opt){
  opt = opt || {};
  host.innerHTML = "";
  var state = {key: opt.sort || null, dir: 1, page: 0}, size = 50;
  var head = el("p", {cls: "cf-note"});
  var wrap = el("div", {cls: "cf-scroll"});
  var nav = el("div", {cls: "cf-row"});
  host.appendChild(head); host.appendChild(wrap); host.appendChild(nav);
  // 〔標記〕欄可以排序：精選 3 ＞ 共振 2 ＞ 沒有標記 1，被 E 否決的再扣 0.5
  // （所以「共振＋E否決」排在「共振」之後、「沒有標記」之前）。第一次點由大到小。
  function tagv(r){ return (r.pick ? 3 : r.l1 ? 2 : 1) - (r.veto ? 0.5 : 0); }
  function render(){
    var list = rows.slice();
    if (state.key){
      list.sort(function(a, b){
        var x = state.key === "_tag" ? tagv(a) : a[state.key], y = state.key === "_tag" ? tagv(b) : b[state.key];
        if (x == null && y == null) return 0; if (x == null) return 1; if (y == null) return -1;
        return (x < y ? -1 : x > y ? 1 : 0) * state.dir;
      });
    }
    var pages = Math.max(1, Math.ceil(list.length / size));
    if (state.page >= pages) state.page = pages - 1;
    head.innerHTML = "";
    head.appendChild(el("span", {cls: "cf-cnt", text: "符合條件：" + list.length.toLocaleString() + " / " + R.rows.length.toLocaleString() + " 檔"}));
    head.appendChild(document.createTextNode((opt.extra || "") + "。" + LINK_NOTE));
    var t = el("table", {cls: "cf-tbl"});
    var tr = el("tr");
    cols.forEach(function(c){
      var th = el("th", {cls: c[2] === "l" ? "l" : "", text: c[1] + (state.key === c[0] ? (state.dir > 0 ? " ▲" : " ▼") : "")});
      th.onclick = function(){ if (state.key === c[0]) state.dir = -state.dir; else { state.key = c[0]; state.dir = 1; } render(); };
      tr.appendChild(th);
    });
    var tg = el("th", {cls: "l", title: "精選 ＞ 共振 ＞ 無；E 否決排在同級之後", text: "標記" + (state.key === "_tag" ? (state.dir > 0 ? " ▲" : " ▼") : "")});
    tg.onclick = function(){ if (state.key === "_tag") state.dir = -state.dir; else { state.key = "_tag"; state.dir = -1; } render(); };
    tr.appendChild(tg);
    t.appendChild(tr);
    list.slice(state.page * size, state.page * size + size).forEach(function(r){
      var row = el("tr");
      cols.forEach(function(c){
        if (c[0] === "c") row.appendChild(codeCell(r.c));
        else if (c[0] === "n") row.appendChild(nameCell(r.c, r.n));
        else if (c[0] === "p") row.appendChild(priceCell(r.c, r.p, c[2]));
        else if (c[2] === "l") row.appendChild(el("td", {cls: "l", text: r[c[0]] == null ? "" : String(r[c[0]])}));
        else row.appendChild(el("td", {text: fmt(r[c[0]], c[2])}));
      });
      var tags = el("td", {cls: "l"});
      if (r.pick) tags.appendChild(el("span", {cls: "cf-badge pick", text: "精選"}));
      else if (r.l1) tags.appendChild(el("span", {cls: "cf-badge l1", text: "共振"}));
      if (r.veto) tags.appendChild(el("span", {cls: "cf-badge veto", text: "E否決"}));
      row.appendChild(tags);
      t.appendChild(row);
    });
    wrap.innerHTML = ""; wrap.appendChild(t);
    nav.innerHTML = "";
    var prev = el("button", {cls: "cf-btn", text: "‹ 上一頁"}), next = el("button", {cls: "cf-btn", text: "下一頁 ›"});
    prev.disabled = state.page <= 0; next.disabled = state.page >= pages - 1;
    prev.onclick = function(){ state.page--; render(); }; next.onclick = function(){ state.page++; render(); };
    nav.appendChild(prev); nav.appendChild(el("span", {cls: "cf-note", text: "第 " + (state.page + 1) + " / " + pages + " 頁"})); nav.appendChild(next);
  }
  render();
}
