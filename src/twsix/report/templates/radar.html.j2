function gunzip(buf){
  var u = new Uint8Array(buf);
  if (u.length < 2 || u[0] !== 0x1f || u[1] !== 0x8b) return Promise.resolve(u);   // 伺服器已經解開了
  if (typeof DecompressionStream === "undefined") return Promise.reject(new Error("這個瀏覽器太舊，不支援解壓縮（請更新瀏覽器）"));
