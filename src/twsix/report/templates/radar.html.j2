function histHead(){ return HS_HEAD || (HS_HEAD = getJSON("hist.json")); }
// 一條序列：varint → zigzag → 逐日累加（int32 環繞），寫進 A[base…base+len)，回傳讀到哪
function readSeq(u, pos, A, base, len){
