// radar.json 按欄存（chipflow/site.py 的 pack_rows）：還原成一列一檔，null 的欄位略過
// ——和原本「沒有這個鍵」一樣，後面的程式不用分兩種。
function unpackRows(doc){
  if (!doc.cols) return doc;
  var keys = Object.keys(doc.cols), rows = new Array(doc.nrows);
  for (var i = 0; i < doc.nrows; i++){
    var r = {};
    for (var k = 0; k < keys.length; k++){ var v = doc.cols[keys[k]][i]; if (v != null) r[keys[k]] = v; }
    rows[i] = r;
  }
  delete doc.cols; doc.rows = rows;
  return doc;
}
getJSON("radar.json").then(function(doc){
