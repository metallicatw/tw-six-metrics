// 第 s 檔在第 d 天是否符合（HS 已載入、d 以前 condLook 天都在 HS.from 之後）
function passAt(c, s, d){
  var k;
  if (c.liq || c.t1){ var fl = hvi("fl", s, d); if (fl == null) return false; if (c.liq && !(fl & 1)) return false; if (c.t1 && !(fl & 2)) return false; }
  var from = Math.max(HS.from, d - (c.win ? c.win - 1 : 0));
  function anyDay(test){ for (var j = d; j >= from; j--){ if (test(j)) return true; } return false; }
  var ranks = ["wr", "xr", "yr", "vr", "hr"];
  for (var r = 0; r < ranks.length; r++){
    k = ranks[r]; if (c[k] == null) continue;
    var lim = c[k], kk = k;
    if (!anyDay(function(j){ var v = hvi(kk, s, j); return v != null && v <= lim; })) return false;
  }
  if (c.z != null){ var zl = c.z; if (!anyDay(function(j){ var v = hv("z", s, j); return v != null && v > zl; })) return false; }
  var hp = null;
  if (c.hpm != null || c.hpn != null){ hp = hv("hp", s, d); if (hp == null) return false; }
  if (c.hpm != null && !(hp > c.hpm)) return false;
  if (c.hpn != null){
    if (d - c.hpn < HS.from) return false;
    var hp0 = hv("hp", s, d - c.hpn); if (hp0 == null) return false;
    if (!(hp - hp0 > (c.hpd || 0) + 1e-9)) return false;
  }
  if (c.shn != null){
    if (d - c.shn < HS.from) return false;
    var s1 = hvi("sh", s, d), s0 = hvi("sh", s, d - c.shn);
    if (s1 == null || s0 == null || !(s1 < s0)) return false;
  }
  if (c.pk){
    if (d - c.pkn < HS.from) return false;
    var a1 = hvi(c.pk, s, d), a0 = hvi(c.pk, s, d - c.pkn);
    if (a1 == null || a0 == null || a1 > a0) return false;
  }
  var ge = ["tex", "ft", "d20", "d60"];
  for (var g = 0; g < ge.length; g++){
    k = ge[g];
    var v1 = null;
    if (c[k] != null){ v1 = hv(k, s, d); if (v1 == null || v1 < c[k]) return false; }
    if (c[k + "c"] != null){
      if (d - 20 < HS.from) return false;
      if (v1 == null) v1 = hv(k, s, d);
      var v0 = hv(k, s, d - 20);
      if (v1 == null || v0 == null || v1 - v0 < c[k + "c"]) return false;
    }
  }
  return true;
}
// 逐日歷史載不到時 ④ 的退路：用今天的 radar 列（大戶比例、股東人數改用週資料，N 日 ≈ N／5 週）
function passRow(c, r){
  if (c.liq && !r.liq) return false;
  if (c.t1 && !r.t1) return false;
  var ok = true;
  ["wr", "xr", "yr", "vr", "hr"].forEach(function(k){ if (c[k] != null && !(isnum(r[k]) && r[k] <= c[k])) ok = false; });
  if (c.z != null && !(isnum(r.z) && r.z > c.z)) ok = false;
  if (c.hpm != null && !(isnum(r.hp) && r.hp > c.hpm)) ok = false;
  if (c.hpn != null){ var w = Math.max(1, Math.round(c.hpn / 5)), a = (r.hps || [])[0], b = (r.hps || [])[w]; if (!isnum(a) || !isnum(b) || !(a - b > (c.hpd || 0))) ok = false; }
  if (c.shn != null){ var w2 = Math.max(1, Math.round(c.shn / 5)), s0 = (r.shs || [])[0], s1 = (r.shs || [])[w2]; if (!isnum(s0) || !isnum(s1) || !(s0 < s1)) ok = false; }
  ["tex", "ft", "d20", "d60", "texc", "ftc", "d20c", "d60c"].forEach(function(k){ if (c[k] != null && !(isnum(r[k]) && r[k] >= c[k])) ok = false; });
  return ok;
}
// 歷史某一天的一列（表格用）：籌碼取那一天的值，名稱、產業取今天的
function histRow(s, d){
