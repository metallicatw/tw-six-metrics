    trail(host, items, {tx: lg ? symlog : function(v){ return v; }, ty: lg ? function(v){ return Math.log10(Math.max(0.01, v)); } : function(v){ return v; },
      xzero: true, hline: hl, xlab: "外資投信買賣超 60 日累計（億元）", ylab: "20 日成交金額（億元）",
