  var state = {key: opt.sort || null, dir: 1, page: 0}, size = 50;
  var head = el("p", {cls: "cf-note"});
  var wrap = el("div", {cls: "cf-scroll"});
  var nav = el("div", {cls: "cf-row"});
  host.appendChild(head); host.appendChild(wrap); host.appendChild(nav);
  function render(){
    var list = rows.slice();
    if (state.key){
      list.sort(function(a, b){
        var x = a[state.key], y = b[state.key];
        if (x == null && y == null) return 0; if (x == null) return 1; if (y == null) return -1;
        return (x < y ? -1 : x > y ? 1 : 0) * state.dir;
      });
    }
    var pages = Math.max(1, Math.ceil(list.length / size));
    if (state.page >= pages) state.page = pages - 1;
    head.textContent = "符合條件：" + list.length.toLocaleString() + " / " + R.rows.length.toLocaleString() + " 檔" + (opt.extra || "");
