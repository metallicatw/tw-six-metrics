}

// ── 基本面的「那一天看得到的」版本（⑤ 24 個月回測、⑥ 篩選日）───────────────
function loadFund(){
  if (FD) return Promise.resolve(FD);
  if (FD_WAIT) return FD_WAIT;
  FD_WAIT = histHead().then(function(h){
    var fh = h.fund; if (!fh) throw new Error("沒有基本面歷史");
    return getBin("fund.bin").then(function(u){
      var nc = fh.codes.length, blocks = {ann: fh.ann, days: fh.days}, pos = 0, out = {};
