      if (r.veto) tags.appendChild(el("span", {cls: "cf-badge veto", text: "E否決"}));
      row.appendChild(tags);
      t.appendChild(row);
    });
    wrap.innerHTML = ""; wrap.appendChild(t);
    nav.innerHTML = "";
    var prev = el("button", {cls: "cf-btn", text: "‹ 上一頁"}), next = el("button", {cls: "cf-btn", text: "下一頁 ›"});
    prev.disabled = state.page <= 0; next.disabled = state.page >= pages - 1;
    prev.onclick = function(){ state.page--; render(); }; next.onclick = function(){ state.page++; render(); };
    nav.appendChild(prev); nav.appendChild(el("span", {cls: "cf-note", text: "第 " + (state.page + 1) + " / " + pages + " 頁"})); nav.appendChild(next);
  }
  render();
}
