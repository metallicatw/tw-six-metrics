  var j = R.journal || [];
  var card = el("div", {cls: "cf-card"}, el("h4", {text: "精選日誌（近 60 個交易日）"}), el("p", {cls: "cf-note", text: "每天的精選照實記下來（data/chipflow/journal.csv），之後對答案：報酬是入選當天收盤到今天的還原報酬，超額是減去同一天流動性母體的平均。這不是交易紀錄，沒有扣成本。"}));
  var t = el("table", {cls: "cf-tbl"});
  t.appendChild(el("tr", null, el("th", {cls: "l", text: "入選日"}), el("th", {cls: "l", text: "代號"}), el("th", {cls: "l", text: "名稱"}), el("th", {text: "入選價"}), el("th", {text: "天數"}), el("th", {text: "報酬%"}), el("th", {text: "超額%"}), el("th", {cls: "l", text: "今日警戒"})));
  j.forEach(function(x){ t.appendChild(el("tr", null, el("td", {cls: "l", text: x.date}), el("td", {cls: "l", text: x.code}), el("td", {cls: "l", text: x.name}), el("td", {text: fmt(x.close, 2)}), el("td", {text: String(x.held)}), el("td", {text: fmt(x.ret, 2)}), el("td", {text: fmt(x.excess, 2)}), el("td", {cls: "l"}, el("span", {cls: "cf-w-" + x.warn, text: x.warn})))); });
  if (!j.length) t.appendChild(el("tr", null, el("td", {cls: "l", colspan: 8, text: "還沒有紀錄。"})));
  card.appendChild(el("div", {cls: "cf-scroll"}, t));
