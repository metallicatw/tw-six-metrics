    else { c.pk = pk; c.pkn = pkn; }
  }
  if (c.hpd != null && c.hpn == null) fail("hpn", "大戶比例：填了「增加幾個百分點」，也要填跟幾個交易日前比較");
  c.liq = !!($(pre + "-liq") || {}).checked;
  c.t1 = !!($(pre + "-t1") || {}).checked;
  c.noveto = !!($(pre + "-noveto") || {}).checked;
