  });
  $("cf-asof").textContent = "資料日 " + R.asof + "（產生於 " + R.generated_at + "）。";
  $("cf-msg").hidden = true;   // 免責那一句已經在資料日旁邊的燈泡裡
  init();
}).catch(function(){
  $("cf-msg").textContent = "還沒有資料：籌碼雷達的每日計算（twsix chipflow）尚未跑過，或這次建站沒有產生 chipflow/ 資料。下一次排程後會自動出現。";
  document.querySelectorAll(".cf-tab").forEach(function(b){ b.disabled = true; });
  $("cf-about").classList.add("on");
});
})();
</script>
{% endblock %}
