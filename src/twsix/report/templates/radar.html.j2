<script>
(function(){
"use strict";
{% include "radar_bg/api.js" %}
var BASE = "chipflow/";
var R = null, M = null, RK = null, V = null, ROWS = {}, BYNAME = {};
var cache = {};
var COLORS = ["#e4572e","#2563c9","#17a398","#a86a00","#8b3fd4","#c02a4e","#5a8f00","#0e7c6f"];

function $(id){ return document.getElementById(id); }
function el(tag, attrs){
  var n = document.createElement(tag);
  if (attrs) for (var k in attrs){
    if (k === "text") n.textContent = attrs[k];
    else if (k === "cls") n.className = attrs[k];
    else if (k === "html") n.innerHTML = attrs[k];
    else n.setAttribute(k, attrs[k]);
  }
  for (var i = 2; i < arguments.length; i++){
    var c = arguments[i];
    if (c == null) continue;
    n.appendChild(typeof c === "string" ? document.createTextNode(c) : c);
  }
  return n;
}
function svgel(tag, attrs){
  var n = document.createElementNS("http://www.w3.org/2000/svg", tag);
  for (var k in attrs) n.setAttribute(k, attrs[k]);
  return n;
}
function isnum(v){ return typeof v === "number" && isFinite(v); }
var NF = {};
function fmt(v, d){
  if (!isnum(v)) return "—";
  // 格式器重複用（每次 toLocaleString(語系, 選項) 都會重建一個，表格一大就慢）
  d = d || 0;
  var f = NF[d] || (NF[d] = new Intl.NumberFormat("zh-TW", {minimumFractionDigits: d, maximumFractionDigits: d}));
  return f.format(v);
}
// 座標軸只有 46 px 寬：七位數以上改用「萬／億」，完整數字看圖右上角的提示
function axisFmt(v, d, span){
  var a = Math.abs(v);
  span = span || a;
  // 刻度之間差很少時（例如總集保張數一年只動幾百張）要多留小數，不然三個刻度長一樣
  var dec = function(unit){ var r = span / unit; return r < 0.05 ? 3 : r < 0.5 ? 2 : r < 5 ? 1 : 0; };
  if (a >= 1e8) return fmt(v / 1e8, dec(1e8)) + "億";
  if (a >= 1e4) return fmt(v / 1e4, dec(1e4)) + "萬";
  return fmt(v, d);
}
function getJSON(name){
  if (cache[name]) return cache[name];
  var early = (window.CF_EARLY || {})[name];
  if (early) delete window.CF_EARLY[name];
  cache[name] = (early || fetch(window.CF_URL ? window.CF_URL(name) : BASE + name, window.CF_OPT || {cache: "no-cache"})).then(function(r){
    if (!r.ok) throw new Error(name + " " + r.status);
    return r.json();
  });
  return cache[name];
}
function resolve(q){
  q = (q || "").trim();
  if (!q) return null;
  var m = q.match(/^\d{4}/);
  if (m && ROWS[m[0]]) return m[0];
  if (BYNAME[q]) return BYNAME[q];
  for (var c in ROWS){ if ((ROWS[c].n || "").indexOf(q) >= 0) return c; }
  return m ? m[0] : null;
}
function stock(code){ return getJSON("stock/" + code + ".json"); }
function label(code){ var r = ROWS[code]; return code + " " + (r ? r.n : ""); }
// ── 連結 ────────────────────────────────────────────────────────────────
// 代號 → 本頁的〔① 個股籌碼多圖〕；名稱 → 本站的〔個股資訊頁〕；收盤價旁的小圖示 →
// Yahoo 股市技術分析（和評等清單同一個圖示、同一個網址格式：上市 .TW、上櫃 .TWO）。
// 不另外加欄位：三種去處各自掛在「最自然會去點的那一格」，表頭的說明列講一次。
// ①～⑬ 裡的表格用 radar_bg/api.js 的 bgCode / bgName / bgYf，去處相同。
function yahooTA(code){
  var r = ROWS[code] || {};
  return "https://tw.stock.yahoo.com/quote/" + encodeURIComponent(code) + (r.mk === "上櫃" ? ".TWO" : r.mk === "上市" ? ".TW" : "") + "/technical-analysis";
}
function toT1(code){ open("t1", code); window.scrollTo(0, $("cf-tabs").getBoundingClientRect().top + window.pageYOffset - 8); }
function codeCell(code){
  var a = el("a", {href: "#t1-" + code, title: "① 個股籌碼多圖", text: code});
  a.onclick = function(e){ e.preventDefault(); toT1(code); };
  return el("td", {cls: "l"}, a);
}
function nameCell(code, name){
  return el("td", {cls: "l"}, el("a", {href: "stock/" + encodeURIComponent(code) + ".html", title: "個股資訊頁", text: name || code}));
}
function priceCell(code, v, d){
  return el("td", {cls: "cf-px"}, fmt(v, d), el("a", {cls: "yf", href: yahooTA(code), target: "_blank", rel: "noopener", title: "Yahoo股市技術分析", "aria-label": code + " Yahoo 技術分析"}));
}

var LINK_NOTE = "點代號看 ① 個股籌碼多圖、點名稱開個股資訊頁、點收盤價旁的圖示開 Yahoo 技術分析。";

// ── 💡 名詞說明 ─────────────────────────────────────────────────────────
// 和全站同一個燈泡（site.js 用事件委派處理，後來才畫出來的也有效）。內容是這裡寫死的
// 常數，不是資料，所以可以用 innerHTML。完整的名詞解釋在〔說明〕分頁。
function tipEl(html){
  var box = el("span", {cls: "tipbox", role: "note"}); box.innerHTML = html;
  return el("span", {cls: "tip"}, el("button", {type: "button", cls: "bulb", "aria-expanded": "false", title: "說明"},
    el("span", {"aria-hidden": "true", text: "💡"}), el("span", {cls: "sr", text: "說明"})), box);
}
var G_FI = "外資＋投信（不含自營商）每天的買賣超股數 × 當日均價（成交金額 ÷ 成交股數）＝買賣超金額。";
var G_WHALE = "<b>大戶</b>＝持股市值 ≥ 5,000 萬元的股東。每天用收盤價把 5,000 萬換算成張數門檻，加總集保 15 級裡門檻以上各級；門檻落在某一級中間時按對數比例只算一部分，所以股價跨級時不會突然跳動。";
var G_GF = "每根 K 線拆成買盤與賣盤（BG財報 的算法，跳空缺口併進當天的主方向）：收盤比昨收高的日子，買＝（開−低）＋（高−昨收）、賣＝（開−低）＋（高−收）；其餘日子，買＝（高−開）＋（收−低）、賣＝（高−開）＋（昨收−低）。買盤比例＝買 ÷（買＋賣），0～1。鎖漲停一字線是 1、鎖跌停是 0。";
var G_L0 = "<b>流動性母體（L0）</b>＝普通股、收盤 > 10 元、20 日平均成交金額 > 5,000 萬，而且不在 E 否決名單上。所有排名、百分位、共振分數都只在這一群裡比；太冷門的股票價格容易被少數單子推動，排名沒有意義。";
var G_E = "<b>E 否決名單</b>＝〔AI 選股〕的財報品質否決：財報八面（本業虧損、連兩季虧損、獲利靠業外、有獲利沒現金、應計比率偏高、負債快速上升、營收大幅衰退、董監高質押）加重大訊息四面，合計三面以上就擋掉。這裡直接沿用，被否決的不進漏斗。";
var G_IC = "<b>rank IC</b>（等級相關係數）＝每一週，把流動性母體裡每一檔的某個特徵排名，和它<b>之後 20 個交易日</b>的報酬排名算 Spearman 相關。+1＝特徵越高的之後漲越多、完全一致；0＝沒關係；負的＝反過來。股票市場裡平均 IC 在 ±0.02 左右算很弱，0.05 以上已經算強。";
var G_SCORE = "<b>共振分數</b>＝七個特徵各自在流動性母體裡的百分位（0～1），用權重加權平均（至少要有 4 個特徵有值），再取一次全市場百分位。0.95＝前 5%。七個特徵：外資投信 60 日買超 ÷ 資本額、法人 60 日買超排名 20 日進步、5,000 萬大戶持股比例四週增加、總股東人數四週減少、成交資金佔比排名 20 日進步、20 日成交金額 ÷ 資本額、買賣盤力道 20 日（貪婪 − 恐懼）。<br><b>權重</b>＝每個特徵過去各週的平均 rank IC，負的歸零；只用 20 日報酬已經實現的週，不到 8 週時等權。";
var G_PIL = "<b>三根柱子</b>（L1 要至少兩根）：① 法人：外資投信 60 日累計買超 > 0，且在全市場前 30%；② 大戶：5,000 萬大戶持股比例比四週前高；③ 股東：總股東人數比四週前少（籌碼往少數人集中）。";
var G_TIME = "<b>T1 趨勢成立</b>：收盤 > 60 日均線，且 20 日均線 > 60 日均線——精選的必要條件。<br><b>T2 蓄勢</b>：買賣盤力道 20 日（貪婪 1 − 恐懼 1）> 0，而且比五個交易日前更強——只標示，不是門檻。";
var G_FLAG = "<b>成長旗標</b>（L2，精選要兩面以上）：① 月營收創 12 個月新高且 3 個月累計年增 > 0（沒有的話，單月營收年增 > 20% 也算這一面）；② 近四季 EPS 年增 > 0；③ 單季 EPS 創近 4 季新高；④ 營益率創近 4 季新高。財報與營收都用那一天看得到的版本。";
var G_WARN = "<b>回檔警戒</b>：<br>・資金轉弱＝成交資金佔比的百分位比 20 天前掉 10 個百分點以上，而且 20 日成交金額變少；<br>・籌碼轉弱＝大戶比例連兩週下降，或（股東人數比四週前多、且法人 20 日賣超）。<br>兩邊都轉弱＝<b>高風險</b>、一邊＝<b>待觀察</b>、都穩＝<b>相對安心</b>。";
