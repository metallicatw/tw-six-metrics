{% extends "base.html.j2" %}
{% block title %}籌碼雷達｜{{ site_title }}{% endblock %}
{% block head_early %}
{# 先開始下載 radar.json（約 0.6 MB，壓縮後）——在樣式表之前，不等整頁解析完。
   @@CFV@@ 由 `twsix chipflow-site` 換成這一份資料的版本碼（見 chipflow/site.py 的
   stamp_page）：網址帶版本碼之後可以放心用瀏覽器快取，資料一換網址就換。沒有換到
   （例如本機只跑了 build）就退回每次都向伺服器確認的舊作法。 #}
<script>
window.CF_V = "@@CFV@@";
(function(){
  var v = window.CF_V.charAt(0) === "@" ? "" : window.CF_V;
  window.CF_URL = function(name){ return "chipflow/" + name + (v ? "?v=" + v : ""); };
  window.CF_OPT = v ? {} : {cache: "no-cache"};
  try { window.CF_EARLY = {"radar.json": fetch(window.CF_URL("radar.json"), window.CF_OPT)}; } catch (e) { window.CF_EARLY = {}; }
})();
</script>
{% endblock %}
{% block body %}
{# 〔籌碼雷達〕：十三項工具（①～⑬）＋精選漏斗＋指標驗證。編號對齊 BG財報〈會員工具使用手冊〉：
   ① 大戶籌碼看板（內部代號 t2）、② 個股籌碼多圖（t1）——內部代號沒換，是為了不讓外面既有的
   連結（#t1-2330 → 多圖）失效。
   這一頁不帶任何數字：全部由瀏覽器讀 chipflow/*.json（`twsix chipflow` 與
   `twsix chipflow-site` 產生，見 src/twsix/chipflow/）。樣式與程式都只在這一頁、
   以 .cf 為前綴，不動 site.css / site.js——壞了只影響這一頁。 #}
<style>
.cf{--cf-hl:#ffe45c;--cf-hl-ink:#1b1b00}
.cf h2 .cf-beta{font-size:12px;border:1px solid var(--rule);border-radius:999px;padding:1px 8px;margin-left:6px;color:var(--muted);vertical-align:middle}
.cf-note{color:var(--muted);font-size:13px;line-height:1.6}
.cf-tabs{display:flex;flex-wrap:nowrap;overflow-x:auto;gap:6px;margin:12px 0;padding-bottom:4px}
/* 每一顆分頁一個顏色（2026-09-28）：沒選中的是那個顏色的外框與字，選中的整顆填滿。
   同一個 --tc 也掛在對應的面板上，④⑤⑥「符合條件：N / M 檔」那一行用它上色。
   深色底換成亮一階的色調，選中那一顆用底色當字色（和 AI 選股頁的分頁同一套）。 */
.cf-tab{--tc:var(--accent);flex:0 0 auto;border:1.5px solid var(--tc);background:var(--surface);color:var(--tc);border-radius:999px;padding:5px 12px;font-size:13.5px;font-weight:700;cursor:pointer;white-space:nowrap}
.cf-tab:hover{background:var(--surface-2)}
.cf-tab[aria-selected=true]{background:var(--tc);border-color:var(--tc);color:#fff}
{% set cf_colors = [('t1','#d9480f','#ff8a5c'),('t2','#c2255c','#f783ac'),('t3','#2b8a3e','#69db7c'),
  ('t4','#1864ab','#6fb0f5'),('t5','#0b7285','#3bc9db'),('t6','#6741d9','#b39cff'),
  ('t7','#b25a00','#ffa94d'),('t8','#a61e4d','#faa2c1'),('t9','#5c7c00','#a9e34b'),
  ('t10','#087f5b','#38d9a9'),('t11','#862e9c','#e599f7'),('t12','#364fc7','#91a7ff'),
  ('t13','#9c6500','#ffc94d'),('picks','#c92a2a','#ff8787'),('val','#7a5230','#e0b084'),('about','#495057','#adb5bd')] %}
{% for k, c, d in cf_colors %}.cf-tab[data-t={{ k }}],#cf-{{ k }}{--tc:{{ c }}}
{% endfor %}@media (prefers-color-scheme:dark){
{% for k, c, d in cf_colors %}  :root:not([data-theme=light]) .cf-tab[data-t={{ k }}],:root:not([data-theme=light]) #cf-{{ k }}{--tc:{{ d }}}
{% endfor %}  :root:not([data-theme=light]) .cf-tab[aria-selected=true]{color:var(--ground)}
}
{% for k, c, d in cf_colors %}:root[data-theme=dark] .cf-tab[data-t={{ k }}],:root[data-theme=dark] #cf-{{ k }}{--tc:{{ d }}}
{% endfor %}:root[data-theme=dark] .cf-tab[aria-selected=true]{color:var(--ground)}
.cf-cnt{font-size:17px;font-weight:800;color:var(--tc,var(--accent));font-variant-numeric:tabular-nums;margin-right:4px}
.cf-card h4 .tip{margin-left:4px}
.cf-card h4 button.bulb{font-size:11px;padding:2px 6px}
.cf-card h4 .tipbox{font-weight:400}
.cf-gl dt{font-weight:700;margin-top:8px}
.cf-gl dd{margin:2px 0 0 1em;color:var(--ink-2);font-size:13.5px;line-height:1.65}
.cf-tab.cf-sep{margin-left:10px}
.cf-panel{display:none}
.cf-panel.on{display:block}
.cf-card{background:var(--surface);border:1px solid var(--rule);border-radius:12px;padding:10px 12px;margin:10px 0}
.cf-card h4{margin:0 0 4px;font-size:13.5px;display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}
.cf-card h4 .cf-tip{font-weight:400;color:var(--muted);font-variant-numeric:tabular-nums}
.cf-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:10px}
.cf-grid .cf-card{margin:0}
.cf-grp{margin:14px 0 4px;font-size:14px;color:var(--ink-2);border-left:4px solid var(--accent);padding-left:8px}
.cf svg{display:block;width:100%;height:auto;touch-action:none}
.cf-trail svg{max-width:780px;margin:0 auto}
.cf svg text{font-size:10px;fill:var(--muted)}
.cf-row{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:8px 0}
.cf input[type=text],.cf input[type=number],.cf select{border:1px solid var(--rule);background:var(--surface);color:var(--ink);border-radius:8px;padding:5px 8px;font-size:14px}
.cf input[type=number]{width:90px}
.cf button.cf-btn{border:1px solid var(--accent);background:var(--surface);color:var(--accent);border-radius:8px;padding:5px 12px;cursor:pointer;font-size:14px}
.cf button.cf-btn.pri{background:var(--accent);color:var(--surface)}
.cf-form{display:grid;grid-template-columns:repeat(auto-fill,minmax(320px,1fr));gap:6px 18px;margin:8px 0}
.cf-form label{display:flex;gap:6px;align-items:center;flex-wrap:wrap;font-size:13.5px}
.cf-form .cf-dis{opacity:.5}
.cf-tbl{width:100%;border-collapse:collapse;font-size:13px;font-variant-numeric:tabular-nums}
.cf-tbl th,.cf-tbl td{border-bottom:1px solid var(--rule);padding:4px 6px;text-align:right;white-space:nowrap}
/* 釘住的表頭要在最上層：收盤價旁的 Yahoo 圖示用了 CSS mask，mask 會自成一個疊放層，
   沒有 z-index 的話捲動時它會畫在表頭「收盤」兩個字上面。 */
.cf-tbl th{cursor:pointer;background:var(--surface-2);position:sticky;top:0;z-index:2}
.cf-tbl td.l,.cf-tbl th.l{text-align:left}
.cf-tbl a{cursor:pointer;color:var(--accent-2);text-decoration:underline}
.cf-tbl td.cf-px{white-space:nowrap}
.cf-tbl a.yf{text-decoration:none}
/* 名稱（→ ② 個股籌碼多圖，留在本頁）用虛線底線，和代號（→ 個股資訊頁，換頁）分得出來 */
.cf-tbl a[href^="#t1-"]{text-decoration-style:dotted}
.cf-scroll{overflow:auto;max-height:70vh;border:1px solid var(--rule);border-radius:8px}
.cf-badge{display:inline-block;border-radius:999px;padding:0 7px;font-size:11.5px;margin-left:3px;border:1px solid var(--rule)}
.cf-badge.pick{background:var(--accent);color:var(--surface);border-color:var(--accent)}
.cf-badge.l1{border-color:var(--accent-2);color:var(--accent-2)}
.cf-badge.veto{border-color:var(--up);color:var(--up)}
.cf-w-高風險{color:var(--up);font-weight:600}.cf-w-待觀察{color:#b25a00}.cf-w-相對安心{color:var(--down)}
.cf-kpi{display:flex;flex-wrap:wrap;gap:10px;margin:8px 0}
.cf-kpi div{background:var(--surface);border:1px solid var(--rule);border-radius:10px;padding:6px 12px;min-width:120px}
.cf-kpi b{display:block;font-size:18px}
.cf-rank td{min-width:64px;font-size:var(--cf-rank-fs,12px);text-align:left;cursor:pointer}
.cf-rank td.hl{background:var(--cf-hl);color:var(--cf-hl-ink);font-weight:600}
.cf-rank th.r,.cf-rank td.r{position:sticky;left:0;background:var(--surface-2);text-align:right;cursor:default}
.cf-rank td.r{z-index:1}
.cf-rank th.r{z-index:3}
/* minmax(0,1fr) 而不是 1fr：1fr 的下限是「內容的最小寬度」，裡面那張排名表有二十幾天、
   每格 64px，欄就被撐到一千多 px，整頁跟著變寬（手機上右邊一大片空白，2026-09-29）。
   下限設 0，寬的表格才會乖乖在自己的 .cf-scroll 裡橫向捲。 */
.cf-two{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:10px}
@media (max-width:760px){.cf-two{grid-template-columns:minmax(0,1fr)}}
.cf-panel,.cf-card{min-width:0}
.cf-chips{display:flex;flex-wrap:wrap;gap:6px}
.cf-chip{border:1px solid var(--rule);border-radius:999px;padding:2px 8px;font-size:13px;display:inline-flex;gap:6px;align-items:center}
.cf-chip i{width:10px;height:10px;border-radius:50%;display:inline-block}
.cf-chip button{border:0;background:none;color:var(--muted);cursor:pointer;font-size:14px}
.cf-quick{display:flex;flex-wrap:wrap;gap:4px;max-height:120px;overflow:auto}
.cf-quick button{border:1px solid var(--rule);background:var(--surface);color:var(--ink-2);border-radius:6px;padding:2px 6px;font-size:12px;cursor:pointer}
.cf-inds{display:flex;flex-wrap:wrap;gap:4px 12px;max-height:130px;overflow:auto;border:1px solid var(--rule);border-radius:8px;padding:6px;font-size:13px}
/* 營收變動說明：表格寬度固定在卡片寬，長句子（有時夾著很長的英文或數字）在格子裡折行，
   不把整頁撐寬（手機上 ③ 曾被撐到 587px，2026-09-29）。 */
.cf-notes{table-layout:fixed;min-width:0}   /* 全站表格預設 min-width:560px（site.css），這張不要 */
.cf-notes th:first-child,.cf-notes td:first-child{width:5.5em}
.cf-notes td{white-space:normal;text-align:left;overflow-wrap:anywhere}
.cf-err{color:var(--up);font-size:13.5px}
.cf-in{display:inline-flex;align-items:center;gap:4px;white-space:nowrap}
.cf-form label.cf-f{display:grid;grid-template-columns:minmax(0,1fr) auto;gap:4px 8px;align-items:center;border-bottom:1px dashed var(--rule);padding:3px 0}
.cf-form label.cf-fw{grid-template-columns:auto minmax(0,1fr)}
.cf-in.cf-wrap{flex-wrap:wrap;white-space:normal}
.cf-form label.cf-ck{display:grid;grid-template-columns:auto minmax(0,1fr) auto;gap:6px;align-items:center}
.cf-grp{grid-column:1/-1}
.cf-form select{max-width:100%}
.cf-err ul{margin:4px 0 0 1.2em;padding:0}
.cf input.cf-bad,.cf select.cf-bad{border-color:var(--up);box-shadow:0 0 0 2px color-mix(in srgb,var(--up) 25%,transparent)}
.cf-warn{color:#b25a00}
.cf-subs{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin:10px 0 6px;border-bottom:1px solid var(--rule);padding-bottom:6px}
.cf-subs button[role=tab]{border:1px solid var(--rule);background:var(--surface);color:var(--ink-2);border-radius:8px;padding:4px 12px;font-size:13.5px;cursor:pointer}
.cf-subs button[role=tab][aria-selected=true]{border-color:var(--tc,var(--accent));color:var(--tc,var(--accent));font-weight:700;box-shadow:inset 0 -2px 0 var(--tc,var(--accent))}
.cf-subs .cf-csv{margin-left:auto}
.cf-tbl td.cf-up{color:var(--up)}.cf-tbl td.cf-dn{color:var(--down)}
.cf-kpi b.cf-up{color:var(--up)}.cf-kpi b.cf-dn{color:var(--down)}
.cf-kpi4 div{flex:1 1 180px}
.cf-kpi .cf-note{display:block;font-size:12px}
.cf-tbl tr.cf-sum td{font-weight:700;background:var(--surface-2)}
.cf-hits td.d,.cf-hits th.d{min-width:40px;text-align:center;padding:3px 4px;font-size:12px}
.cf-hits td.hit{background:color-mix(in srgb,var(--muted) 18%,transparent);color:var(--ink)}
.cf-hits td.hit.cf-up{background:color-mix(in srgb,var(--up) 22%,transparent);color:var(--ink)}
.cf-hits td.hit.cf-dn{background:color-mix(in srgb,var(--down) 22%,transparent);color:var(--ink)}
.cf-hits th.fz,.cf-hits td.fz{position:sticky;left:0;background:var(--surface);z-index:1}
.cf-hits th.fz{z-index:3;background:var(--surface-2)}
.cf-names{max-width:520px;white-space:normal!important;line-height:1.5}
.cf-names summary{cursor:pointer}
.cf-dot{width:9px;height:9px;border-radius:50%;display:inline-block;margin-right:6px}
.cf-rcards{display:grid;grid-template-columns:repeat(auto-fill,minmax(min(300px,100%),1fr));gap:8px;margin:8px 0}
.cf-rcard{min-width:0;overflow-x:auto}
.cf-rcard{border:1px solid var(--rule);border-left:5px solid var(--accent);border-radius:10px;padding:6px 10px;background:var(--surface)}
.cf-mini{margin-top:4px;min-width:0!important}.cf-mini th,.cf-mini td{padding:2px 6px}
.cf-ex{display:flex;flex-wrap:wrap;gap:6px;margin:6px 0}
.cf dl dt{font-weight:600;margin-top:8px}.cf dl dd{margin:2px 0 0 1em;color:var(--ink-2);font-size:13.5px;line-height:1.6}
</style>

<div class="cf" id="cf">
<h2>籌碼雷達 <span class="cf-beta">試行</span></h2>
<p class="cf-note">法人 × 5,000 萬大戶 × 成交資金 × 買賣盤力道 × 基本面。十三項工具的設計參考 BG財報公開的方法，數字全部由本站用政府資料開放平臺（證交所、櫃買中心、集保結算所、公開資訊觀測站）自行計算。
<span id="cf-asof"></span></p>
<p class="cf-note" id="cf-msg">載入中…</p>

<div class="cf-tabs" role="tablist" id="cf-tabs">
  <button class="cf-tab" data-t="t2" role="tab">① 大戶籌碼</button>
  <button class="cf-tab" data-t="t1" role="tab">② 個股籌碼多圖</button>
  <button class="cf-tab" data-t="t3" role="tab">③ 基本面</button>
  <button class="cf-tab cf-sep" data-t="t4" role="tab">④ 籌碼篩選</button>
  <button class="cf-tab" data-t="t5" role="tab">⑤ 基本面篩選</button>
  <button class="cf-tab" data-t="t6" role="tab">⑥ 籌碼×基本面</button>
  <button class="cf-tab cf-sep" data-t="t7" role="tab">⑦ 排名軌跡</button>
  <button class="cf-tab" data-t="t8" role="tab">⑧ 多檔排名軌跡</button>
  <button class="cf-tab" data-t="t9" role="tab">⑨ 排名榜（單檔）</button>
  <button class="cf-tab" data-t="t10" role="tab">⑩ 排名榜（多檔）</button>
  <button class="cf-tab" data-t="t11" role="tab">⑪ 金額軌跡</button>
  <button class="cf-tab" data-t="t12" role="tab">⑫ 多檔金額軌跡</button>
  <button class="cf-tab cf-sep" data-t="t13" role="tab">⑬ 籌碼回測</button>
  <button class="cf-tab cf-sep" data-t="picks" role="tab">精選漏斗</button>
  <button class="cf-tab" data-t="val" role="tab">指標驗證</button>
  <button class="cf-tab" data-t="about" role="tab">說明</button>
</div>
<datalist id="cf-codes"></datalist>

<section class="cf-panel" id="cf-t1">
  <div class="cf-row"><input type="text" id="cf-q1" list="cf-codes" placeholder="代號或名稱，例如 2330"><button class="cf-btn pri" data-go="1">查詢</button><span class="cf-note">近 120 個交易日。</span></div>
  <div id="cf-o1"></div>
</section>
<section class="cf-panel" id="cf-t2">
  <div class="cf-row"><input type="text" id="cf-q2" list="cf-codes" placeholder="代號或名稱"><button class="cf-btn pri" data-go="2">查詢</button></div>
  <div id="cf-o2"></div>
</section>
<section class="cf-panel" id="cf-t3">
  <div class="cf-row"><input type="text" id="cf-q3" list="cf-codes" placeholder="代號或名稱"><button class="cf-btn pri" data-go="3">查詢</button></div>
  <div id="cf-o3"></div>
</section>

<section class="cf-panel" id="cf-t4">
  <p class="cf-note">先設條件，從全市場挑出符合的名單。留空 ＝ 不套用（排名填 9999 也一樣）；全部條件同時成立（AND）。大戶比例、股東人數、排名進步都跟「N 個交易日前」比，和 ⑬ 籌碼回測同一套口徑。「套用範例條件」只是示範操作方式，不是選股建議。</p>
  <div class="cf-form" id="cf4-f"></div>
  <div class="cf-row"><button class="cf-btn pri" data-run="4">開始篩選</button><button class="cf-btn" id="cf-sample">套用範例條件</button><button class="cf-btn" data-reset="4">清除條件</button><button class="cf-btn" data-csv="4">匯出 CSV</button></div>
  <div class="cf-err" id="cf-e4"></div>
  <div id="cf-s4"></div>
  <div id="cf-o4"></div>
</section>
<section class="cf-panel" id="cf-t5">
  <div class="cf-ex"><button class="cf-btn" data-ex5="1">範例① 營收動能</button><button class="cf-btn" data-ex5="2">範例② 獲利成長</button><button class="cf-btn" data-ex5="3">範例③ 創高動能</button><span class="cf-note" id="cf-x5">範例只是示範操作方式所預設的數值，不代表對任何產業或個股的推薦。</span></div>
  <p class="cf-note">留空 ＝ 不套用。月營收、EPS、利潤率取自官方全市場彙總；合約負債、存貨、資本支出取自個股季報（近八季）。金融保險業的損益科目不同，不在這些欄位裡。</p>
  <div class="cf-row"><b>產業</b><button class="cf-btn" id="cf-ind-all">全選</button><button class="cf-btn" id="cf-ind-none">全部取消</button></div>
  <div class="cf-inds" id="cf-inds"></div>
  <div class="cf-form" id="cf-f5"></div>
  <div class="cf-row"><b>動能訊號（創新高）</b></div>
  <div class="cf-form" id="cf-f5b"></div>
  <div class="cf-row"><button class="cf-btn pri" data-run="5">開始篩選</button><button class="cf-btn" data-reset="5">清除條件</button><button class="cf-btn" data-csv="5">匯出 CSV</button></div>
  <div id="cf-s5"></div>
  <div id="cf-o5"></div>
</section>
<section class="cf-panel" id="cf-t6">
  <p class="cf-note">把 ④ 的籌碼條件與 ⑤ 的基本面條件（含產業）同時套用。要改條件，到 ④、⑤ 兩頁改完再回來按「交集篩選」；或先點下面的範例。選一個「篩選日」，籌碼用那一天的值、基本面只用那一天<b>已經公布</b>的月營收與財報，不會用到當時還沒公布的資料。</p>
  <div class="cf-ex"><button class="cf-btn" data-ex6="1">範例① 偏籌碼面</button><button class="cf-btn" data-ex6="2">範例② 基本面成長</button><button class="cf-btn" data-ex6="3">範例③ 兩邊都要</button><span class="cf-note" id="cf-x6">範例會改寫 ④、⑤ 兩頁的條件；只是示範操作，不是選股建議。</span></div>
  <div class="cf-row"><label>篩選日 <select id="cf-d6"><option value="">最新</option></select></label><button class="cf-btn pri" data-run="6">交集篩選</button><button class="cf-btn" data-csv="6">匯出 CSV</button></div>
  <div class="cf-err" id="cf-e6"></div>
  <div id="cf-s6"></div>
  <div id="cf-o6"></div>
</section>

