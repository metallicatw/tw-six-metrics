@media (prefers-color-scheme:dark){:root:not([data-theme=light]) .gd-no,:root:not([data-theme=light]) .gl-cats button[aria-pressed=true]{color:var(--ground)}}
:root[data-theme=dark] .gd-no,:root[data-theme=dark] .gl-cats button[aria-pressed=true]{color:var(--ground)}
</style>

<div class="cf" id="cf">
{# 頁面標題和導覽列上目前那一顆重複，畫面上不再顯示（2026-10-04）；留給螢幕閱讀器與頁內大綱。 #}
