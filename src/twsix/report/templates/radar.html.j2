// 同一天流動性母體（旗標 1）的平均報酬與正報酬比例——「超額」的基準
function mktAt(d, n, adj){
  var key = d + ":" + n + ":" + (adj !== false);
  if (HS.mkt[key]) return HS.mkt[key];
  var sum = 0, cnt = 0, pos = 0;
  for (var s = 0; s < HS.nc; s++){
    var fl = hvi("fl", s, d); if (fl == null || !(fl & 1)) continue;
    var r = retAt(s, d, n, adj); if (r == null) continue;
    sum += r; cnt++; if (r >= 0) pos++;
  }
  return (HS.mkt[key] = {avg: cnt ? sum / cnt : null, win: cnt ? pos / cnt : null, n: cnt});
}

