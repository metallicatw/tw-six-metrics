  function fail(id, msg){ err.push(msg); bad.push(pre + "-" + id); }
  CF.forEach(function(x){
    if (!x.k || x.type === "prog") return;
    var v = num(x.k);
    if (v === null) return;
    if (isNaN(v)) return fail(x.k, x.t.replace(/[（(].*$/, "") + "：不是數字");
    if (x.type === "rank"){
      if (v < 1 || Math.floor(v) !== v) return fail(x.k, x.t.replace(/[（(].*$/, "") + "：名次要是 1 以上的整數");
      if (v >= 9999) return;          // 9999＝不用（和 BG 一樣）
    }
    if (x.type === "days" && (v < 1 || v > x.max || Math.floor(v) !== v)) return fail(x.k, x.t.replace(/[（(].*$/, "") + "：要填 1～" + x.max + " 的整數");
