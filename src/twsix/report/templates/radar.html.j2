// need: "b"＝只要最近一段（④⑥）；"ab"＝兩段都要（⑬）
function loadHist(need){
  if (need === "ab"){
    if (HS && HS.from === 0) return Promise.resolve(HS);
    if (!HS_WAIT.ab){
      HS_WAIT.ab = loadHist("b").then(function(){
        var h = HS.h;
        if (HS.from === 0 || h.split === 0){ HS.from = 0; return HS; }
        return getBin("hist_a.bin").then(function(u){ decodeInto(u, h.fields, HS.a, HS.nc, HS.nd, 0, h.split); HS.from = 0; return HS; });
      });
      HS_WAIT.ab.catch(function(){ delete HS_WAIT.ab; });
    }
    return HS_WAIT.ab;
  }
  if (HS) return Promise.resolve(HS);
  if (!HS_WAIT.b){
    HS_WAIT.b = histHead().then(function(h){
      return getBin("hist_b.bin").then(function(u){
        var nc = h.codes.length, nd = h.dates.length, arrs = {}, idx = {}, sc = {};
