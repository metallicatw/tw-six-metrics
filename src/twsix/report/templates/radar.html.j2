{% extends "base.html.j2" %}
{% from "_macros.html.j2" import tip %}
{% block title %}籌碼雷達｜{{ site_title }}{% endblock %}
{% block head_early %}
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=IBM+Plex+Mono:wght@400;500;600&family=IBM+Plex+Sans:wght@400;500;600;700&family=IBM+Plex+Sans+TC:wght@400;500;600;700&family=Noto+Sans+TC:wght@400;500;600;700;900&family=Noto+Serif+TC:wght@600&family=Source+Serif+4:wght@500;600&display=swap">
{# 先開始下載 radar.json（約 0.6 MB，壓縮後）——在樣式表之前，不等整頁解析完。
   @@CFV@@ 由 `twsix chipflow-site` 換成這一份資料的版本碼（見 chipflow/site.py 的
   stamp_page）：網址帶版本碼之後可以放心用瀏覽器快取，資料一換網址就換。沒有換到
   （例如本機只跑了 build）就退回每次都向伺服器確認的舊作法。 #}
<script>
window.CF_V = "@@CFV@@";
(function(){
  var v = window.CF_V.charAt(0) === "@" ? "" : window.CF_V;
  window.CF_URL = function(name){ return "chipflow/" + name + (v ? "?v=" + v : ""); };
  window.CF_OPT = v ? {} : {cache: "no-cache"};
  try { window.CF_EARLY = {"radar.json": fetch(window.CF_URL("radar.json"), window.CF_OPT)}; } catch (e) { window.CF_EARLY = {}; }
})();
</script>
{% endblock %}
{% block body %}
{# 〔籌碼雷達〕：十三項工具（①～⑬）＋精選漏斗＋指標驗證。①～⑬ 的版面是 BG財報 會員工具頁
   一比一移植（radar_bg/，由移植腳本產生：HTML 加 mN- 前綴、CSS 收進 #cf .bgN、程式包成
   CF_MODS.tN，資料改接 radar_bg/api.js 的轉接層）。內部代號 tN 與 BG 總覽的編號相同。
   這一頁不帶任何數字：全部由瀏覽器讀 chipflow/*.json（`twsix chipflow` 與
   `twsix chipflow-site` 產生，見 src/twsix/chipflow/）。樣式與程式都只在這一頁、
   以 .cf 為前綴，不動 site.css / site.js——壞了只影響這一頁。 #}
<style>
.cf{--cf-hl:#ffe45c;--cf-hl-ink:#1b1b00}
.cf-note{color:var(--muted);font-size:13px;line-height:1.6}
.cf-tabs{display:flex;flex-wrap:nowrap;overflow-x:auto;gap:6px;margin:12px 0;padding-bottom:4px}
/* 每一顆分頁一個顏色（2026-09-28）：沒選中的是那個顏色的外框與字，選中的整顆填滿。
   同一個 --tc 也掛在對應的面板上，④⑤⑥「符合條件：N / M 檔」那一行用它上色。
   深色底換成亮一階的色調，選中那一顆用底色當字色（和 AI 選股頁的分頁同一套）。 */
.cf-tab{--tc:var(--accent);--tk:color-mix(in srgb,var(--tc) 60%,#87909a);flex:0 0 auto;border:1.5px solid var(--tk);background:var(--surface);color:var(--tk);border-radius:999px;padding:5px 12px;font-size:13px;font-weight:600;cursor:pointer;white-space:nowrap}
.cf-tab:hover{background:var(--surface-2)}
.cf-tab[aria-selected=true]{background:var(--tk);border-color:var(--tk);color:#fff}
{% set cf_colors = [('t1','#d9480f','#ff8a5c'),('t2','#c2255c','#f783ac'),('t3','#2b8a3e','#69db7c'),
  ('t4','#1864ab','#6fb0f5'),('t5','#0b7285','#3bc9db'),('t6','#6741d9','#b39cff'),
  ('t7','#b25a00','#ffa94d'),('t8','#a61e4d','#faa2c1'),('t9','#5c7c00','#a9e34b'),
  ('t10','#087f5b','#38d9a9'),('t11','#862e9c','#e599f7'),('t12','#364fc7','#91a7ff'),
  ('t13','#9c6500','#ffc94d'),('picks','#c92a2a','#ff8787'),('val','#7a5230','#e0b084'),('guide','#2f4b7c','#8fb0e8'),('about','#495057','#adb5bd')] %}
{% for k, c, d in cf_colors %}.cf-tab[data-t={{ k }}],#cf-{{ k }}{--tc:{{ c }}}
{% endfor %}@media (prefers-color-scheme:dark){
{% for k, c, d in cf_colors %}  :root:not([data-theme=light]) .cf-tab[data-t={{ k }}],:root:not([data-theme=light]) #cf-{{ k }}{--tc:{{ d }}}
{% endfor %}  :root:not([data-theme=light]) .cf-tab[aria-selected=true]{color:var(--ground)}
}
{% for k, c, d in cf_colors %}:root[data-theme=dark] .cf-tab[data-t={{ k }}],:root[data-theme=dark] #cf-{{ k }}{--tc:{{ d }}}
{% endfor %}:root[data-theme=dark] .cf-tab[aria-selected=true]{color:var(--ground)}
.cf-card h4 .tip{margin-left:4px}
.cf-card h4 button.bulb{font-size:11px;padding:2px 6px}
.cf-card h4 .tipbox{font-weight:400}
.cf-gl dt{font-weight:700;margin-top:8px}
.cf-gl dd{margin:2px 0 0 1em;color:var(--ink-2);font-size:13.5px;line-height:1.65}
.cf-tab.cf-sep{margin-left:10px}
.cf-panel{display:none}
.cf-panel.on{display:block}
.cf-card{background:var(--surface);border:1px solid var(--rule);border-radius:12px;padding:10px 12px;margin:10px 0}
.cf-card h4{margin:0 0 4px;font-size:13.5px;display:flex;justify-content:space-between;gap:8px;flex-wrap:wrap}
.cf-card h4.cf-h-inline{justify-content:flex-start;align-items:center}
.cf-card h4 .cf-tip{font-weight:400;color:var(--muted);font-variant-numeric:tabular-nums}
.cf-grid{display:grid;grid-template-columns:repeat(auto-fill,minmax(300px,1fr));gap:10px}
.cf-grid .cf-card{margin:0}
.cf-grp{margin:14px 0 4px;font-size:14px;color:var(--ink-2);border-left:4px solid var(--accent);padding-left:8px}
/* 只給本頁自己的圖（指標驗證）；BG 各頁（.bgm）的 svg 照它們自己的樣式，不能被撐成 100% */
.cf svg:not(.bgm svg){display:block;width:100%;height:auto;touch-action:none}
.cf svg:not(.bgm svg) text{font-size:10px;fill:var(--muted)}
.cf input[type=text],.cf input[type=number],.cf select{border:1px solid var(--rule);background:var(--surface);color:var(--ink);border-radius:8px;padding:5px 8px;font-size:14px}
.cf input[type=number]{width:90px}
.cf-tbl{width:100%;border-collapse:collapse;font-size:13px;font-variant-numeric:tabular-nums}
.cf-tbl th,.cf-tbl td{border-bottom:1px solid var(--rule);padding:4px 6px;text-align:right;white-space:nowrap}
/* 釘住的表頭要在最上層：收盤價旁的 Yahoo 圖示用了 CSS mask，mask 會自成一個疊放層，
   沒有 z-index 的話捲動時它會畫在表頭「收盤」兩個字上面。 */
.cf-tbl th{cursor:pointer;background:var(--surface-2);position:sticky;top:0;z-index:2}
.cf-tbl td.l,.cf-tbl th.l{text-align:left}
.cf-tbl a{cursor:pointer;color:var(--accent-2);text-decoration:underline}
.cf-tbl td.cf-px{white-space:nowrap}
.cf-tbl a.yf{text-decoration:none}
/* 代號（→ ① 個股籌碼多圖，留在本頁）用虛線底線，和名稱（→ 個股資訊頁，換頁）分得出來 */
.cf-tbl a[href^="#t1-"]{text-decoration-style:dotted}
.cf-scroll{overflow:auto;max-height:70vh;border:1px solid var(--rule);border-radius:8px}
.cf-w-高風險{color:var(--up);font-weight:600}.cf-w-待觀察{color:#b25a00}.cf-w-相對安心{color:var(--down)}
.cf-kpi{display:flex;flex-wrap:wrap;gap:10px;margin:8px 0}
.cf-kpi div{background:var(--surface);border:1px solid var(--rule);border-radius:10px;padding:6px 12px;min-width:120px}
.cf-kpi b{display:block;font-size:18px}
/* minmax(0,1fr) 而不是 1fr：1fr 的下限是「內容的最小寬度」，裡面那張排名表有二十幾天、
   每格 64px，欄就被撐到一千多 px，整頁跟著變寬（手機上右邊一大片空白，2026-09-29）。
   下限設 0，寬的表格才會乖乖在自己的 .cf-scroll 裡橫向捲。 */

.cf-panel,.cf-card{min-width:0}
/* 營收變動說明：表格寬度固定在卡片寬，長句子（有時夾著很長的英文或數字）在格子裡折行，
   不把整頁撐寬（手機上 ③ 曾被撐到 587px，2026-09-29）。 */
   /* 全站表格預設 min-width:560px（site.css），這張不要 */

.cf-grp{grid-column:1/-1}
.cf-kpi .cf-note{display:block;font-size:12px}
/* ⑥ 籌碼 × 基本面雙向交叉檢索器：版面照 BG 同名工具（2026-09-29）。橘＝籌碼、藍＝基本面。 */

#x6-bthint{margin:8px 12px}
.cf dl:not(.bgm dl) dt{font-weight:600;margin-top:8px}.cf dl:not(.bgm dl) dd{margin:2px 0 0 1em;color:var(--ink-2);font-size:13.5px;line-height:1.6}
/* ── BG 13 個工具頁的樣式 ── 先把全站對元素的樣式（表格最小寬、h2 底線、p 最大寬、
   header.top 的底色……）在 .bgm 裡還原成瀏覽器預設，再疊上各頁自己的樣式
   （用 #cf 墊高權重、:where 不再加權；各頁樣式也收在 #cf .bgN 底下，所以一定蓋得過這條）。
   全站的 class 規則（.val、.kpi、.tag……）和 BG 各頁的 class 撞名也會滲進來，所以一律全部還原；
   svg 與裡面的元素除外——all:revert 會連 fill、stroke 這些屬性一起抹掉。 */
#cf .bgm :where(:not(svg, svg *)){all:revert}
/* Chrome 把 hidden 屬性當成「屬性樣式」，all:revert 會把它一起還原掉，要補回來（BG 自己有寫 display 的照樣蓋過去，和原頁一樣） */
#cf .bgm [hidden]{display:none}
#cf .bgm tr:hover{background:revert}
.bgm{margin:0 -4px;border-radius:12px;overflow:clip}
#cf .bgm .bg-err{color:#c92a2a;font-weight:600;padding:8px 12px}
#cf .bgm a.bg-t1,#cf .bgm a.bg-lk{color:inherit;text-decoration:underline;text-underline-offset:2px;cursor:pointer}
#cf .bgm a.bg-t1{text-decoration-style:dotted}
/* ①②③ 標題列（2026-10-10）：代號、名稱連個股頁；產業小標；☆ 加入觀察清單 */
#cf .bgm .bg-ind{display:inline-block;margin-left:8px;padding:1px 8px;border-radius:999px;font-size:12px;font-weight:600;
  color:var(--muted,#8a929b);border:1px solid var(--border,#2a2f36);vertical-align:middle;white-space:nowrap}
#cf .bgm button.bg-star{appearance:none;border:none;background:none;cursor:pointer;font-size:18px;line-height:1;
  margin-left:6px;padding:2px 5px;border-radius:6px;color:var(--muted,#8a929b);vertical-align:middle}
#cf .bgm button.bg-star.on{color:#f5b301}
#cf .bgm button.bg-star:hover{background:rgba(127,127,127,.15)}
/* ①② 縮放區間＋滑桿＋疊加股價（2026-10-10，和個股頁〔股價健診〕同一種操作） */
#cf .bgm .bg-rng-host{margin:10px 0 14px}
#cf .bgm .bg-rng{display:flex;flex-wrap:wrap;align-items:center;gap:6px;font-size:12.5px;color:var(--muted,#8a929b)}
#cf .bgm .bg-rng button{appearance:none;border:1px solid var(--border,#2a2f36);background:transparent;color:inherit;
  border-radius:7px;padding:4px 10px;font-size:12.5px;cursor:pointer;line-height:1.3}
#cf .bgm .bg-rng button.on{background:#4fb3c8;border-color:#4fb3c8;color:#0b1016;font-weight:600}
#cf .bgm .bg-rng button:disabled{opacity:.4;cursor:default}
#cf .bgm .bg-rng .px{margin-left:auto;display:inline-flex;align-items:center;gap:5px;cursor:pointer;color:var(--ink-2,inherit)}
#cf .bgm .bg-rng .px input{accent-color:#4fb3c8;width:15px;height:15px}
#cf .bgm .bg-rng-sl{position:relative;height:26px;margin:6px 0 2px}
#cf .bgm .bg-rng-sl input{position:absolute;left:0;right:0;top:0;width:100%;margin:0;height:26px;background:none;
  pointer-events:none;-webkit-appearance:none;appearance:none;accent-color:#4fb3c8}
#cf .bgm .bg-rng-sl input::-webkit-slider-thumb{pointer-events:auto;-webkit-appearance:none;width:16px;height:16px;border-radius:50%;
  background:#fff;border:3px solid #4fb3c8;cursor:pointer}
#cf .bgm .bg-rng-sl input::-moz-range-thumb{pointer-events:auto;width:12px;height:12px;border-radius:50%;background:#fff;border:3px solid #4fb3c8;cursor:pointer}
#cf .bgm .bg-rng-sl input::-webkit-slider-runnable-track{height:4px;background:#4fb3c8;border-radius:2px}
#cf .bgm .bg-rng-sl input+input::-webkit-slider-runnable-track{background:transparent}
#cf .bgm .bg-rng .px{font-weight:600;padding:3px 10px;border:1px solid #4fb3c8;border-radius:7px}
#cf .bgm label.bg3-px{display:inline-flex;align-items:center;gap:6px;margin:0 0 8px;padding:3px 10px;border:1px solid #4fb3c8;
  border-radius:7px;font-size:12.5px;font-weight:600;cursor:pointer}
#cf .bgm label.bg3-px input{accent-color:#4fb3c8;width:15px;height:15px}
#cf .bgm .bg-rng-note{margin:2px 0 0;font-size:12px;color:var(--muted,#8a929b)}
#cf .bgm a.bg-t1:hover,#cf .bgm a.bg-lk:hover{color:var(--accent-2)}
/* 全站的 .yf 被上面的還原抹掉了，在 BG 頁裡再寫一次（::before 的圖示不受影響） */
#cf .bgm a.yf{display:inline-flex;align-items:center;justify-content:center;width:18px;height:18px;margin-left:3px;vertical-align:-3px;border-radius:4px;color:var(--accent-2);border:1px solid var(--rule);background:var(--surface-2);text-decoration:none}
#cf .bgm a.yf:hover{border-color:var(--accent-2);background:var(--surface)}
/* 釘住的表頭要壓在 Yahoo 圖示上面（圖示用 CSS mask，會自成疊放層）；.bgm.bgm 是為了權重高過 BG 各頁的 thead th */
#cf .bgm.bgm thead th{z-index:3}
{% include "radar_bg/style.css" %}
/* 〔📖 使用手冊〕與〔指標查詢〕（2026-10-12） */
