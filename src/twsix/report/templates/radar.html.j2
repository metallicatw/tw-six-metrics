  document.querySelectorAll("[data-ex5]").forEach(function(b){ b.addEventListener("click", function(){ var ex = EX5[b.getAttribute("data-ex5")]; set5(ex); $("cf-x5").textContent = ex.t + "。範例只是示範操作方式所預設的數值，不代表推薦。"; run5(); }); });
  document.querySelectorAll("[data-ex6]").forEach(function(b){ b.addEventListener("click", function(){
    var ex = EX6[b.getAttribute("data-ex6")];
    setCond("cf4", ex.c); if (ex.f) set5(ex.f); else clear5();
    $("cf-x6").textContent = ex.t + "（已改寫 ④、⑤ 兩頁的條件；只是示範操作，不是選股建議）。";
    run6();
  }); });
  $("cf-run13").onclick = run13;
  $("cf-sample13").onclick = function(){ setCond("cf13", COND_SAMPLE); run13(); };
  $("cf-reset13").onclick = function(){ setCond("cf13", {}); $("cf13-dd").value = ""; showErr("cf-e13", []); };
  $("cf13-per").onchange = info13; $("cf13-n").onchange = info13;
  document.querySelectorAll("[data-reset]").forEach(function(b){ b.addEventListener("click", function(){ var n = b.getAttribute("data-reset"); if (n === "4"){ setCond("cf4", {}); showErr("cf-e4", []); } else clear5(); }); });
  $("cf-sample").onclick = function(){ setCond("cf4", COND_SAMPLE); run4(); };
  $("cf-clear9").onclick = function(){ mark9 = {}; draw9(); };
  $("cf-clear10").onclick = function(){ list10.length = 0; draw10(); };
  $("cf-o9").addEventListener("pick", function(e){ mark9 = {}; mark9[e.detail] = 1; $("cf-q9").value = label(e.detail); draw9(); });
  $("cf-o10").addEventListener("pick", function(e){ var i = list10.indexOf(e.detail); if (i >= 0) list10.splice(i, 1); else if (list10.length < 8) list10.push(e.detail); draw10(); });
  $("cf-s7").onchange = function(){ go("7"); };
  $("cf-s8").onchange = redraw8;
  $("cf-s11").onchange = function(){ go("11"); };
  $("cf-s12").onchange = redraw12;
  $("cf-r11").onchange = function(){ go("11"); };
  document.querySelectorAll(".cf-fs").forEach(function(sel){ sel.onchange = function(){ $(sel.getAttribute("data-for")).style.setProperty("--cf-rank-fs", sel.value); }; });
  $("cf-r12").onchange = redraw12;
  var h = (location.hash || "").replace("#", "").split("-");
  var tab = h[0] && document.querySelector('.cf-tab[data-t="' + h[0] + '"]') ? h[0] : "picks";
  open(tab, h[1] && ROWS[h[1]] ? h[1] : null);
}

// radar.json 按欄存（chipflow/site.py 的 pack_rows）：還原成一列一檔，null 的欄位略過
// ——和原本「沒有這個鍵」一樣，後面的程式不用分兩種。
function unpackRows(doc){
  if (!doc.cols) return doc;
  var keys = Object.keys(doc.cols), rows = new Array(doc.nrows);
  for (var i = 0; i < doc.nrows; i++){
    var r = {};
    for (var k = 0; k < keys.length; k++){ var v = doc.cols[keys[k]][i]; if (v != null) r[keys[k]] = v; }
    rows[i] = r;
  }
  delete doc.cols; doc.rows = rows;
  return doc;
}
getJSON("radar.json").then(function(doc){
  R = unpackRows(doc);
  R.rows.forEach(function(r){ ROWS[r.c] = r; BYNAME[r.n] = r.c; });
  // 代號清單（輸入框的下拉提示）一千九百多項：等第一次點進輸入框才建，不擋首頁顯示。
  var dl = $("cf-codes"), dlDone = false;
  document.addEventListener("focusin", function(e){
    if (dlDone || !e.target || e.target.getAttribute("list") !== "cf-codes") return;
    dlDone = true;
    var frag = document.createDocumentFragment();
    R.rows.forEach(function(r){ frag.appendChild(el("option", {value: r.c + " " + r.n})); });
    dl.appendChild(frag);
  });
  $("cf-asof").textContent = "資料日 " + R.asof + "（產生於 " + R.generated_at + "）。";
  $("cf-msg").textContent = "不構成任何投資建議；清單由公開資料自動產生，不代表推薦。";
  buildForms();
  init();
}).catch(function(){
  $("cf-msg").textContent = "還沒有資料：籌碼雷達的每日計算（twsix chipflow）尚未跑過，或這次建站沒有產生 chipflow/ 資料。下一次排程後會自動出現。";
  document.querySelectorAll(".cf-tab").forEach(function(b){ b.disabled = true; });
  $("cf-about").classList.add("on");
});
})();
</script>
