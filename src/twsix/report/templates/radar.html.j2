  getJSON("validate.json").then(function(v){
    o.innerHTML = "";
    o.appendChild(el("p", {cls: "cf-note", text: "每一週回頭算一次：七個特徵和「之後 " + v.fwd_days + " 個交易日報酬」的等級相關（rank IC），以及那一週照規則選出來的 L1、L1＋趨勢候選，之後 " + v.fwd_days + " 日平均報酬減去同週流動性母體平均（超額）。基本面與 E 否決不在回測裡。週與週的持有期互相重疊，t 值會偏高；期間短、以多頭為主，只能當參考，真正的驗證看精選日誌。"}));
    var t = el("table", {cls: "cf-tbl"});
    t.appendChild(el("tr", null, el("th", {cls: "l", text: "特徵"}), el("th", {text: "平均 IC"}), el("th", {text: "t 值"}), el("th", {text: "IC>0 週比例"}), el("th", {text: "週數"}), el("th", {text: "今天權重"})));
    Object.keys(v.features).forEach(function(k){ var f = v.features[k]; t.appendChild(el("tr", null, el("td", {cls: "l", text: f.text}), el("td", {text: fmt(f.mean, 4)}), el("td", {text: fmt(f.t, 2)}), el("td", {text: isnum(f.hit) ? fmt(f.hit * 100, 0) + "%" : "—"}), el("td", {text: String(f.n)}), el("td", {text: fmt(f.weight, 4)}))); });
    o.appendChild(el("div", {cls: "cf-card"}, el("h4", {text: "特徵有效性"}), t));
    var k = el("div", {cls: "cf-kpi"});
    [["L1 共振", v.l1], ["L1＋趨勢（T1）", v.l1t]].forEach(function(x){ var s = x[1] || {}; k.appendChild(el("div", null, x[0], el("b", {text: isnum(s.mean) ? (s.mean >= 0 ? "+" : "") + fmt(s.mean, 2) + "%" : "—"}), el("span", {cls: "cf-note", text: "平均 20 日超額；" + (s.weeks || 0) + " 週、勝週 " + (isnum(s.win) ? fmt(s.win * 100, 0) + "%" : "—")}))); });
    o.appendChild(k);
    var w = el("table", {cls: "cf-tbl"});
    w.appendChild(el("tr", null, el("th", {cls: "l", text: "集保週"}), el("th", {text: "母體"}), el("th", {text: "L1 檔數"}), el("th", {text: "L1 超額%"}), el("th", {text: "L1+T1 檔數"}), el("th", {text: "L1+T1 超額%"}), el("th", {text: "母體報酬%"})));
    v.weekly.forEach(function(r){ w.appendChild(el("tr", null, el("td", {cls: "l", text: r.week + (r.realized ? "" : "（未實現）")}), el("td", {text: String(r.universe)}), el("td", {text: String(r.l1.n)}), el("td", {text: fmt(r.l1.excess, 2)}), el("td", {text: String(r.l1t.n)}), el("td", {text: fmt(r.l1t.excess, 2)}), el("td", {text: fmt(r.market, 2)}))); });
    o.appendChild(el("div", {cls: "cf-card"}, el("h4", {text: "每週明細"}), el("div", {cls: "cf-scroll"}, w)));
  }).catch(function(e){ o.textContent = "讀不到驗證資料：" + e.message; });
