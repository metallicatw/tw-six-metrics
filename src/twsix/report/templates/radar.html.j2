function condEmpty(c){ return !Object.keys(c).some(function(k){ return ["liq", "t1", "noveto"].indexOf(k) < 0; }); }
function condLook(c){   // 這組條件最多要往回看幾天
  var m = 0;
  ["hpn", "shn", "pkn"].forEach(function(k){ if (c[k]) m = Math.max(m, c[k]); });
  if (c.texc != null || c.ftc != null || c.d20c != null || c.d60c != null) m = Math.max(m, 20);
  if (c.win) m = Math.max(m, c.win - 1);
