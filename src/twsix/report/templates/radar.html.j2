// ── 逐日歷史（④⑥⑬ 共用；資料見 chipflow/history.py）──────────────────────
// hist.json 是表頭；hist_a.bin（較舊）與 hist_b.bin（最近 80 天）是 gzip 過的
// 「欄位 × 個股 × 日期」序列：逐日差分、zigzag、varint，缺值是 int32 最小值。
// ④⑥ 只要最近那一段；⑬ 兩段都要。瀏覽器內建的 DecompressionStream 負責解壓。
var HS = null, HS_HEAD = null, HS_WAIT = {}, FD = null, FD_WAIT = null;
var SENT = -2147483648;
function gunzip(buf){
  var u = new Uint8Array(buf);
  if (u.length < 2 || u[0] !== 0x1f || u[1] !== 0x8b) return Promise.resolve(u);   // 伺服器已經解開了
  if (typeof DecompressionStream === "undefined") return Promise.reject(new Error("這個瀏覽器太舊，不支援解壓縮（請更新瀏覽器）"));
  return new Response(new Blob([u]).stream().pipeThrough(new DecompressionStream("gzip"))).arrayBuffer().then(function(b){ return new Uint8Array(b); });
}
function getBin(name){
  return fetch(window.CF_URL ? window.CF_URL(name) : BASE + name, window.CF_OPT || {cache: "no-cache"}).then(function(r){
    if (!r.ok) throw new Error(name + " " + r.status);
    return r.arrayBuffer();
  }).then(gunzip);
}
function histHead(){ return HS_HEAD || (HS_HEAD = getJSON("hist.json")); }
// 一條序列：varint → zigzag → 逐日累加（int32 環繞），寫進 A[base…base+len)，回傳讀到哪
function readSeq(u, pos, A, base, len){
  var prev = 0;
  for (var j = 0; j < len; j++){
    var byte = u[pos++], x = byte & 127, mul = 128;
    while (byte >= 128){ byte = u[pos++]; x += (byte & 127) * mul; mul *= 128; }
    prev = (prev + ((x % 2 === 1) ? -((x + 1) / 2) : x / 2)) | 0;   // x 可能大於 2^31，用浮點數算
    A[base + j] = prev;
  }
  return pos;
}
// 把一段（a～b 天）解進 arrs[欄位][個股 × 總天數]
function decodeInto(u, fields, arrs, nc, nd, a, b){
  var pos = 0;
  for (var f = 0; f < fields.length; f++){
    var A = arrs[fields[f][0]];
    for (var s = 0; s < nc; s++) pos = readSeq(u, pos, A, s * nd + a, b - a);
  }
}
// need: "b"＝只要最近一段（④⑥）；"ab"＝兩段都要（⑬）
function loadHist(need){
  if (need === "ab"){
    if (HS && HS.from === 0) return Promise.resolve(HS);
    if (!HS_WAIT.ab){
      HS_WAIT.ab = loadHist("b").then(function(){
        var h = HS.h;
        if (HS.from === 0 || h.split === 0){ HS.from = 0; return HS; }
        return getBin("hist_a.bin").then(function(u){ decodeInto(u, h.fields, HS.a, HS.nc, HS.nd, 0, h.split); HS.from = 0; return HS; });
      });
      HS_WAIT.ab.catch(function(){ delete HS_WAIT.ab; });
    }
    return HS_WAIT.ab;
  }
  if (HS) return Promise.resolve(HS);
  if (!HS_WAIT.b){
    HS_WAIT.b = histHead().then(function(h){
      return getBin("hist_b.bin").then(function(u){
        var nc = h.codes.length, nd = h.dates.length, arrs = {}, idx = {}, sc = {};
        h.fields.forEach(function(f){ arrs[f[0]] = new Int32Array(nc * nd).fill(SENT); sc[f[0]] = f[1]; });
        h.codes.forEach(function(c, i){ idx[c] = i; });
        decodeInto(u, h.fields, arrs, nc, nd, h.split, nd);
        HS = {h: h, dates: h.dates, codes: h.codes, idx: idx, nc: nc, nd: nd, a: arrs, sc: sc, from: h.split, adj: h.adj || {}, whales: h.whales || [], mkt: {}};
        return HS;
      });
    });
    HS_WAIT.b.catch(function(){ delete HS_WAIT.b; });
  }
  return HS_WAIT.b;
}
function hv(k, s, d){ var v = HS.a[k][s * HS.nd + d]; return v === SENT ? null : v / HS.sc[k]; }
function hvi(k, s, d){ var v = HS.a[k][s * HS.nd + d]; return v === SENT ? null : v; }   // 整數（排名、旗標）
// 第 d 天收盤買、第 d+n 天收盤賣的報酬（%）。adj＝乘回除權息（和 AI 選股同一套還原報酬）。
function retAt(s, d, n, adj){
  var j = d + n;
  if (j > HS.nd - 1) return null;
  var p0 = hv("cl", s, d);
  if (p0 == null || p0 <= 0) return null;
  var p1 = null;
  for (var k = j; k > d; k--){ p1 = hv("cl", s, k); if (p1 != null) break; }
  if (p1 == null) return null;
  var f = 1;
  if (adj !== false){ var ev = HS.adj[HS.codes[s]]; if (ev) for (var e = 0; e < ev.length; e++){ if (ev[e][0] > d && ev[e][0] <= k) f *= ev[e][1]; } }
  return (p1 / p0 * f - 1) * 100;
}

// ── 基本面的「那一天看得到的」版本（⑤ 24 個月回測、⑥ 篩選日）───────────────
function loadFund(){
  if (FD) return Promise.resolve(FD);
  if (FD_WAIT) return FD_WAIT;
  FD_WAIT = histHead().then(function(h){
    var fh = h.fund; if (!fh) throw new Error("沒有基本面歷史");
    return getBin("fund.bin").then(function(u){
      var nc = fh.codes.length, blocks = {ann: fh.ann, days: fh.days}, pos = 0, out = {};
      ["ann", "days"].forEach(function(b){
        var nd = blocks[b].length, arrs = {};
        fh.fields.forEach(function(f){ arrs[f[0]] = new Int32Array(nc * nd); });
        for (var f = 0; f < fh.fields.length; f++){
          var A = arrs[fh.fields[f][0]];
          for (var s = 0; s < nc; s++) pos = readSeq(u, pos, A, s * nd, nd);
        }
        out[b] = {dates: blocks[b], nd: nd, a: arrs};
      });
      var idx = {}; fh.codes.forEach(function(c, i){ idx[c] = i; });
      var sc = {}; fh.fields.forEach(function(f){ sc[f[0]] = f[1]; });
      FD = {h: fh, codes: fh.codes, idx: idx, nc: nc, sc: sc, ann: out.ann, days: out.days, months: fh.months || []};
      return FD;
    });
  });
  FD_WAIT.catch(function(){ FD_WAIT = null; });
  return FD_WAIT;
}
var FUND_PCT = {r1: 1, r3: 1, r12: 1, e4y: 1, oy: 1, om: 1, nm: 1, cl_rev: 1, cl_rv: 1, cl_cap: 1, cx_cap: 1, inv_rev: 1, r20: 1, r60: 1};
// 第 s 檔在 block（FD.ann 或 FD.days）第 j 期的基本面，欄位單位和 radar 列一樣（百分比已 × 100）
function fundRow(block, s, j){
  var c = FD.codes[s], base = ROWS[c] || {c: c, n: c}, r = {c: c, n: base.n, ind: base.ind, mk: base.mk};
  FD.h.fields.forEach(function(f){
    var v = block.a[f[0]][s * block.nd + j];
    if (v === SENT) return;
    r[f[0]] = f[0] === "fg" ? v : (FUND_PCT[f[0]] ? v / f[1] * 100 : v / f[1]);
  });
  (FD.h.flags || []).forEach(function(k, b){ if ((r.fg || 0) & (1 << b)) r[k] = 1; });
  r.p = r.p0;
  return r;
}

// ── 分頁與事件 ─────────────────────────────────────────────────────────
var done = {};
function open(tab, code, focus){
  document.querySelectorAll(".cf-tab").forEach(function(b){ b.setAttribute("aria-selected", b.getAttribute("data-t") === tab ? "true" : "false"); });
  // 分頁列在手機上橫向捲：點了哪一顆就停在原處，不把整列拉回最左邊；只有選中的那一顆
  // 被切到一半（或網址 #t12 直接開、它在畫面外）時才捲，而且只捲到剛好露出來。
  var bar = $("cf-tabs"), cur = bar.querySelector('.cf-tab[data-t="' + tab + '"]');
  if (cur){
    var bb = bar.getBoundingClientRect(), cb = cur.getBoundingClientRect();
    if (cb.left < bb.left) bar.scrollLeft -= (bb.left - cb.left) + 8;
    else if (cb.right > bb.right) bar.scrollLeft += (cb.right - bb.right) + 8;
  }
  document.querySelectorAll(".cf-panel").forEach(function(p){ p.classList.toggle("on", p.id === "cf-" + tab); });
  if (history.replaceState) history.replaceState(null, "", "#" + tab + (code ? "-" + code : ""));
  if (tab === "picks" && !done.picks){ done.picks = 1; showPicks(); }
  if (tab === "val" && !done.val){ done.val = 1; showVal(); }
  if (CF_MODS[tab]){
    bgBoot(tab);
    if (code) bgShow(tab, code, focus);
  }
}
// 帶 #t1-2330-gf 進來（個股頁、清單上的名稱）：① 畫好之後捲到〔貪婪恐懼〕那一組
function bgFocus(tab, code, focus){
  if (tab !== "t1" || focus !== "gf") return;
  var tries = 0;
  (function wait(){
    var bar = document.getElementById("m1-sbCode"), sec = document.querySelector('#m1-grid .section[data-grp="d"]');
    var ready = bar && bar.textContent.indexOf(code) >= 0 && sec && !document.getElementById("m1-grid").hidden;
    if (ready){ setTimeout(function(){ sec.scrollIntoView({block: "start"}); }, 120); return; }
    if (++tries < 60) setTimeout(wait, 150);
  })();
}
var done = {};
// 從別的地方帶一檔進來（表格裡的名稱、網址 #t1-2330）：填進那個分頁的輸入框再按查詢
function bgShow(tab, code, focus){
  var root = document.querySelector("#cf-" + tab + " .bgm"); if (!root) return;
  var n = tab.slice(1), inp = {t1: "codeInput", t2: "stockInput", t3: "search", t7: "code", t11: "code"}[tab];
  var go = {t1: "searchBtn", t2: "goBtn", t7: "go", t11: "go"}[tab];
  if (!inp) return;
  // 移植的程式第一次打開要先讀索引，等一下再帶入（已經開過的分頁幾乎立刻就好）
  setTimeout(function(){
    var i = document.getElementById("m" + n + "-" + inp); if (!i) return;
    if (tab === "t3"){ i.value = code; i.dispatchEvent(new Event("input")); i.dispatchEvent(new KeyboardEvent("keydown", {key: "Enter"})); return; }
    i.value = tab === "t1" ? code : code + " " + ((ROWS[code] || {}).n || "");  // ① 只認代號或名稱
    var b = document.getElementById("m" + n + "-" + go); if (b) b.click();
    bgFocus(tab, code, focus);
  }, BG_BOOTED[tab] === 2 ? 50 : 1500);
  BG_BOOTED[tab] = 2;
}

function init(){
  // ①～⑬ 表格裡的代號／名稱／Yahoo 圖示（bgCode / bgName / bgYf）：捕捉階段先攔，
  // 不讓那一列原本的點擊（例如 ⑬ 點列看走勢）同時觸發
  $("cf").addEventListener("click", function(e){
