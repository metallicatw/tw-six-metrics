// ── 分頁與事件 ─────────────────────────────────────────────────────────
var done = {};
function open(tab, code){
  document.querySelectorAll(".cf-tab").forEach(function(b){ b.setAttribute("aria-selected", b.getAttribute("data-t") === tab ? "true" : "false"); });
  document.querySelectorAll(".cf-panel").forEach(function(p){ p.classList.toggle("on", p.id === "cf-" + tab); });
  if (history.replaceState) history.replaceState(null, "", "#" + tab + (code ? "-" + code : ""));
  var n = tab.replace("t", "");
  if (code && $("cf-q" + n)){ $("cf-q" + n).value = label(code); go(n); }
  if (!done[tab]){
    done[tab] = 1;
    if (tab === "picks") showPicks();
    if (tab === "val") showVal();
    if (tab === "t9") draw9();
    if (tab === "t10") draw10();
    if (tab === "t11") quick11();
    if (!code && ["t1", "t2", "t3", "t7"].indexOf(tab) >= 0){ var q = $("cf-q" + n); if (!q.value){ q.value = label(R.picks && R.picks[0] || "2330"); go(n); } }
  }
}
function go(n){
  var code = resolve($("cf-q" + n).value);
  if (!code) return;
  if (n === "1") show1(code); else if (n === "2") show2(code); else if (n === "3") show3(code);
  else if (n === "7") rankTrail($("cf-o7"), [code], $("cf-s7").value);
  else if (n === "9"){ mark9 = {}; mark9[code] = 1; draw9(); }
  else if (n === "11") amountTrail($("cf-o11"), [code], $("cf-s11").value, true);
}
function add(n){
  var code = resolve($("cf-q" + n).value), list = multi[n];
  if (!code || list.indexOf(code) >= 0) return;
  if (list.length >= 8){ alert("最多 8 檔"); return; }
  list.push(code); $("cf-q" + n).value = "";
  if (n === "8") redraw8(); else if (n === "10") draw10(); else redraw12();
}
function quick11(){
  var a = R.rows.filter(function(r){ return isnum(r.fa); }).sort(function(x, y){ return y.fa - x.fa; }).slice(0, 50);
  var b = R.rows.filter(function(r){ return isnum(r.va); }).sort(function(x, y){ return y.va - x.va; }).slice(0, 50);
  [[a, "cf-qa"], [b, "cf-qb"]].forEach(function(p){
    var box = $(p[1]); box.innerHTML = "";
    p[0].forEach(function(r, i){ var btn = el("button", {text: (i + 1) + ". " + r.n}); btn.onclick = function(){ $("cf-q11").value = label(r.c); go("11"); }; box.appendChild(btn); });
  });
}

function init(){
  document.querySelectorAll(".cf-tab").forEach(function(b){ b.addEventListener("click", function(){ open(b.getAttribute("data-t")); }); });
  document.querySelectorAll("[data-go]").forEach(function(b){ b.addEventListener("click", function(){ go(b.getAttribute("data-go")); }); });
  document.querySelectorAll("[data-add]").forEach(function(b){ b.addEventListener("click", function(){ add(b.getAttribute("data-add")); }); });
  ["1", "2", "3", "7", "9", "11"].forEach(function(n){ $("cf-q" + n).addEventListener("keydown", function(e){ if (e.key === "Enter") go(n); }); });
  ["8", "10", "12"].forEach(function(n){ $("cf-q" + n).addEventListener("keydown", function(e){ if (e.key === "Enter") add(n); }); });
  document.querySelectorAll("[data-run]").forEach(function(b){ b.addEventListener("click", function(){ var n = b.getAttribute("data-run"); if (n === "4") run4(); else if (n === "5") run5(); else run6(); }); });
  document.querySelectorAll("[data-reset]").forEach(function(b){ b.addEventListener("click", function(){ var n = b.getAttribute("data-reset"); document.querySelectorAll("#cf-t" + n + " input[type=number]").forEach(function(i){ i.value = ""; }); document.querySelectorAll("#cf-f5b input").forEach(function(i){ if (n === "5") i.checked = false; }); }); });
  $("cf-sample").onclick = function(){ sample4(); run4(); };
  $("cf-sample6").onclick = function(){ sample4(); run6(); };
  $("cf-clear9").onclick = function(){ mark9 = {}; draw9(); };
  $("cf-clear10").onclick = function(){ list10.length = 0; draw10(); };
  $("cf-o9").addEventListener("pick", function(e){ mark9 = {}; mark9[e.detail] = 1; $("cf-q9").value = label(e.detail); draw9(); });
  $("cf-o10").addEventListener("pick", function(e){ var i = list10.indexOf(e.detail); if (i >= 0) list10.splice(i, 1); else if (list10.length < 8) list10.push(e.detail); draw10(); });
  $("cf-s7").onchange = function(){ go("7"); };
  $("cf-s8").onchange = redraw8;
  $("cf-s11").onchange = function(){ go("11"); };
  $("cf-s12").onchange = redraw12;
  var h = (location.hash || "").replace("#", "").split("-");
  var tab = h[0] && document.querySelector('.cf-tab[data-t="' + h[0] + '"]') ? h[0] : "picks";
  open(tab, h[1] && ROWS[h[1]] ? h[1] : null);
}

getJSON("radar.json").then(function(doc){
  R = doc;
  R.rows.forEach(function(r){ ROWS[r.c] = r; BYNAME[r.n] = r.c; if (isnum(r.hr)) has15 = true; });
  var dl = $("cf-codes");
  R.rows.forEach(function(r){ dl.appendChild(el("option", {value: r.c + " " + r.n})); });
  $("cf-asof").textContent = "資料日 " + R.asof + "（產生於 " + R.generated_at + "）。";
  $("cf-msg").textContent = "不構成任何投資建議；清單由公開資料自動產生，不代表推薦。";
  buildForms();
  init();
}).catch(function(){
  $("cf-msg").textContent = "還沒有資料：籌碼雷達的每日計算（twsix chipflow）尚未跑過，或這次建站沒有產生 chipflow/ 資料。下一次排程後會自動出現。";
  document.querySelectorAll(".cf-tab").forEach(function(b){ b.disabled = true; });
  $("cf-about").classList.add("on");
});
})();
</script>
