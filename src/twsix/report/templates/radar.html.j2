      fmtx: function(v){ return isnum(v) ? fmt(v, 1) + " 億" : "—"; }, fmty: function(v){ return isnum(v) ? fmt(v, 1) + " 億" : "—"; }, autoplay: autoplay});
    if (!lg){ /* 線性刻度時自動取刻度 */ }
