        for (var f = 0; f < fh.fields.length; f++){
          var A = arrs[fh.fields[f][0]];
          for (var s = 0; s < nc; s++) pos = readSeq(u, pos, A, s * nd, nd);
        }
        out[b] = {dates: blocks[b], nd: nd, a: arrs};
      });
      var idx = {}; fh.codes.forEach(function(c, i){ idx[c] = i; });
      var sc = {}; fh.fields.forEach(function(f){ sc[f[0]] = f[1]; });
      FD = {h: fh, codes: fh.codes, idx: idx, nc: nc, sc: sc, ann: out.ann, days: out.days, months: fh.months || []};
      return FD;
    });
  });
