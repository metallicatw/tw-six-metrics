{% extends "base.html.j2" %}
{% from "_macros.html.j2" import row, table_head, tip, price_note %}
{% block title %}台股觀察清單 — {{ site_title }}{% endblock %}
{% block body %}
<h2>台股觀察清單</h2>
{# 這一頁和〔評等清單〕是同一張表，只是預設只顯示加過星的那幾列。
   為什麼不在建站時就只放那幾列：清單存在讀者自己的瀏覽器裡，建站的時候我們
   不知道、也不該知道他標了哪幾檔。所以整張表都送過去，由瀏覽器自己篩。 #}
<p class="muted">
  你在這台瀏覽器上標記的股票，共 <span id="tally">0 檔</span>。
  清單只存在本機（localStorage），不會上傳，也不會進到這個網站的原始碼裡——
  換一台電腦要重新加。
  {% call tip() %}{{ price_note() }}
  {% endcall %}
</p>
<div class="filters">
  <input id="q" type="search" placeholder="在觀察清單裡篩選" aria-label="篩選">
</div>
<p id="watch-empty" class="note" hidden>
  還沒有標記任何股票。到<a href="{{ rel }}index.html">評等清單</a>，
  按每一列最左邊的 ☆ 就會加進來。
</p>
{# `prices=True`：收盤價、日漲跌、5 日、20 日漲跌四欄（產業右邊）只在這一頁。
   `compact`：這一頁的欄位比〔評等清單〕多四欄，留白與次要資訊的字級收小，
   讓 1280 以上的桌機不必橫向捲（見 site.css 的 #t.compact）。 #}
<div class="scroll wide"><table id="t" class="compact" data-watchlist="1">
{{ table_head(prices=True, price_date=price_date) }}
<tbody>{% for r in rows %}{{ row(r, rel, rich_ids, fetched_at, prices=True, price_date=price_date, ai=ai_marks) }}{% endfor %}</tbody>
</table></div>
{% endblock %}
