<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ site_title }}{% endblock %}</title>
<style>
:root{
  --ground:#f4f6f8; --surface:#fff; --surface-2:#eaeef2;
  --ink:#111820; --ink-2:#3b4854; --muted:#6a7885;
  --rule:#d9e0e6; --accent:#0e5a52; --accent-2:#12766b;
  --up:#ae2b1e; --down:#146b47;
  --g4:#0d5348; --g3:#2c7a6c; --g2:#5a6b74; --g1:#92682a; --g0:#8f3b2c;
  --badge-ink:#fff;
  /* 河流圖分區底色：只是背景，每一區另有虛線與右側名稱，顏色不單獨承載意義 */
  --zone-0:#d5e9e1; --zone-1:#e3f0e8; --zone-2:#e9eef2;
  --zone-3:#f6ead0; --zone-4:#f4dcd2; --zone-5:#eec9bf;
}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]){
  --ground:#0d1116; --surface:#151b21; --surface-2:#1c232a;
  --ink:#e5ebf1; --ink-2:#b2bec9; --muted:#84919e;
  --rule:#273038; --accent:#57c4b4; --accent-2:#79d4c6;
  --up:#e4695b; --down:#4eb884;
  --g4:#6fd3c2; --g3:#43a795; --g2:#8e9aa4; --g1:#d0a44e; --g0:#e07a63;
  --badge-ink:#10161c;
  --zone-0:#1b423a; --zone-1:#1c3630; --zone-2:#242c34;
  --zone-3:#3a3122; --zone-4:#432c22; --zone-5:#4d2a20;
}}
*{box-sizing:border-box}
body{margin:0;background:var(--ground);color:var(--ink);
  font:15px/1.55 "Noto Sans TC","PingFang TC","Microsoft JhengHei",system-ui,sans-serif;
  -webkit-font-smoothing:antialiased}
a{color:var(--accent-2);text-underline-offset:2px}
a:focus-visible{outline:2px solid var(--accent-2);outline-offset:2px}
.wrap{max-width:1240px;margin:0 auto;padding:0 20px 44px}
header.top{background:var(--surface);border-bottom:1px solid var(--rule);margin-bottom:14px}
header.top .in{max-width:1240px;margin:0 auto;padding:12px 20px 10px}
header.top h1{margin:0;font-size:17px;letter-spacing:-.01em}
header.top h1 a{color:inherit;text-decoration:none}
nav{display:flex;gap:16px;flex-wrap:wrap;margin-top:6px;font-size:13px}
nav a{color:var(--ink-2);text-decoration:none}
nav a[aria-current=page]{color:var(--accent-2);font-weight:600}
.stamp{font-size:11.5px;color:var(--muted);margin-top:6px;font-variant-numeric:tabular-nums}
.stamp:empty{display:none}
.linkish{appearance:none;border:none;background:none;padding:0;font:inherit;
  font-size:11.5px;color:var(--accent-2);cursor:pointer;text-decoration:underline;
  text-underline-offset:2px}
h2{font-size:18px;margin:22px 0 10px;padding-bottom:6px;border-bottom:2px solid var(--ink)}
h3{font-size:15px;margin:16px 0 6px}
h4{margin:14px 0 6px}
p{margin:0 0 10px;max-width:78ch}
.muted{color:var(--muted);font-size:12.5px}
.scroll{overflow-x:auto;border:1px solid var(--rule);border-radius:5px;background:var(--surface);margin-bottom:14px}
table{border-collapse:collapse;width:100%;font-size:12.5px;min-width:560px}
/* 對齊規則只有兩條，套在所有表格上：
   文字靠左、數字靠右，而標題永遠跟著它那一欄的內容走。
   標題置中、數字置左那種混搭，是掃一欄數字時最花眼力的排版。 */
th,td{padding:5px 10px;text-align:left;border-bottom:1px solid var(--rule);
  white-space:nowrap;vertical-align:baseline}
th.num,thead th.num,td.series{text-align:right}
thead th{background:var(--surface-2);font-size:12px;font-weight:600;color:var(--ink-2);position:sticky;top:0}
tbody tr:last-child td{border-bottom:none}
tbody tr:hover{background:var(--surface-2)}
td.num{text-align:right;font-variant-numeric:tabular-nums;
  font-family:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace}
.g{display:inline-block;min-width:26px;text-align:center;padding:1px 6px;border-radius:3px;
  font-size:12px;font-weight:600;color:var(--badge-ink);font-family:ui-monospace,Menlo,monospace}
.g-AA{background:var(--g4)}.g-A{background:var(--g3)}.g-BB{background:var(--g2)}
.g-B{background:var(--g1)}.g-C{background:var(--g0)}
.g-na{background:transparent;color:var(--muted);border:1px solid var(--rule)}
.pick{color:var(--accent-2);font-weight:600}
.up{color:var(--up)}.down{color:var(--down)}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:1px;
  background:var(--rule);border:1px solid var(--rule);border-radius:5px;overflow:hidden;margin-bottom:14px}
.card{background:var(--surface);padding:10px 14px}
.card b{display:block;font-size:21px;color:var(--accent);line-height:1.2;
  font-family:ui-monospace,Menlo,monospace;font-variant-numeric:tabular-nums}
.card span{display:block;font-size:11.5px;color:var(--muted);margin-top:3px}
footer{margin-top:28px;padding-top:12px;border-top:1px solid var(--rule);
  font-size:12.5px;color:var(--muted)}
/* -- 頁首個股搜尋 ----------------------------------------------------- */
.find{position:relative;margin:10px 0 0;max-width:520px}
/* 搜尋框與「抓取」同一列。抓取這個動作的對象永遠是框裡那一檔，兩者分開放
   （例如按鈕留在頁面底部）就得先讓讀者自己把它們連起來——而那正是上一版
   最常被按錯的地方。 */
.findrow{display:flex;gap:8px;align-items:stretch}
.findrow input{flex:1 1 auto;min-width:0}
.findrow .btn-grab{flex:0 0 auto;white-space:nowrap;font-size:13px;padding:0 14px}
.find input{width:100%;padding:8px 12px;border:1px solid var(--rule);border-radius:5px;
  background:var(--surface);color:var(--ink);font:inherit;font-size:14px}
.find input:focus-visible{outline:2px solid var(--accent-2);outline-offset:1px;
  border-color:var(--accent-2)}
.find ul{position:absolute;z-index:40;left:0;right:0;top:calc(100% + 4px);
  margin:0;padding:4px;list-style:none;background:var(--surface);
  border:1px solid var(--rule);border-radius:5px;
  box-shadow:0 8px 24px rgba(0,0,0,.16);max-height:56vh;overflow:auto}
.find li{display:flex;align-items:baseline;gap:8px;padding:6px 9px;border-radius:4px;
  font-size:13px;cursor:pointer;white-space:nowrap}
/* The first hit is pre-selected so Enter goes somewhere, which means the
   selection has to be visible at a glance — --surface-2 alone was a shade
   apart from the panel in dark mode.  A left bar in the accent colour reads
   in both themes and does not rely on the fill. */
.find li.on{background:var(--surface-2);box-shadow:inset 3px 0 0 var(--accent-2)}
.find li b{font-variant-numeric:tabular-nums;color:var(--accent-2);min-width:3.4em}
.find li .nm{font-weight:600;color:var(--ink)}
.find li .ind{color:var(--muted);font-size:11.5px;overflow:hidden;text-overflow:ellipsis}
.find li .sc{margin-left:auto;color:var(--muted);font-variant-numeric:tabular-nums}
/* -- 本機抓取 --------------------------------------------------------- */
.grab{position:absolute;z-index:45;left:0;right:0;top:calc(100% + 4px);
  background:var(--surface);border:1px solid var(--accent);border-radius:5px;
  padding:10px 12px;box-shadow:0 8px 24px rgba(0,0,0,.16)}
.grab .head{margin:0 0 6px;font-size:13px;font-weight:600;color:var(--ink);padding-right:20px}
.grab .x{position:absolute;top:5px;right:6px;appearance:none;border:none;background:none;
  color:var(--muted);font:inherit;font-size:13px;line-height:1;padding:3px 5px;cursor:pointer;
  border-radius:3px}
.grab .x:hover{background:var(--surface-2);color:var(--ink)}
.grab .log{margin:0;max-height:180px;overflow:auto;font-size:11px;line-height:1.6;
  color:var(--muted);white-space:pre-wrap;word-break:break-all;
  font-family:ui-monospace,SFMono-Regular,Menlo,monospace}
.tag.grabbtn{margin-left:6px;padding:1px 8px;border-radius:3px;font-size:10.5px;
  border:1px solid var(--accent);color:var(--accent);background:var(--surface);
  cursor:pointer}
.tag.grabbtn:hover{background:var(--accent);color:var(--surface)}
.btn-grab{display:inline-block;padding:7px 16px;border-radius:5px;border:none;
  background:var(--accent);color:#fff;font:inherit;font-size:14px;font-weight:600;
  cursor:pointer}
.btn-grab:hover{background:var(--accent-2)}
@media (prefers-color-scheme:dark){:root:not([data-theme=light]) .btn-grab{color:#10161c}}
ul.how{padding-left:20px;font-size:13.5px;line-height:1.9}
ul.how code{background:var(--surface-2);padding:1px 6px;border-radius:3px;
  font-size:12.5px;color:var(--ink)}
/* 近六期數列：期別列與數值列共用同一組欄，所以標籤永遠落在自己的數字上面。 */
/* max-content, not 1fr: with 1fr the six columns split whatever the table
   hands the cell — 94px each here — which stretched the series across half
   the table and pushed 理由 against the right edge.  Sized to their contents
   they take exactly the room the numbers need. */
td.series{width:1%}
td.series .cells{display:grid;grid-template-columns:repeat(var(--n),max-content);
  gap:1px 14px;justify-content:end}
td.series .p{font-size:10.5px;color:var(--muted);text-align:right;
  font-variant-numeric:tabular-nums;white-space:nowrap}
td.series .v{text-align:right;font-variant-numeric:tabular-nums;
  font-family:"IBM Plex Mono",ui-monospace,SFMono-Regular,Menlo,monospace}
/* -- 個股頁：固定頁首與分頁 ------------------------------------------ */
.ident.sticky{position:sticky;top:0;z-index:30;background:var(--ground);
  margin:0 -20px 16px;padding:12px 20px 0;
  box-shadow:0 1px 0 var(--rule),0 6px 14px -12px rgba(0,0,0,.4)}
.ident.sticky h2{margin:0;font-size:19px;border:none;padding:0;letter-spacing:-.01em}
.ident .facts{display:flex;flex-wrap:wrap;gap:4px 18px;margin:5px 0 9px;
  font-size:12.5px;color:var(--muted);max-width:none}
.ident .facts b{color:var(--ink);font-weight:600;
  font-variant-numeric:tabular-nums;margin-left:3px}
.tabs{display:flex;gap:2px;overflow-x:auto;scrollbar-width:none;
  border-bottom:1px solid var(--rule)}
.tabs::-webkit-scrollbar{display:none}
.tab{flex:0 0 auto;appearance:none;border:none;background:transparent;
  font:inherit;font-size:13px;color:var(--muted);cursor:pointer;
  padding:7px 12px;border-bottom:2px solid transparent;margin-bottom:-1px;
  white-space:nowrap;border-radius:4px 4px 0 0}
.tab:hover{color:var(--ink-2);background:var(--surface-2)}
.tab[aria-selected=true]{color:var(--accent-2);font-weight:600;
  border-bottom-color:var(--accent-2)}
.tab:focus-visible{outline:2px solid var(--accent-2);outline-offset:-2px}
/* 分頁自己的標題和分頁標籤是同一句話，重複一次只是佔掉一行。 */
.panel > h3:first-child{position:absolute;width:1px;height:1px;overflow:hidden;
  clip:rect(0 0 0 0);white-space:nowrap}
.searchbar{margin:0 0 14px}
.searchbar input{width:100%;max-width:340px;padding:8px 11px;border:1px solid var(--rule);
  border-radius:4px;background:var(--surface);color:var(--ink);font:inherit;font-size:14px}
.stale,.note{background:var(--surface);border:1px solid var(--rule);
  border-radius:5px;padding:8px 12px;font-size:12.5px;line-height:1.6;
  color:var(--ink-2);max-width:none;margin-bottom:12px}
.stale{border-left:3px solid var(--g1)}
.note{border-left:3px solid var(--accent)}
.tag.full{display:inline-block;padding:0 6px;margin-left:5px;border-radius:3px;
  font-size:10.5px;line-height:1.6;vertical-align:1px;
  border:1px solid var(--accent);color:var(--accent);background:transparent}
/* -- 個股新聞 --------------------------------------------------------- */
ol.news{list-style:none;padding:0;margin:16px 0 0;display:grid;gap:1px;
  background:var(--rule);border:1px solid var(--rule);border-radius:4px;overflow:hidden}
ol.news li{background:var(--surface);padding:13px 16px}
/* Wire round-ups stay in the list but step back: they are evidence of thin
   coverage, not coverage.  Opacity alone would fail a contrast check, so the
   tag carries the meaning and this only softens the ground. */
ol.news li.roundup{background:var(--surface-2)}
ol.news .meta{display:flex;flex-wrap:wrap;gap:9px;align-items:center;
  font-size:11.5px;color:var(--muted);margin-bottom:5px}
ol.news .meta time{font-variant-numeric:tabular-nums}
ol.news .tag{padding:0 7px;border-radius:3px;border:1px solid var(--rule);
  background:var(--ground);color:var(--muted)}
ol.news .head{font-size:14.5px;font-weight:600;line-height:1.5;color:var(--ink);
  text-decoration:none;display:inline-block}
ol.news a.head:hover{color:var(--accent-2);text-decoration:underline}
ol.news .sum{margin:6px 0 0;font-size:12.5px;line-height:1.65;color:var(--muted)}
/* -- 河流圖 ----------------------------------------------------------- */
.river-fig svg{height:380px}
.zonekey{display:flex;flex-wrap:wrap;gap:4px 14px;margin:6px 0 0;padding:0 2px;
  font-size:11.5px;color:var(--muted);max-width:none}
.zonekey .key{display:inline-flex;align-items:center;gap:5px}
.zonekey i{width:11px;height:11px;border-radius:2px;border:1px solid var(--rule);
  display:inline-block}
/* -- valuation ------------------------------------------------------- */
.val{display:grid;grid-template-columns:repeat(auto-fit,minmax(210px,1fr));gap:1px;
  background:var(--rule);border:1px solid var(--rule);border-radius:4px;overflow:hidden;margin-bottom:18px}
.val section{background:var(--surface);padding:15px 17px}
.val h4{margin:0 0 10px;font-size:13px;color:var(--muted);font-weight:600;letter-spacing:.02em}
.val dl{margin:0;display:grid;grid-template-columns:auto 1fr;gap:5px 12px;font-size:13.5px}
.val dt{color:var(--ink-2);white-space:nowrap}
.val dd{margin:0;text-align:right;font-variant-numeric:tabular-nums;
  font-family:"IBM Plex Mono",ui-monospace,Menlo,monospace}
.val dd.big{font-size:17px;color:var(--accent);font-weight:600}
.band{margin-top:12px}
.band .track{position:relative;height:8px;border-radius:4px;
  background:linear-gradient(90deg,var(--g3) 0%,var(--surface-2) 50%,var(--g0) 100%)}
.band .pin{position:absolute;top:-4px;width:2px;height:16px;background:var(--ink);border-radius:1px}
.band .ends{display:flex;justify-content:space-between;font-size:11.5px;color:var(--muted);margin-top:5px;
  font-variant-numeric:tabular-nums}
.verdict{display:inline-block;padding:1px 8px;border-radius:3px;font-size:12px;font-weight:600;color:var(--badge-ink)}
.v-便宜{background:var(--g4)}.v-合理{background:var(--g1)}.v-昂貴{background:var(--g0)}
.gap{color:var(--muted);font-size:13px;font-style:normal}
.rr{display:inline-block;margin-left:6px;padding:0 6px;border-radius:3px;font-size:11.5px;
  font-weight:600;color:var(--badge-ink);font-family:inherit}
.rr-可買進{background:var(--g4)}.rr-多空不明{background:var(--g1)}
.rr-減碼{background:var(--g0)}.rr-空方{background:var(--g0)}
details.rules{margin:0 0 18px;border:1px solid var(--rule);border-radius:4px;background:var(--surface);padding:10px 14px}
details.rules summary{cursor:pointer;font-size:13.5px;font-weight:600;color:var(--ink-2)}
details.rules[open] summary{margin-bottom:10px}
.warn{font-size:12.5px;color:var(--g1);margin:6px 0 0;max-width:none}

/* -- single-stock page ------------------------------------------------ */
.ident h2{margin-top:8px;border-bottom:none;padding-bottom:0}
.ident p{margin-top:2px}
nav.sections{display:flex;gap:8px;flex-wrap:wrap;margin:0 0 26px;
  border-bottom:1px solid var(--rule);padding-bottom:12px}
nav.sections a{font-size:13.5px;padding:5px 12px;border:1px solid var(--rule);border-radius:999px;
  background:var(--surface);color:var(--ink-2);text-decoration:none}
nav.sections a:hover{border-color:var(--accent-2);color:var(--accent-2)}
h3[id]{scroll-margin-top:16px}
.verdict-yes,.verdict-no{border-left:4px solid;padding:10px 14px;border-radius:0 4px 4px 0;
  background:var(--surface);font-size:14px;max-width:none}
.verdict-yes{border-color:var(--g4)}
.verdict-no{border-color:var(--rule);color:var(--ink-2)}
td.series{white-space:nowrap}
td.series span{display:inline-block;min-width:52px;text-align:right;
  padding-left:8px;color:var(--ink-2)}
td.series span:first-child{color:var(--ink);font-weight:600}
td.reason{white-space:normal;font-size:12px;color:var(--muted);
  min-width:180px;max-width:340px;line-height:1.5}
details.sources{margin:0 0 8px;font-size:13px}
details.sources summary{cursor:pointer;color:var(--ink-2)}
.srclist{list-style:none;display:flex;flex-wrap:wrap;gap:6px;padding:10px 0 0;margin:0}
.srclist li{font-size:12px;padding:2px 9px;border-radius:3px;border:1px solid var(--rule);
  background:var(--surface);color:var(--ink-2)}
.srclist li.missing{border-color:var(--g0);color:var(--g0)}
/* -- charts ------------------------------------------------------------ */
figure.chart-fig{margin:22px 0 26px}
figure.chart-fig figcaption{font-size:13.5px;font-weight:600;color:var(--ink-2);margin-bottom:8px}
/* viewBox 是 1200×300，而內容欄正好 1200 寬——桌機上 1:1，不被拉伸。
   高度跟著 CSS 走，所以窄畫面只有橫向會縮，那是這個取捨的代價：換來的是
   桌機上完全不變形。 */
svg.chart{display:block;width:100%;height:240px;background:var(--surface);
  border:1px solid var(--rule);border-radius:5px}
details.chart-data{margin-top:8px;font-size:12.5px}
details.chart-data summary{cursor:pointer;color:var(--muted)}
details.chart-data table{min-width:0}
details.chart-data .scroll{margin-top:8px;max-height:260px;overflow-y:auto}
.pband{position:relative;height:74px;margin:6px 0 2px}
.pband .track{position:absolute;top:14px;left:0;right:0;height:8px;border-radius:4px;
  background:var(--surface-2);border:1px solid var(--rule)}
.band-valuation .pband .track{border:none;opacity:.55;
  background:linear-gradient(90deg,var(--g4) 0%,var(--g2) 50%,var(--g0) 100%)}
.pband .stop{position:absolute;top:0;transform:translateX(-50%);text-align:center;
  font-size:11.5px;color:var(--muted);font-variant-numeric:tabular-nums}
.pband .stop i{display:block;width:2px;height:20px;margin:8px auto 0;background:var(--rule)}
.pband .stop b{display:block;margin-top:4px;font-weight:600;color:var(--ink-2)}
.pband .stop em{display:block;font-style:normal;font-family:ui-monospace,Menlo,monospace}
.pband .here{position:absolute;top:6px;transform:translateX(-50%);text-align:center}
.pband .here i{display:block;width:2px;height:28px;margin:0 auto;background:var(--ink)}
.pband .here b{display:block;margin-top:3px;font-size:11.5px;font-weight:600;color:var(--ink);
  white-space:nowrap;font-variant-numeric:tabular-nums}
/* -- reward/risk criteria ---------------------------------------------- */
.criteria{border:1px solid var(--rule);border-radius:4px;background:var(--surface);
  padding:14px 18px;margin:22px 0}
.criteria h4{margin:0 0 10px;font-size:14px}
.criteria ol{margin:0;padding-left:22px;font-size:13.5px;color:var(--ink-2)}
.criteria ol li{margin-bottom:5px}
.criteria ol li b{font-family:ui-monospace,Menlo,monospace;color:var(--ink)}
.criteria ol li.hit{color:var(--ink);font-weight:600}
.criteria .tag{display:inline-block;padding:0 7px;border-radius:3px;font-size:11.5px;
  background:var(--g4);color:var(--badge-ink);font-weight:600}
.criteria .warnings{margin:12px 0 0;padding-left:20px;font-size:12.5px;color:var(--g1);
  list-style:"※ "}
.criteria .warnings li{margin-top:4px}
tr.here{background:var(--surface-2)}
tr.here th{font-weight:700}
  background:var(--rule);border:1px solid var(--rule);border-radius:4px;overflow:hidden;margin-bottom:20px}
  padding:2px 0;color:var(--ink-2)}
@media(max-width:640px){svg.chart{height:200px}}
@media(max-width:640px){.wrap{padding:0 14px 60px}}
</style>
</head>
{# 個股頁上，頁首那顆按鈕預設就指這一檔——讀者不必再把代號打一次。已經有完整
   報告的也給（字改成「重新抓取」）：資料會過期，而且新增的區塊只能靠重抓補上。 #}
<body{% if grab_code %} data-grab="{{ grab_code }}"{% endif %}{% if grab_full %} data-full="1"{% endif %}>
<header class="top"><div class="in">
  <h1><a href="{{ rel }}index.html">{{ site_title }}</a></h1>
  {# 三個分頁暫時不連：它們讀的是一年前的全市場快照，而排名和分布用舊資料算出來
     不只是過時，是理直氣壯地過時。個股頁不同，那是現抓的。頁面照樣產生，直接
     開網址還是看得到，只是導覽不指過去。#}
  <nav>
    <a href="{{ rel }}index.html"{% if page=='list' %} aria-current="page"{% endif %}>評等清單</a>
    {% if 'picks' not in hidden_pages %}
    <a href="{{ rel }}picks.html"{% if page=='picks' %} aria-current="page"{% endif %}>具投資價值</a>
    {% endif %}
    {% if 'stats' not in hidden_pages %}
    <a href="{{ rel }}stats.html"{% if page=='stats' %} aria-current="page"{% endif %}>評等統計</a>
    {% endif %}
    {% if 'about' not in hidden_pages %}
    <a href="{{ rel }}about.html"{% if page=='about' %} aria-current="page"{% endif %}>評分規則</a>
    {% endif %}
  </nav>
  <form class="find" role="search" action="{{ rel }}index.html" method="get">
    {# The form's action is the fallback, and it is a real one: with scripting
       off, submitting takes the reader to 評等清單, which has its own filter
       and lists every stock.  The combobox below is an enhancement on top of
       a page that already worked. #}
    <div class="findrow">
      <input id="find" name="q" type="search" autocomplete="off" spellcheck="false"
             placeholder="輸入代號或名稱…　（按 / 跳到這裡）" aria-label="搜尋個股"
             role="combobox" aria-expanded="false" aria-controls="find-list"
             aria-autocomplete="list">
      {# 只有在「這一檔還沒有完整報告，而且抓得到」的時候才出現。沒東西可抓時
         留一顆按不動的按鈕，比沒有按鈕更難懂。 #}
      <button type="button" id="grabnow" class="btn-grab" hidden>抓取</button>
    </div>
    <ul id="find-list" role="listbox" aria-label="搜尋結果" hidden></ul>
    {# 進度面板要跟搜尋框對齊，所以必須待在 .find 裡面——它是 position:relative
       的那一層。放在外面會拿 header 當定位基準，掉到畫面上量不到的地方去。
       只有在 `twsix serve` 底下才會用到：載入時問一次 /api/ping，GitHub Pages
       上問不到就永遠不顯示。同一份 HTML，兩種行為。 #}
    <div id="grab" class="grab" hidden>
      {# 面板蓋在搜尋結果上面。跑完會自己換頁，但失敗或逾時的時候它會一直留著，
         把搜尋框整個擋住——所以要給一個關得掉的辦法。 #}
      <button type="button" class="x" id="grab-x" aria-label="關閉進度">✕</button>
      <p class="head"></p>
      <pre class="log" aria-live="polite"></pre>
    </div>
  </form>
  {# 動作，不是頁面，所以放在 nav 外面。只有線上版才需要——本機服務在跑的
     時候不必給權杖。 #}
  <p class="stamp">
    <button type="button" id="tokenlink" class="linkish" hidden>設定抓取權杖</button>
  </p>
  <p class="stamp">
    網站產生：{{ generated_at }}　·　{{ stock_count }} 檔　·
    資料截止：財報 {{ latest_quarter or '—' }}　/　營收 {{ latest_revenue_month or '—' }}
  </p>
</div></header>
<div class="wrap">
{% if data_age_note %}
<p class="stale" role="status">⚠　{{ data_age_note }}　頁面上的評等與估值都是依這個時點計算的。</p>
{% endif %}
{% block body %}{% endblock %}
<footer>
  由公開資料自動產生，僅供研究參考，不構成投資建議。<br>
  規則來源：六大財務指標評等 v6.62 · 引擎版本 {{ engine_version }}
</footer>
</div>
<script>
/* 全站個股搜尋。
 *
 * search.json 是 [代號, 名稱, 產業, 綜合評分, 有無完整頁] 的陣列，順序固定，
 * 只有這裡讀它。索引是延後載入的：訪客多半只是看清單頁，不該為了一個可能
 * 不會用到的搜尋框先付 85 KB。第一次聚焦才抓，抓過就留著。
 *
 * 排序刻意分三段而不是算一個相似度分數：使用者打「23」時要的是 2330 那一類，
 * 不是名字裡有 23 的公司。代號開頭 > 名稱 > 代號中間 > 產業，段內照代號排。
 */
(function(){
  var box=document.getElementById('find'); if(!box) return;
  var list=document.getElementById('find-list');
  var data=null, hits=[], cur=-1, base='{{ rel }}';

  function load(){
    if(data) return Promise.resolve(data);
    return fetch(base+'search.json').then(function(r){return r.json();})
      .then(function(j){ data=j; return j; })
      .catch(function(){ data=[]; return data; });
  }

  function score(row, q){
    if(row[0].indexOf(q)===0) return 0;
    if(row[1].toLowerCase().indexOf(q)>-1) return 1;
    if(row[0].indexOf(q)>-1) return 2;
    if(row[2].toLowerCase().indexOf(q)>-1) return 3;
    return -1;
  }

  function search(q){
    var out=[], i, s;
    for(i=0;i<data.length;i++){
      s=score(data[i], q);
      if(s>=0) out.push([s, data[i]]);
    }
    out.sort(function(a,b){ return a[0]-b[0] || (a[1][0]<b[1][0]?-1:1); });
    return out.slice(0,12).map(function(x){return x[1];});
  }

  function draw(){
    list.innerHTML='';
    refreshOffer();
    if(!hits.length){ close(); return; }
    hits.forEach(function(r,i){
      var li=document.createElement('li');
      li.id='find-o'+i;
      li.setAttribute('role','option');
      li.setAttribute('aria-selected', i===cur ? 'true':'false');
      if(i===cur) li.className='on';
      var b=document.createElement('b'); b.textContent=r[0];
      var nm=document.createElement('span'); nm.className='nm'; nm.textContent=r[1];
      var ind=document.createElement('span'); ind.className='ind'; ind.textContent=r[2];
      var sc=document.createElement('span'); sc.className='sc'; sc.textContent=r[3];
      li.appendChild(b); li.appendChild(nm); li.appendChild(ind); li.appendChild(sc);
      if(r[4]){
        var t=document.createElement('span'); t.className='tag full'; t.textContent='完整';
        li.appendChild(t);
      }
      if(live || repo){
        var g=document.createElement('span'); g.className='tag grabbtn';
        g.textContent = r[4] ? '重抓' : '抓這一檔';
        g.addEventListener('mousedown', function(e){
          e.preventDefault(); e.stopPropagation();
          grabNow(r[0]);
        });
        li.appendChild(g);
      }
      li.addEventListener('mousedown', function(e){ e.preventDefault(); go(r); });
      list.appendChild(li);
    });
    list.hidden=false;
    box.setAttribute('aria-expanded','true');
    if(cur>=0) box.setAttribute('aria-activedescendant','find-o'+cur);
    else box.removeAttribute('aria-activedescendant');
  }

  function close(){
    list.hidden=true; list.innerHTML='';
    box.setAttribute('aria-expanded','false');
    box.removeAttribute('aria-activedescendant');
    cur=-1;
  }

  function go(r){ location.href = base+'stock/'+r[0]+'.html'; }

  function run(){
    var q=box.value.trim().toLowerCase();
    if(!q){ hits=[]; close(); refreshOffer(); return; }
    load().then(function(){
      if(box.value.trim().toLowerCase()!==q) return;  /* 打字比抓索引快 */
      hits=search(q); cur=hits.length?0:-1; draw();
    });
  }

  /* ---- 本機抓取 -------------------------------------------------------
   * 靜態站台抓不到券商鏡像站（瀏覽器的同源政策，不是缺功能），所以抓取這件事
   * 只在 `twsix serve` 底下才成立。頁面載入時問一次 /api/ping：問得到就把
   * 「立即抓取」放進搜尋結果，問不到就當作沒有這回事。
   */
  var live=false, grab=document.getElementById('grab');
  var repo = {{ (repo or '')|tojson }};
  fetch(base+'api/ping').then(function(r){return r.ok?r.json():null;})
    .then(function(j){ live = !!(j && j.service==='twsix'); refreshOffer(); })
    .catch(function(){ live=false; refreshOffer(); });

  /* ---- 頁首那顆「抓取 XXXX」 -------------------------------------------
   * 一顆按鈕，一個對象：搜尋框裡選中的那一檔；框是空的就退回這一頁的股票。
   * 已經有完整報告、或這台機器根本抓不了（沒有本機服務也沒有設 repo），
   * 按鈕就不出現。
   */
  var btn = document.getElementById('grabnow');
  var pageCode = document.body.getAttribute('data-grab') || '';
  var pageFull = document.body.getAttribute('data-full') === '1';
  var target = '';

  function canGrab(){ return live || !!repo; }
  function offer(code, full){
    target = (code && canGrab()) ? code : '';
    if(!btn) return;
    if(target){ btn.textContent = label(target, full); btn.hidden = false; }
    else btn.hidden = true;
  }
  /* 「已經完整」不等於「不必再抓」。
   *
   * 上一版把有完整報告的那一檔當成沒有對象，按鈕就消失了——於是一檔股票只要成功
   * 抓過一次，就再也沒有辦法重抓：資料放到過期、或是後來新增了區塊（大戶持股、
   * 董監持股就是這樣加進來的），舊的那些檔反而是唯一補不到的。
   *
   * 所以按鈕永遠在，只換字：沒有報告是「抓取」，有報告是「重新抓取」。
   */
  function label(code, full){ return (full ? '重新抓取 ' : '抓取 ') + code; }

  function refreshOffer(){
    var q = box.value.trim();
    if(q && hits.length){
      var h = hits[cur > -1 ? cur : 0];
      offer(h ? h[0] : '', h && h[4]);
    } else if(!q){
      offer(pageCode, pageFull);
    } else {
      offer('');   /* 打了字卻找不到這一檔：沒有對象可抓 */
    }
  }
  function grabNow(code){
    if(!code) return;
    if(live) fetchStock(code); else if(repo) askGithub(code);
  }
  if(btn){
    /* mousedown 先於 blur，preventDefault 讓搜尋框不失焦——否則清單一關，
       按鈕的對象就在 click 抵達之前被換掉了。 */
    btn.addEventListener('mousedown', function(e){ e.preventDefault(); });
    btn.addEventListener('click', function(){ grabNow(target); });
  }
  var grabX = document.getElementById('grab-x');
  if(grabX){
    grabX.addEventListener('mousedown', function(e){ e.preventDefault(); });
    /* 關掉面板只是不再看它，不是取消——runner 那邊照跑。等待也一併放掉，
       否則下一頁又會把同一個面板叫回來。 */
    grabX.addEventListener('click', function(){
      clearInterval(ticker); ticker = null; watching = null; forget();
      grab.hidden = true;
    });
  }

  /* 線上版的抓取路徑：按下去就跑，不換頁。
   *
   * 靜態網站沒辦法自己抓券商鏡像站，但它可以**直接叫 GitHub Actions 去跑**——
   * REST API 支援跨域，所以 workflow_dispatch 一個 POST 就送得出去，再輪詢
   * 執行狀態把進度畫在同一頁上。這就是桌機版那個面板，只是背後換成 runner。
   *
   * 代價是那個 POST 要一把權杖，而靜態網站沒有地方藏秘密。所以權杖由使用者
   * 自己貼一次，存在**這台瀏覽器的 localStorage**：不進 repo、不進產生出來的
   * HTML、不經過任何第三方，只會送到 api.github.com。別人打開這個網站沒有
   * 權杖，就沒有按鈕，也就按不到任何東西——這比開放 issue 更關得住。
   *
   * 建議用 fine-grained PAT，只勾這一個 repo、只給 Actions 讀寫。那把權杖能做
   * 的事就只有「在這個 repo 跑 workflow」。
   *
   * 沒有權杖時退回開 issue 那條路，一次點擊加一次送出，手機上也能用。
   */
  var TOKEN_KEY = 'twsix.token';
  var WORKFLOW = 'stock.yml';
  var API = 'https://api.github.com/repos/' + repo;

  function token(){
    try{ return localStorage.getItem(TOKEN_KEY) || ''; }catch(e){ return ''; }
  }
  function setToken(v){
    try{ v ? localStorage.setItem(TOKEN_KEY, v) : localStorage.removeItem(TOKEN_KEY); }
    catch(e){}
  }
  function gh(path, opts){
    opts = opts || {};
    opts.headers = Object.assign({
      'Accept': 'application/vnd.github+json',
      'Authorization': 'Bearer ' + token(),
      'X-GitHub-Api-Version': '2022-11-28'
    }, opts.headers || {});
    return fetch(API + path, opts);
  }

  /* ---- 進度面板 ------------------------------------------------------- */
  var started = 0, ticker = null, steps = [];

  function elapsed(){
    var s = Math.round((Date.now() - started) / 1000);
    return Math.floor(s / 60) + ':' + String(s % 60).padStart(2, '0');
  }
  function step(text){
    if(steps[steps.length - 1] !== text) steps.push(text);
    paint();
  }
  function paint(){
    if(!grab || !started) return;
    grab.hidden = false;
    /* 每秒重畫一次，讀者才看得出它還活著。一分半沒有任何動靜，看起來就是當掉
       ——那正是這個計時器存在的唯一理由。 */
    grab.querySelector('.head').textContent = '抓取中… ' + elapsed();
    grab.querySelector('.log').textContent = steps.join('\n');
  }
  function beginPanel(){
    started = Date.now(); steps = [];
    clearInterval(ticker);
    ticker = setInterval(paint, 1000);
    paint();
  }
  function endPanel(head, note){
    clearInterval(ticker); ticker = null;
    if(!grab) return;
    grab.hidden = false;
    grab.querySelector('.head').textContent = head;
    if(note) steps.push(note);
    grab.querySelector('.log').textContent = steps.join('\n');
  }

  /* ---- 站內輪詢：資料進網站了沒 --------------------------------------- */
  var PENDING = 'twsix.pending';
  function remember(code){
    try{ sessionStorage.setItem(PENDING, JSON.stringify(
      {code: code, until: Date.now() + 8*60*1000})); }catch(e){}
  }
  function forget(){ try{ sessionStorage.removeItem(PENDING); }catch(e){} }
  function pendingJob(){
    try{
      var j = JSON.parse(sessionStorage.getItem(PENDING) || 'null');
      if(!j || !j.code || Date.now() > j.until){ forget(); return null; }
      return j;
    }catch(e){ return null; }
  }

  var watching = null;
  function arrive(code){
    forget();
    endPanel(code + ' 好了，正在開啟報告…');
    if(location.pathname.replace(/^.*\//, '') === code + '.html') location.reload();
    else location.href = base + 'stock/' + code + '.html';
  }
  function watch(code, tries){
    if(watching && watching !== code) return;
    watching = code;
    fetch(base + 'search.json?t=' + Date.now(), {cache:'no-store'})
      .then(function(r){ return r.json(); })
      .then(function(rows){
        for(var i=0;i<rows.length;i++){
          if(rows[i][0] === code && rows[i][4]){ arrive(code); return; }
        }
        nextWatch(code, tries);
      })
      .catch(function(){ nextWatch(code, tries); });
  }
  function nextWatch(code, tries){
    if(tries <= 0){
      forget(); watching = null;
      endPanel('等太久了，' + code + ' 還沒出現',
               '到 Actions 看一下「加一檔個股」跑完了沒；跑完了重新整理這一頁。');
      return;
    }
    setTimeout(function(){ watch(code, tries - 1); }, 10000);
  }

  /* ---- 直接跑 workflow ------------------------------------------------ */
  function runOnGithub(code){
    close();
    beginPanel();
    remember(code);
    step('送出 ' + code + ' 給 GitHub Actions…');
    var since = new Date(Date.now() - 60000).toISOString();
    gh('/actions/workflows/' + WORKFLOW + '/dispatches', {
      method: 'POST',
      body: JSON.stringify({ref: 'main', inputs: {stock: code}})
    }).then(function(r){
      if(r.status === 204){ step('已排入佇列，等 runner 接手…'); pollRun(code, since, 90); return; }
      if(r.status === 401 || r.status === 403){
        setToken('');
        endPanel('權杖無效或權限不足', '請重新設定一把 fine-grained PAT，勾選這個 repo 的 Actions 讀寫。');
        return;
      }
      return r.text().then(function(t){
        endPanel('送出失敗（HTTP ' + r.status + '）', t.slice(0, 300));
      });
    }).catch(function(e){
      endPanel('送不出去', String(e));
    });
  }

  /* runner 排隊、跑測試、抓資料、補股權歷史、建站，加起來約三到四分鐘——新加
     的一檔要向集保逐週問滿 51 週，那是〔大戶持股〕有沒有走勢的差別。每 4 秒問
     一次狀態，把 GitHub 自己的字串翻成人看得懂的一行，讀者才知道它在哪一步。 */
  function pollRun(code, since, tries){
    if(tries <= 0){ step('狀態查不到了，改用網站本身判斷…'); watch(code, 40); return; }
    gh('/actions/workflows/' + WORKFLOW + '/runs?per_page=5&created=%3E' +
       encodeURIComponent(since))
      .then(function(r){ return r.ok ? r.json() : null; })
      .then(function(j){
        var run = j && j.workflow_runs && j.workflow_runs[0];
        if(!run){ setTimeout(function(){ pollRun(code, since, tries - 1); }, 4000); return; }
        if(run.status === 'queued') step('排隊中…');
        else if(run.status === 'in_progress') step(
          '執行中：抓報表 → 補集保 51 週股權歷史（約 1 分鐘）→ 產生報告 → 重建網站');
        else if(run.status === 'completed'){
          if(run.conclusion === 'success'){
            step('Actions 完成，等網站發布…');
            watch(code, 40);
          } else {
            forget();
            endPanel('抓取失敗（' + run.conclusion + '）',
                     '執行紀錄：' + run.html_url);
          }
          return;
        }
        setTimeout(function(){ pollRun(code, since, tries - 1); }, 4000);
      })
      .catch(function(){ setTimeout(function(){ pollRun(code, since, tries - 1); }, 4000); });
  }

  /* 曾經有一條「沒權杖就開一張 issue」的退路，已經拿掉。它把一次點擊變成換頁、
     核對標題、按 Submit，而那一頁上還有別的按鈕可以按錯、有預填的股號可以改壞；
     跑完也不會自己關。權杖貼一次就一勞永逸，兩條路並存只是留著壞的那條。 */

  /* ---- 設定權杖 ------------------------------------------------------- */
  function askToken(){
    var now = token();
    var msg = now
      ? '目前已設定權杖。貼上新的可以更換，留空並按確定則清除。'
      : '貼上 GitHub fine-grained PAT（只勾這一個 repo、Actions 讀寫）。\n'
        + '它只存在這台瀏覽器，不會進 repo，也只會送到 api.github.com。';
    var v = window.prompt(msg, '');
    if(v === null) return false;
    setToken(v.trim());
    return !!v.trim();
  }

  function askGithub(code){
    if(token()) return runOnGithub(code);
    if(askToken()) return runOnGithub(code);
    /* 取消了設定權杖。什麼都不做會變成「按了沒反應」——說一聲它為什麼沒動。 */
    close(); beginPanel();
    endPanel('還沒設定抓取權杖',
             '線上抓取要一把 GitHub fine-grained PAT（只勾這個 repo、Actions 讀寫）。\n'
             + '按頁首的「設定抓取權杖」貼上，之後就不用再貼。');
    return;
  }
  window.twsixAskGithub = askGithub;
  window.twsixSetToken = askToken;
  window.twsixHasToken = function(){ return !!token(); };
  window.twsixCanAsk = function(){ return !live && !!repo; };
  /* ---- 本機服務（twsix serve）：同一個面板，不同的後端 ---------------- */
  function pollLocal(code){
    fetch(base + 'api/job/' + code).then(function(r){ return r.json(); })
      .then(function(j){
        if(j.error){ endPanel('抓取失敗', j.error); return; }
        if(!j.done){
          /* 本機那條路每一行都是 twsix report 自己印的，直接照抄。 */
          steps = j.lines.slice(); paint();
          setTimeout(function(){ pollLocal(code); }, 800);
          return;
        }
        steps = j.lines.slice();
        if(j.ok) arrive(code);
        else endPanel('抓取失敗', '八個鏡像站都拒絕通常代表 IP 被擋，換個網路再試。');
      })
      .catch(function(){ endPanel('抓取中斷', '連不上本機服務'); });
  }
  function fetchStock(code){
    close(); beginPanel(); remember(code);
    step('正在抓取 ' + code + '…');
    fetch(base + 'api/fetch/' + code, {method: 'POST'})
      .then(function(r){ return r.json(); })
      .then(function(j){
        if(j.error){ endPanel('抓取失敗', j.error); return; }
        pollLocal(code);
      })
      .catch(function(){ endPanel('抓取中斷', '連不上本機服務'); });
  }
  window.twsixFetch = fetchStock;
  window.twsixLive = function(){ return live; };

  /* 換頁之後把等待接回來。計時器從零重新起算——真正的起點已經不在這一頁上，
     顯示一個假的總時間比顯示這一頁等了多久更誤導。 */
  (function resume(){
    var j = pendingJob();
    if(!j) return;
    setTimeout(function(){
      beginPanel();
      step('等 ' + j.code + ' 的資料進到網站…');
      watch(j.code, 40);
    }, 1200);
  })();

  /* 權杖入口。放在導覽列而不是藏在按鈕裡，因為換一把、清掉都要找得到。 */
  var tl = document.getElementById('tokenlink');
  if(tl){
    setTimeout(function(){
      if(live || !repo) return;
      tl.hidden = false;
      var mark = function(){ tl.textContent = token() ? '抓取權杖 ✓' : '設定抓取權杖'; };
      mark();
      tl.addEventListener('click', function(e){ e.preventDefault(); askToken(); mark(); });
    }, 1000);
  }

  box.addEventListener('focus', load);
  box.addEventListener('input', run);
  box.addEventListener('blur', function(){ setTimeout(close, 150); });
  box.addEventListener('keydown', function(e){
    if(e.key==='ArrowDown'||e.key==='ArrowUp'){
      if(!hits.length) return;
      e.preventDefault();
      cur=(cur + (e.key==='ArrowDown'?1:hits.length-1)) % hits.length;
      draw();
    } else if(e.key==='Enter'){
      /* 有選中就跳轉；沒有就讓 form 送到清單頁，那是無 JS 時走的同一條路。 */
      if(cur>-1 && hits[cur]){
        e.preventDefault();
        /* 有完整報告就跳過去；沒有而且本機服務在跑，Enter 就是「去抓」——
           那才是「輸入代號就跑出完整報告」的意思。 */
        if(hits[cur][4]) go(hits[cur]);
        else if(live || repo) grabNow(hits[cur][0]);
        else go(hits[cur]);
      }
    } else if(e.key==='Escape'){ close(); box.blur(); }
  });
  document.addEventListener('keydown', function(e){
    var el=document.activeElement;
    if(e.key==='/' && el!==box && !/^(INPUT|TEXTAREA|SELECT)$/.test(el.tagName)){
      e.preventDefault(); box.focus(); box.select();
    }
  });
})();
</script>
</body>
</html>
