<!doctype html>
<html lang="zh-Hant">
<head>
<meta charset="utf-8">
<script>document.documentElement.classList.add('js')</script>
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{% block title %}{{ site_title }}{% endblock %}</title>
<link rel="icon" href="{{ rel }}favicon.svg" type="image/svg+xml">
<link rel="icon" href="{{ rel }}favicon.ico" sizes="16x16 32x32 48x48">
<link rel="apple-touch-icon" href="{{ rel }}apple-touch-icon.png">
<link rel="manifest" href="{{ rel }}site.webmanifest">
<meta name="application-name" content="{{ site_title }}">
<meta name="apple-mobile-web-app-title" content="{{ site_title }}">
<meta name="theme-color" content="#0b1016">
{% block head_early %}{% endblock %}
{% if assets %}<link rel="stylesheet" href="{{ rel }}assets/site.css?v={{ asset_v }}">
{% else %}<style>{{ site_css }}</style>{% endif %}
</head>
<body{% if grab_code %} data-grab="{{ grab_code }}"{% endif %}{% if grab_full %} data-full="1"{% endif %}>
<header class="top"><div class="in">
      <h1><a href="{{ rel }}index.html"><img class="brand" src="{{ rel }}favicon.svg" alt="" width="40" height="40"><span class="brand-t"><span class="brand-n"><span class="brand-nm">{{ site_title }}</span><span class="brand-en">{{ site_en }}</span></span><span class="brand-tag">{{ site_tagline }}</span></span></a><span class="built">{{ generated_at }}</span></h1>
        <nav>
    <a class="nav-list" href="{{ rel }}index.html"{% if page=='list' %} aria-current="page"{% endif %}>台股評等清單</a>
    <a class="nav-watch" href="{{ rel }}watchlist.html"{% if page=='watchlist' %} aria-current="page"{% endif %}>台股觀察清單</a>
        {% if trend_page %}
        <a class="nav-trend" href="{{ rel }}{{ trend_page }}"{% if page=='trend' %} aria-current="page"{% endif %}>趨勢×六大×報酬</a>
    {% endif %}
        <a class="nav-screen" href="{{ rel }}screener.html"{% if page=='screener' %} aria-current="page"{% endif %}>選股功能</a>
        <a class="nav-ai" href="{{ rel }}ai.html"{% if page=='ai' %} aria-current="page"{% endif %}>AI 選股</a>
        <a class="nav-radar" href="{{ rel }}radar.html"{% if page=='radar' %} aria-current="page"{% endif %}>籌碼雷達</a>
        {% if monitor_page %}
    <a class="nav-mon" href="{{ rel }}{{ monitor_page }}"{% if page=='monitor' %} aria-current="page"{% endif %}>全球市場監控＋日股觀察</a>
    {% endif %}
    {% if 'picks' not in hidden_pages %}
    <a class="nav-more" href="{{ rel }}picks.html"{% if page=='picks' %} aria-current="page"{% endif %}>具投資價值</a>
    {% endif %}
    {% if 'stats' not in hidden_pages %}
    <a class="nav-more" href="{{ rel }}stats.html"{% if page=='stats' %} aria-current="page"{% endif %}>評等統計</a>
    {% endif %}
    {% if 'about' not in hidden_pages %}
    <a class="nav-more" href="{{ rel }}about.html"{% if page=='about' %} aria-current="page"{% endif %}>評分規則</a>
    {% endif %}
  </nav>
      <script>(function(){var n=document.currentScript.previousElementSibling,K='twsix-nav-x';try{n.scrollLeft=+sessionStorage.getItem(K)||0}catch(e){}var c=n.querySelector('[aria-current]'),a=n.getBoundingClientRect(),b=c&&c.getBoundingClientRect();if(b&&b.left<a.left)n.scrollLeft-=a.left-b.left+12;if(b&&b.right>a.right)n.scrollLeft+=b.right-a.right+12;n.addEventListener('click',function(){try{sessionStorage.setItem(K,n.scrollLeft)}catch(e){}})})()</script>
    </div></header>
<div class="wrap">
{% if data_age_note %}
<p class="stale" role="status">⚠　{{ data_age_note }}　頁面上的評等與估值都是依這個時點計算的。</p>
{% endif %}
{% block body %}{% endblock %}
<footer>
  由公開資料自動產生，僅供研究參考，不構成投資建議。
</footer>
</div>
<button type="button" id="totop" hidden aria-label="回到頁面最上方" title="回到最上方">↑</button>
<script>window.TWSIX={rel:{{ rel|tojson }},repo:{{ (repo or '')|tojson }},built:{{ (build_id or '')|tojson }}};</script>
{% if assets %}<script src="{{ rel }}assets/site.js?v={{ asset_v }}" defer></script>
{% else %}<script>{{ site_js }}</script>{% endif %}
</body>
</html>
